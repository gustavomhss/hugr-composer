# HuGR Arsenal gate stack — environment template.
# Copy to `.env` (in deploy/) and fill in REAL values. NEVER commit `.env`.
#   cp deploy/.env.example deploy/.env
#
# Vars marked [MANDATORY] have no safe default; the stack fails CLOSED without
# them (compose refuses to start via the `${VAR:?...}` guards, and the auth app
# denies all introspection / refuses to mint without a valid signing secret).

# ─────────────────────────────────────────────────────────────────────────────
# Postgres — the shared revocation authority (db service).
# These three compose the auth DSN: postgresql+psycopg2://USER:PASSWORD@db:5432/DB
# ─────────────────────────────────────────────────────────────────────────────
# [MANDATORY] DB role the auth API connects as.
POSTGRES_USER=hugr
# [MANDATORY] DB password. Use a long random value; do not reuse the admin token.
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-strong-db-password
# [MANDATORY] Database name.
POSTGRES_DB=hugr

# ─────────────────────────────────────────────────────────────────────────────
# HuGR Auth API (auth service) — the licensing authority.
# ─────────────────────────────────────────────────────────────────────────────
# [MANDATORY] License signing secret, hex, >= 32 bytes (64 hex chars). ONLY this
# service ever holds it. If missing/short the API fails closed: /introspect
# always returns inactive and /admin/issue returns 503. Generate:
#   python -c "import secrets;print(secrets.token_hex(32))"
HUGR_LICENSE_SIGNING_SECRET=replace-with-64-hex-chars-from-token_hex_32

# [MANDATORY] Admin bearer token for /admin/* (issue, cancel_seat, revoke_key),
# >= 16 chars. Compared in constant time; < 16 chars ⇒ all admin calls 403.
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
HUGR_ADMIN_TOKEN=replace-with-a-16plus-char-admin-token

# NOTE on HUGR_STORE_DSN: NOT set here on purpose — docker-compose.yml builds it
# from the POSTGRES_* vars above and injects it into the auth service. Override
# only if you point the API at an external/managed Postgres instead of `db`.

# ─────────────────────────────────────────────────────────────────────────────
# Gated MCP server (mcp service).
# All of the MCP env is set directly in docker-compose.yml (HUGR_GATE=1,
# HUGR_AUTH_URL=http://auth:8079, host/port). Nothing required here.
#
# DO NOT set HUGR_DEV_LICENSE_KEYS in production: it makes the gate accept
# hard-coded keys WITHOUT calling the auth API. Local/CI only.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Redis: NOT used. The revocation authority is Postgres (shared, durable) and
# token introspection is a direct HTTP call to the auth API — no broker/cache is
# in the gate path today. If a future rate-limiter/cache is added, declare a
# redis service here and document REDIS_URL.
# ─────────────────────────────────────────────────────────────────────────────
