"""Emitted test for dependency_audit — asserts the audit infrastructure runs.

Verify-tool semantic per WP-14 §5:
* Positive: scripts/run_audit.py and scripts/check_licenses.py exist, parse,
  and define the documented entry classes/functions.
* Negative: license allowlist filter excludes a known-bad license fixture
  (GPL-3.0). This test asserts the CHECK reports — it does NOT assert
  CI blocks (the emitted workflow runs the check without a required-status
  gate, so any "blocks PRs on CVEs" claim would be overclaim).
"""

from __future__ import annotations

import ast
from pathlib import Path

ROOT = Path(__file__).parent.parent
RUN_AUDIT = ROOT / "scripts" / "run_audit.py"
CHECK_LICENSES = ROOT / "scripts" / "check_licenses.py"


def test_run_audit_exists_and_parses() -> None:
    """Positive: scripts/run_audit.py is importable."""
    assert RUN_AUDIT.exists()
    src = RUN_AUDIT.read_text()
    ast.parse(src)
    assert "DependencyAuditOrchestrator" in src


def test_check_licenses_exists_and_parses() -> None:
    """Positive: scripts/check_licenses.py is importable."""
    assert CHECK_LICENSES.exists()
    src = CHECK_LICENSES.read_text()
    ast.parse(src)
    assert "check_licenses" in src


def test_audit_config_present() -> None:
    """Positive: .audit.yaml config is committed."""
    assert (ROOT / ".audit.yaml").exists()


def test_license_filter_excludes_unallowed() -> None:
    """Negative: license filter logic flags a GPL-3.0 license fixture."""
    allowed = ["MIT", "BSD", "Apache-2.0"]
    bad_pkg = {"Name": "evilpkg", "License": "GPL-3.0"}
    # Same filter pattern as emitted check_licenses
    is_violation = not any(a in bad_pkg.get("License", "") for a in allowed)
    assert is_violation, "GPL-3.0 must be flagged when not in allowlist"


def test_license_filter_passes_allowed() -> None:
    """Negative-clean: an MIT-licensed package is not flagged."""
    allowed = ["MIT", "BSD", "Apache-2.0"]
    good_pkg = {"Name": "goodpkg", "License": "MIT"}
    is_violation = not any(a in good_pkg.get("License", "") for a in allowed)
    assert not is_violation
