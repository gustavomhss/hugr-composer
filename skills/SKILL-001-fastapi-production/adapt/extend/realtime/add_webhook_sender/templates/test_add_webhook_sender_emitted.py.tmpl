"""Webhook sender emitted tests — generated by add_webhook_sender.

Positive: primitives + core files present; signer produces valid X-Signature;
verify_signature returns True for valid sig; backoff schedule has 7+ slots.
Negative: sign/verify rejects empty secret; replay window check blocks old sigs.
"""
from __future__ import annotations

import importlib
import sys
import time
from pathlib import Path

_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_signature_verifier_primitive_present() -> None:
    """Positive: SignatureVerifier.py is present under core/venous/security/."""
    candidates = list(
        (_PROJECT_ROOT / "core" / "venous").rglob("SignatureVerifier.py")
    )
    assert candidates, "SignatureVerifier.py not found under core/venous/"


def test_retry_policy_primitive_present() -> None:
    """Positive: RetryPolicy.py is present under core/venous/resiliency/."""
    candidates = list(
        (_PROJECT_ROOT / "core" / "venous").rglob("RetryPolicy.py")
    )
    assert candidates, "RetryPolicy.py not found under core/venous/"


def test_signer_produces_valid_header() -> None:
    """Positive: sign_payload returns header with t=... and v1=... components."""
    _ensure_on_path()
    mod = importlib.import_module("app.core.webhooks.signer")
    sig = mod.sign_payload("mysecret", b'{"event":"test"}')
    header = sig.to_header_value()
    assert "t=" in header
    assert "v1=" in header


def test_verify_signature_accepts_valid_sig() -> None:
    """Positive: verify_signature returns True for freshly signed payload."""
    _ensure_on_path()
    mod = importlib.import_module("app.core.webhooks.signer")
    secret = "valid-secret-32-chars-minimum!!"
    body = b'{"event":"item.created","data":{}}'
    sig = mod.sign_payload(secret, body)
    header_val = sig.to_header_value()
    assert mod.verify_signature(secret, body, header_val, now=sig.timestamp)


def test_verify_signature_rejects_old_timestamp() -> None:
    """Negative: verify_signature rejects signatures older than the replay window."""
    _ensure_on_path()
    mod = importlib.import_module("app.core.webhooks.signer")
    secret = "valid-secret-32-chars-minimum!!"
    body = b'{"event":"item.created"}'
    old_ts = int(time.time()) - 600  # 10 minutes ago
    sig = mod.sign_payload(secret, body, timestamp=old_ts)
    header_val = sig.to_header_value()
    assert not mod.verify_signature(secret, body, header_val)


def test_backoff_schedule_has_seven_slots() -> None:
    """Positive: backoff schedule covers at least 7 attempts."""
    _ensure_on_path()
    mod = importlib.import_module("app.core.webhooks.backoff")
    assert len(mod.ATTEMPT_DELAYS_SECONDS) >= 7
    assert mod.delay_for_attempt(1) == 0  # immediate first attempt
    assert mod.delay_for_attempt(100) == -1  # beyond schedule = -1


def test_sender_glue_exposes_send_webhook() -> None:
    """Positive: app.webhooks.sender exposes send_webhook (lazy imports)."""
    glue = _PROJECT_ROOT / "app" / "webhooks" / "sender.py"
    assert glue.exists(), "app/webhooks/sender.py not found"
    content = glue.read_text()
    assert "send_webhook" in content
    assert "DetachedSigner" in content
