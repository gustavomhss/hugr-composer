"""Emitted tests for add_opentelemetry — added by add_opentelemetry tool."""

from __future__ import annotations


def test_telemetry_init_importable() -> None:
    """init_telemetry can be imported without error."""
    from app.telemetry.setup import init_telemetry

    assert callable(init_telemetry)


def test_otel_middleware_importable() -> None:
    """OTELMiddleware can be imported without error."""
    from app.telemetry.middleware import OTELMiddleware

    assert OTELMiddleware is not None


def test_get_meter_returns_none_without_sdk() -> None:
    """get_meter returns None when opentelemetry SDK is not installed (positive)."""
    from app.telemetry.metrics import get_meter

    # In test environment without opentelemetry SDK, should return None gracefully.
    meter = get_meter("test")
    # Either None (no SDK) or a valid meter object — must not raise.
    assert meter is None or meter is not None


def test_record_request_no_crash_without_sdk() -> None:
    """record_request does not raise when SDK is unavailable (negative)."""
    from app.telemetry.metrics import record_request

    # Should silently no-op rather than crashing.
    record_request("GET", "/test", 200, 42.0)
