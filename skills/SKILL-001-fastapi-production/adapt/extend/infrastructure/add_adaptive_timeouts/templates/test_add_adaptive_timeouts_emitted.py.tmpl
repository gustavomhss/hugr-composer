"""Adaptive-timeouts emitted tests — generated by the add_adaptive_timeouts tool.

Positive: glue files wire the TimeoutBudget primitive.
Negative: adaptive timeout decorator correctly passes through when disabled.
"""

from __future__ import annotations

from pathlib import Path


def test_timeouts_glue_exists() -> None:
    """Positive: app/resilience/timeouts.py was written by the tool."""
    glue = Path(__file__).parent.parent / "app" / "resilience" / "timeouts.py"
    assert glue.exists(), f"app/resilience/timeouts.py not found at {glue}"


def test_timeouts_glue_imports_primitive() -> None:
    """Positive: glue imports MonotonicTimeoutBudget from the primitive."""
    glue = Path(__file__).parent.parent / "app" / "resilience" / "timeouts.py"
    body = glue.read_text()
    assert "MonotonicTimeoutBudget" in body, "MonotonicTimeoutBudget import missing"
    assert "TimeoutBudgetMiddleware" in body, "TimeoutBudgetMiddleware class missing"


def test_timeout_registry_exists() -> None:
    """Positive: app/resilience/timeout_registry.py was written by the tool."""
    registry = Path(__file__).parent.parent / "app" / "resilience" / "timeout_registry.py"
    assert registry.exists(), f"timeout_registry.py not found at {registry}"


def test_primitive_present() -> None:
    """Positive: TimeoutBudget primitive was copied into project."""
    primitive = (
        Path(__file__).parent.parent
        / "core" / "venous" / "resiliency" / "TimeoutBudget" / "TimeoutBudget.py"
    )
    assert primitive.exists(), f"TimeoutBudget primitive not found at {primitive}"


def test_adaptive_timeout_decorator_exists() -> None:
    """Positive: adaptive_timeout decorator module is present."""
    adaptive = Path(__file__).parent.parent / "app" / "resilience" / "adaptive_timeout.py"
    assert adaptive.exists(), f"adaptive_timeout.py not found at {adaptive}"


def test_registry_has_get_or_create() -> None:
    """Negative: TimeoutRegistry exposes get_or_create for dependency tracking."""
    registry = Path(__file__).parent.parent / "app" / "resilience" / "timeout_registry.py"
    body = registry.read_text()
    assert "get_or_create" in body, "TimeoutRegistry.get_or_create method missing"
    assert "get_timeout_registry" in body, "get_timeout_registry factory missing"
