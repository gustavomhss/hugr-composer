"""Canary-tokens emitted tests — generated by the add_canary_tokens tool.

Positive: canary registry, alerter, honeypot routes, fake credentials and
decoy seeder are all emitted into the project.
Negative: the alerter never raises (fire-and-forget contract); honeypot
endpoints always return 200 so attackers cannot detect them.
"""

from __future__ import annotations

from pathlib import Path


def test_canary_files_present() -> None:
    """Positive: every canary module is written into the project."""
    app = Path(__file__).parent.parent / "app"
    for rel in (
        "core/canary/registry.py",
        "core/canary/alerter.py",
        "core/canary/fake_credentials.py",
        "core/canary/decoy_seeder.py",
        "api/routes/canary_honeypot.py",
    ):
        assert (app / rel).exists(), f"missing canary file: {rel}"


def test_registry_preregisters_builtin_tokens() -> None:
    """Positive: registry pre-registers the three honeypot tokens."""
    body = (Path(__file__).parent.parent / "app" / "core" / "canary" / "registry.py").read_text()
    for token in (
        "honeypot_internal_config",
        "honeypot_admin_backup",
        "honeypot_debug_env",
    ):
        assert token in body, f"missing pre-registered token: {token}"


def test_alerter_is_fire_and_forget() -> None:
    """Negative: alerter MUST NOT raise when webhook_url is empty.

    Honesty rule: the attacker must not be able to tell they hit a
    canary. fire_canary_alert("", ...) must be a no-op log, never an
    exception.
    """
    import importlib.util
    import sys

    p = Path(__file__).parent.parent / "app" / "core" / "canary" / "alerter.py"
    spec = importlib.util.spec_from_file_location("canary_alerter_emitted_test", p)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules["canary_alerter_emitted_test"] = mod
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    # No webhook URL — must not raise.
    mod.fire_canary_alert("test_token", {"method": "GET"}, "")


def test_alerter_masks_sensitive_headers() -> None:
    """Negative: build_request_context masks Authorization / Cookie / X-API-Key."""
    import importlib.util
    import sys

    p = Path(__file__).parent.parent / "app" / "core" / "canary" / "alerter.py"
    spec = importlib.util.spec_from_file_location("canary_alerter_mask_test", p)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules["canary_alerter_mask_test"] = mod
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    ctx = mod.build_request_context(
        method="GET",
        path="/api/v1/internal/config",
        client_ip="1.2.3.4",
        headers={"authorization": "Bearer secret", "user-agent": "curl/8.0"},
    )
    assert ctx["headers"]["authorization"] == "***"
    assert ctx["headers"]["user-agent"] == "curl/8.0"
