"""Emitted test for add_docker_production — verifies Docker artifacts are present.

Warnings:
    - This Dockerfile runs the application as USER 1000 (non-root), providing
      standard container isolation, but does not enforce a read-only root
      filesystem or drop capabilities.
    - The k8s manifests generated by add_kubernetes_manifests include
      securityContext; this Dockerfile alone does not.
"""

from __future__ import annotations

from pathlib import Path


_PROJECT = Path(__file__).resolve().parent.parent


def test_dockerfile_exists() -> None:
    """Positive: Dockerfile is present at project root."""
    dockerfile = _PROJECT / "Dockerfile"
    assert dockerfile.exists(), "Dockerfile not found"


def test_dockerfile_has_healthcheck() -> None:
    """Positive: Dockerfile contains a HEALTHCHECK instruction."""
    content = (_PROJECT / "Dockerfile").read_text()
    assert "HEALTHCHECK" in content, "HEALTHCHECK instruction missing from Dockerfile"


def test_dockerfile_non_root_user() -> None:
    """Positive: Dockerfile runs as USER 1000 (non-root)."""
    content = (_PROJECT / "Dockerfile").read_text()
    assert "USER 1000" in content, "Dockerfile does not set USER 1000"


def test_compose_prod_exists() -> None:
    """Positive: docker-compose.prod.yml is present."""
    compose = _PROJECT / "docker-compose.prod.yml"
    assert compose.exists(), "docker-compose.prod.yml not found"


def test_compose_has_restart_policy() -> None:
    """Positive: docker-compose.prod.yml includes restart policies."""
    content = (_PROJECT / "docker-compose.prod.yml").read_text()
    assert "restart" in content, "docker-compose.prod.yml missing restart policy"


def test_entrypoint_exists() -> None:
    """Positive: scripts/docker-entrypoint.sh is present."""
    ep = _PROJECT / "scripts" / "docker-entrypoint.sh"
    assert ep.exists(), "docker-entrypoint.sh not found"


def test_entrypoint_has_alembic_upgrade() -> None:
    """Positive: entrypoint runs alembic upgrade head."""
    content = (_PROJECT / "scripts" / "docker-entrypoint.sh").read_text()
    assert "alembic upgrade head" in content, "entrypoint missing alembic upgrade head"


def test_dockerfile_no_root_default() -> None:
    """Negative: Dockerfile must NOT use FROM ... AS runtime without USER."""
    content = (_PROJECT / "Dockerfile").read_text()
    lines = content.splitlines()
    in_runtime = False
    saw_user = False
    for line in lines:
        stripped = line.strip()
        if "AS runtime" in stripped:
            in_runtime = True
        if in_runtime and stripped.startswith("USER"):
            saw_user = True
    assert saw_user, "runtime stage must set a USER directive (non-root)"
