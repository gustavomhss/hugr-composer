"""ML model registry emitted tests — generated by add_ml_model_registry.

Positive: MLModel model + MLModelCreate/Read schemas + RegistryService
class are importable, and the route module exposes a ``router``
APIRouter at the expected prefix.

Negative (S3 mis-route guard): the registry service has NO silent-default
fallback. ``promote_to_production`` on an unknown version returns
``None`` — and the route layer translates that to HTTP 404, NOT a
silent success on a default model.
"""

from __future__ import annotations

import importlib
import sys
from pathlib import Path


_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_ml_model_importable() -> None:
    """Positive: MLModel SQLAlchemy model is importable."""
    _ensure_on_path()
    mod = importlib.import_module("app.models.ml_model")
    assert hasattr(mod, "MLModel"), "MLModel class missing"
    assert mod.MLModel.__tablename__ == "ml_models"


def test_ml_schemas_importable() -> None:
    """Positive: All registry schemas import."""
    _ensure_on_path()
    mod = importlib.import_module("app.schemas.ml_model")
    for name in ("MLModelCreate", "MLModelRead", "MLModelPromote", "MLModelCompare"):
        assert hasattr(mod, name), f"{name} missing from app.schemas.ml_model"


def test_registry_service_no_ml_framework_imports() -> None:
    """Positive: RegistryService is framework-agnostic (no torch/sklearn import)."""
    _ensure_on_path()
    svc_path = _PROJECT_ROOT / "app" / "ml" / "registry_service.py"
    assert svc_path.exists()
    text = svc_path.read_text()
    # No top-level torch / sklearn / transformers imports
    for forbidden in ("import torch", "from torch", "import sklearn", "from sklearn",
                      "import transformers", "from transformers"):
        assert forbidden not in text, (
            f"registry_service.py contains '{forbidden}' — registry must stay "
            "framework-agnostic"
        )


def test_router_registered_at_ml_models_prefix() -> None:
    """Positive: ml_registry router uses /ml/models prefix."""
    _ensure_on_path()
    mod = importlib.import_module("app.api.routes.ml_registry")
    assert hasattr(mod, "router"), "router missing in ml_registry route module"
    assert mod.router.prefix == "/ml/models", (
        f"expected /ml/models prefix, got {mod.router.prefix!r}"
    )


def test_unknown_model_promote_returns_none_not_default() -> None:
    """Negative (S3): promote_to_production for unknown version returns None.

    Mis-route guard: the registry must NOT silently fall back to a default
    model when an unknown name/version is requested.  The route layer
    translates None → HTTP 404; verify the service layer returns None
    (not a default ``MLModel`` row).
    """
    _ensure_on_path()
    svc_mod = importlib.import_module("app.ml.registry_service")
    assert hasattr(svc_mod, "RegistryService"), "RegistryService missing"

    # Build a stub session that returns no row for any select.
    class _StubResult:
        def scalars(self):
            return self

        def first(self):
            return None

        def all(self):
            return []

    class _StubSession:
        async def execute(self, *_args, **_kwargs):
            return _StubResult()

        async def flush(self):
            pass

        async def refresh(self, _obj):
            pass

        def add(self, _obj):
            pass

    import asyncio

    async def _run() -> object:
        svc = svc_mod.RegistryService(_StubSession())
        return await svc.promote_to_production("nonexistent", "9.9.9")

    result = asyncio.run(_run())
    assert result is None, (
        f"promote_to_production must return None on unknown version, got {result!r} "
        "(silent default fallback = mis-route blast radius)"
    )
