"""Dependency-health-map emitted tests — generated by add_dependency_health_map.

Positive: HealthMapBuilder discovers configured deps from env, _aggregate
returns worst-case status, and the /health/map route is registered.
Negative: with no env vars set the discovered dep list is empty (so the
returned graph has no nodes and the overall status is healthy by default).
"""

from __future__ import annotations

import asyncio
import importlib
import os
import sys
from pathlib import Path


_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_health_map_builder_importable() -> None:
    """Positive: app.health_map exposes HealthMapBuilder + get_health_map_builder."""
    _ensure_on_path()
    mod = importlib.import_module("app.health_map")
    assert hasattr(mod, "HealthMapBuilder")
    assert hasattr(mod, "get_health_map_builder")


def test_discover_returns_configured_deps(monkeypatch) -> None:
    """Positive: HealthMapBuilder.discover() returns deps whose env vars are set."""
    _ensure_on_path()
    mod = importlib.import_module("app.health_map")
    monkeypatch.setenv("POSTGRES_SERVER", "localhost")
    monkeypatch.setenv("REDIS_URL", "redis://localhost:6379/0")
    monkeypatch.delenv("AWS_S3_BUCKET", raising=False)
    monkeypatch.delenv("STRIPE_SECRET_KEY", raising=False)
    builder = mod.HealthMapBuilder()
    discovered = builder.discover()
    assert "database" in discovered, f"database missing in {discovered!r}"
    assert "redis" in discovered, f"redis missing in {discovered!r}"
    assert "s3" not in discovered, f"s3 should not be discovered: {discovered!r}"
    assert "stripe" not in discovered, f"stripe should not be discovered: {discovered!r}"


def test_aggregate_worst_case() -> None:
    """Positive: _aggregate returns 'unhealthy' if any node is unhealthy/error."""
    _ensure_on_path()
    mod = importlib.import_module("app.health_map")
    assert mod._aggregate([{"status": "healthy"}, {"status": "healthy"}]) == "healthy"
    assert mod._aggregate([{"status": "healthy"}, {"status": "degraded"}]) == "degraded"
    assert mod._aggregate([{"status": "healthy"}, {"status": "unhealthy"}]) == "unhealthy"
    assert mod._aggregate([{"status": "healthy"}, {"status": "error"}]) == "unhealthy"


def test_no_env_means_empty_graph(monkeypatch) -> None:
    """Negative: with no dep env vars, build_graph yields empty nodes/edges."""
    _ensure_on_path()
    mod = importlib.import_module("app.health_map")
    for key in ("POSTGRES_SERVER", "REDIS_URL", "AWS_S3_BUCKET", "STRIPE_SECRET_KEY"):
        monkeypatch.delenv(key, raising=False)
    # Fresh builder (avoid the cached module-level singleton).
    builder = mod.HealthMapBuilder()
    graph = asyncio.run(builder.build_graph())
    assert graph["nodes"] == [], f"expected empty nodes, got {graph['nodes']!r}"
    assert graph["edges"] == [], f"expected empty edges, got {graph['edges']!r}"
    assert graph["status"] == "healthy"


def test_health_map_route_registered() -> None:
    """Positive: app.api.routes.health_map registers /health/map and /health/map.html."""
    _ensure_on_path()
    # Make sure POSTGRES_SERVER absence does not break import.
    os.environ.pop("POSTGRES_SERVER", None)
    mod = importlib.import_module("app.api.routes.health_map")
    router = getattr(mod, "router", None)
    assert router is not None
    paths = {getattr(r, "path", None) for r in router.routes}
    assert "/health/map" in paths, f"/health/map missing: {paths}"
    assert "/health/map.html" in paths, f"/health/map.html missing: {paths}"
