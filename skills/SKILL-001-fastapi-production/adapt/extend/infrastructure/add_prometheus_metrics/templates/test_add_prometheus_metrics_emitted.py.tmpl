"""Prometheus metrics emitted tests — generated by add_prometheus_metrics.

Positive: collectors / middleware / route modules are importable, and the
RequestMetrics + PrometheusMiddleware + /metrics router symbols exist.
Negative: prometheus_client is NOT imported at module top-level of
app/metrics/collectors.py (lazy import contract).
"""

from __future__ import annotations

import ast
import importlib
import sys
from pathlib import Path


_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_collectors_module_exposes_request_metrics() -> None:
    """Positive: app.metrics.collectors exposes RequestMetrics + get_metrics + init_metrics."""
    _ensure_on_path()
    mod = importlib.import_module("app.metrics.collectors")
    assert hasattr(mod, "RequestMetrics"), "RequestMetrics missing"
    assert hasattr(mod, "get_metrics"), "get_metrics missing"
    assert hasattr(mod, "init_metrics"), "init_metrics missing"


def test_middleware_module_exposes_prometheus_middleware() -> None:
    """Positive: app.metrics.middleware exposes PrometheusMiddleware."""
    _ensure_on_path()
    mod = importlib.import_module("app.metrics.middleware")
    assert hasattr(mod, "PrometheusMiddleware"), "PrometheusMiddleware missing"


def test_metrics_route_registered() -> None:
    """Positive: app.api.routes.metrics defines a FastAPI router with /metrics."""
    _ensure_on_path()
    mod = importlib.import_module("app.api.routes.metrics")
    router = getattr(mod, "router", None)
    assert router is not None, "router missing in metrics route"
    paths = {getattr(r, "path", None) for r in router.routes}
    assert "/metrics" in paths, f"/metrics path not registered (paths={paths})"


def test_prometheus_client_is_lazy_in_collectors() -> None:
    """Negative: prometheus_client must NOT appear at top-level in collectors.py."""
    collectors = _PROJECT_ROOT / "app" / "metrics" / "collectors.py"
    assert collectors.exists()
    tree = ast.parse(collectors.read_text())
    for node in tree.body:
        if isinstance(node, ast.Import):
            for alias in node.names:
                assert "prometheus_client" not in alias.name, (
                    "prometheus_client imported at top-level of collectors.py"
                )
        elif isinstance(node, ast.ImportFrom):
            assert (node.module or "") != "prometheus_client", (
                "from prometheus_client at top-level of collectors.py"
            )
