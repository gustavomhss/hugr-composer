"""PrometheusMiddleware — instruments every request with RED metrics."""

from __future__ import annotations

import logging
import time

from starlette.middleware.base import BaseHTTPMiddleware, RequestResponseEndpoint
from starlette.requests import Request
from starlette.responses import Response

from app.metrics.collectors import get_metrics

logger = logging.getLogger(__name__)

# Label used when no route matched (404s, unrouted paths). Using the raw URL
# path here would let a scanner hitting /random-<n> mint an unbounded number of
# Prometheus time series (R6-S5-F1 cardinality blow-up / metrics-store DoS).
_UNMATCHED_ROUTE = "__unmatched__"

# Standard HTTP methods. The `method` label is attacker-controlled (a client may
# send any verb, including garbage), so anything outside this allowlist collapses
# to a single bucket — otherwise the method axis reopens the same unbounded
# cardinality / metrics-store DoS the path normalisation closed (R6-S5-F1).
_KNOWN_METHODS = frozenset(
    {"GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"}
)
_OTHER_METHOD = "OTHER"


def _method_label(request: Request) -> str:
    """Return a bounded method label, collapsing non-standard verbs to OTHER.

    ``request.method`` is fully client-controlled: a scanner can send an
    unbounded number of distinct/garbage verbs, each minting a new time series
    on the ``method`` label (R6-S5-F1 cardinality DoS via the method axis).
    We allowlist the standard HTTP methods and map everything else to a single
    constant bucket.
    """
    method = request.method.upper()
    return method if method in _KNOWN_METHODS else _OTHER_METHOD


def _route_label(request: Request) -> str:
    """Return the matched route TEMPLATE (e.g. ``/users/{id}``) for the path label.

    The raw request path is high-cardinality: every distinct id (``/users/1``,
    ``/users/2`` ...) and every unmatched scanner URL would create a new label
    set, exploding the metrics store (R6-S5-F1). Starlette stores the matched
    route on the scope during routing, so after ``call_next`` we read its
    template; unmatched requests collapse to a single constant label.
    """
    route = request.scope.get("route")
    template = getattr(route, "path", None)
    return template if template else _UNMATCHED_ROUTE


class PrometheusMiddleware(BaseHTTPMiddleware):
    """Starlette middleware that records RED metrics for each request.

    Skips the ``/metrics`` endpoint itself to avoid self-instrumentation.
    """

    async def dispatch(
        self,
        request: Request,
        call_next: RequestResponseEndpoint,
    ) -> Response:
        """Record timing and status for every request.

        Args:
            request: Incoming HTTP request.
            call_next: Next middleware or route handler.

        Returns:
            HTTP response, after recording metrics.
        """
        if request.url.path == "/metrics":
            return await call_next(request)

        start = time.monotonic()
        response = await call_next(request)
        duration = time.monotonic() - start

        metrics = get_metrics()
        if metrics is not None:
            metrics.record_request(
                method=_method_label(request),
                path=_route_label(request),
                status=response.status_code,
                duration=duration,
            )
        return response
