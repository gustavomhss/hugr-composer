"""Anomaly-detector emitted tests — generated by add_anomaly_detector.

Positive: detector / alerter / middleware modules are importable, the
``AnomalyDetector`` raises a Z-score anomaly when a spike exceeds the
configured sensitivity, and the dispatcher logs a warning per anomaly.
Negative: ``httpx`` is NOT imported at module top-level of
``app/anomaly/alerter.py`` (lazy import contract).
"""

from __future__ import annotations

import ast
import importlib
import logging
import sys
from pathlib import Path


_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_detector_module_exposes_anomaly_detector() -> None:
    """Positive: app.anomaly.detector exposes AnomalyDetector + init/get."""
    _ensure_on_path()
    mod = importlib.import_module("app.anomaly.detector")
    assert hasattr(mod, "AnomalyDetector"), "AnomalyDetector missing"
    assert hasattr(mod, "get_detector"), "get_detector missing"
    assert hasattr(mod, "init_detector"), "init_detector missing"


def test_detector_emits_anomaly_on_z_score_spike() -> None:
    """Positive: a clear spike past sensitivity yields a non-empty anomaly list."""
    _ensure_on_path()
    detector_mod = importlib.import_module("app.anomaly.detector")
    detector = detector_mod.AnomalyDetector(sensitivity=2.0, window_size=50)
    # Seed window with stable baseline so std > 0 and z_score is computable.
    for _ in range(40):
        detector.observe(status_code=200, duration_ms=10.0, payload_bytes=100)
    # Now drive a latency spike well above the baseline mean+std.
    anomalies = detector.observe(status_code=200, duration_ms=5000.0, payload_bytes=100)
    metric_names = {a["metric"] for a in anomalies}
    assert "latency_ms" in metric_names, (
        f"expected latency_ms anomaly, got {anomalies!r}"
    )


def test_alerter_logs_warning(caplog) -> None:
    """Positive: AlertDispatcher.dispatch logs at WARNING level."""
    import asyncio

    _ensure_on_path()
    alerter_mod = importlib.import_module("app.anomaly.alerter")
    dispatcher = alerter_mod.AlertDispatcher(webhook_url=None)
    anomaly = {"metric": "latency_ms", "value": 5000.0, "z_score": 4.2, "ts": 0.0}
    with caplog.at_level(logging.WARNING, logger=alerter_mod.__name__):
        asyncio.run(dispatcher.dispatch(anomaly))
    assert any("Anomaly detected" in rec.message for rec in caplog.records), (
        f"no Anomaly detected warning, got {[r.message for r in caplog.records]!r}"
    )


def test_httpx_is_lazy_in_alerter() -> None:
    """Negative: httpx must NOT appear at top-level in alerter.py."""
    alerter = _PROJECT_ROOT / "app" / "anomaly" / "alerter.py"
    assert alerter.exists()
    tree = ast.parse(alerter.read_text())
    for node in tree.body:
        if isinstance(node, ast.Import):
            for alias in node.names:
                assert "httpx" not in alias.name, (
                    "httpx imported at top-level of alerter.py"
                )
        elif isinstance(node, ast.ImportFrom):
            assert (node.module or "") != "httpx", (
                "from httpx at top-level of alerter.py"
            )
