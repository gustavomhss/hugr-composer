def test_classify_route_maps_payments() -> None:
    """Negative: classify_route routes payment paths to payments group."""
    import importlib.util
    import sys

    pool_path = Path(__file__).parent.parent / "app" / "resilience" / "pool_config.py"
    spec = importlib.util.spec_from_file_location("pool_config", pool_path)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules["pool_config"] = mod
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    assert mod.classify_route("/payments/123") == "payments"
    assert mod.classify_route("/analytics/report") == "analytics"
    assert mod.classify_route("/users/1") == "crud"
