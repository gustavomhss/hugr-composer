"""HTTP routes for the Stripe refund flow.

Endpoints:
    POST /refunds
        Issue a refund for a payment the caller OWNS (or any payment for a
        superuser).  Requires authentication.  Refunds below
        REFUND_AUTO_APPROVE_THRESHOLD_CENTS are issued immediately; larger
        amounts require superuser.

    GET /refunds/{refund_id}
        Fetch a single Refund owned by the caller.  Requires authentication.

    GET /refunds/payment/{payment_id}
        List refunds for a payment the caller OWNS.  Requires authentication.

    POST /refunds/webhook/stripe
        Stripe webhook receiver for refund events. Not user-authenticated —
        secured by the ``Stripe-Signature`` HMAC, verified in the
        ``verify_stripe_signature`` dependency before the handler runs.
"""
from __future__ import annotations

import logging
import uuid
from typing import Any

from fastapi import APIRouter, Depends, HTTPException, Query, Request, status

from app.api.deps import CurrentUser
from app.core.config import settings
from app.core.session import SessionDep
from app.core.stripe_refunds import create_refund
from app.crud.refund import (
    create_pending_refund,
    get_refund_by_id,
    get_refund_by_stripe_id,
    list_refunds_for_payment,
    mark_refund_failed,
    mark_refund_stripe_id,
    mark_refund_succeeded,
)
from app.schemas.refund import (
    RefundListResponse,
    RefundPublic,
    RefundRequest,
)

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/refunds", tags=["refunds"])


def _check_auto_approve(amount_cents: int, current_user: Any) -> None:
    """Raise 403 if amount exceeds threshold and user is not superuser.

    Args:
        amount_cents: Requested refund amount.
        current_user: Authenticated user object.
    """
    threshold = settings.REFUND_AUTO_APPROVE_THRESHOLD_CENTS
    is_superuser = getattr(current_user, "is_superuser", False)
    if amount_cents > threshold and not is_superuser:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="refund amount exceeds auto-approve threshold",
        )


async def _load_owned_payment(
    session: Any, payment_id: uuid.UUID, current_user: Any
) -> Any:
    """Load a Payment the caller is allowed to act on, or raise 404 (R5-O3-F4).

    Ownership is enforced here: a non-superuser may only touch a payment whose
    ``user_id`` is their own. A cross-user (or orphaned ``user_id IS NULL``)
    payment returns 404 — never 403 — so the endpoint does not confirm the
    existence of another user's payment. Without this check any authenticated
    user could refund (or enumerate refunds for) an arbitrary payment_id.

    Imported lazily so this route file remains importable in projects that
    have not (yet) installed the Stripe Checkout flow.
    """
    from app.crud.payment import get_payment_by_id  # lazy: optional dep

    payment = await get_payment_by_id(session, payment_id)
    if payment is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="payment not found",
        )
    is_superuser = getattr(current_user, "is_superuser", False)
    if not is_superuser and getattr(payment, "user_id", None) != current_user.id:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="payment not found",
        )
    return payment


def _resolve_payment_intent_from(payment: Any) -> str:
    """Return the Stripe PaymentIntent id of an already-loaded Payment, or 409.

    The caller is expected to have validated ownership via ``_load_owned_payment``
    BEFORE calling this, so a non-owner gets 404 without learning whether the
    payment is refundable.
    """
    intent_id = getattr(payment, "stripe_payment_intent_id", None)
    if not intent_id:
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="payment has no Stripe PaymentIntent — cannot refund",
        )
    return intent_id


async def _lock_payment_for_update(session: Any, payment_id: uuid.UUID) -> None:
    """Take a row lock on the Payment so concurrent refunds serialise (R8-J2-3).

    The cumulative-cap check in ``_validate_refund_amount`` has a TOCTOU race:
    two concurrent refunds can both sum prior refunds + pass the cap before
    either inserts its own ``pending`` row, jointly exceeding the charge. We
    close it by ``SELECT ... FOR UPDATE`` on the Payment row BEFORE summing +
    validating + inserting, so the second transaction blocks on PostgreSQL
    until the first commits and then re-reads the now-current total. Under
    SQLite the global write lock already serialises writers, so the lock is a
    harmless no-op. Payment model imported lazily (optional Checkout dep).
    """
    from sqlalchemy import select  # lazy: keeps route importable sans ORM dep

    from app.models.payment import Payment  # lazy: optional Checkout dep

    stmt = select(Payment).where(Payment.id == payment_id).with_for_update()
    await session.execute(stmt)


async def _validate_refund_amount(
    session: Any, payment: Any, amount_cents: int
) -> None:
    """Reject a refund that would exceed the original charge (R8-J2-3).

    Sums prior non-failed refunds (``pending`` + ``succeeded``) for this payment
    and rejects with 409 when ``amount_cents + already_refunded`` exceeds the
    payment's ``amount_cents``. This — not the per-row Stripe idempotency key —
    is the primary guard against double / over-refunding; the idempotency key is
    only a backstop against exact-duplicate API retries. Caller MUST hold the
    Payment row lock (``_lock_payment_for_update``) so concurrent refunds
    serialise and cannot jointly exceed the charge (TOCTOU close).
    """
    from app.crud.refund import sum_non_failed_refunds_for_payment  # lazy

    charge_cents = getattr(payment, "amount_cents", None)
    if charge_cents is None:
        return
    already = await sum_non_failed_refunds_for_payment(session, payment.id)
    if amount_cents + already > charge_cents:
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="refund amount exceeds remaining refundable balance",
        )


async def _mark_refund_failed_by_id(
    session: Any,
    *,
    refund_id: uuid.UUID,
) -> None:
    """Mark a Refund row ``failed`` keyed by its internal UUID.

    Used by the error-path of ``request_refund`` when the Stripe API
    raises before a ``stripe_refund_id`` has been attached, so the
    webhook-keyed ``mark_refund_failed`` cannot help us reconcile.
    """
    refund = await get_refund_by_id(session, refund_id)
    if refund is None or refund.status == "failed":
        return
    refund.status = "failed"
    await session.flush()


async def _call_stripe_and_persist(
    session: Any,
    *,
    refund: Any,
    payment_intent_id: str,
    amount_cents: int,
    reason: str | None,
) -> None:
    """Call Stripe Refund API, attach stripe_refund_id, or mark failed + 502.

    Splits the Stripe interaction out of ``request_refund`` to keep the
    handler under the 50-LOC ceiling enforced by the contract check.
    """
    try:
        stripe_refund = create_refund(
            payment_intent_id=payment_intent_id,
            amount_cents=amount_cents,
            refund_id=refund.id,
            reason=reason,
        )
    except Exception as exc:  # noqa: BLE001 — any Stripe failure is terminal here
        logger.warning(
            "stripe refund create failed for refund_id=%s: %s",
            refund.id,
            exc.__class__.__name__,
        )
        await _mark_refund_failed_by_id(session, refund_id=refund.id)
        await session.commit()
        raise HTTPException(
            status_code=status.HTTP_502_BAD_GATEWAY,
            detail="stripe refund call failed",
        ) from exc
    stripe_refund_id = str(stripe_refund.get("id", ""))
    if stripe_refund_id:
        await mark_refund_stripe_id(
            session,
            refund_id=refund.id,
            stripe_refund_id=stripe_refund_id,
        )
        await session.commit()
        await session.refresh(refund)


@router.post("", response_model=RefundPublic, status_code=status.HTTP_201_CREATED)
async def request_refund(
    body: RefundRequest,
    current_user: CurrentUser,
    session: SessionDep,
) -> RefundPublic:
    """Issue a Stripe refund for a payment.

    Validates ownership (R5-O3-F4) and that ``amount_cents`` plus all prior
    non-failed refunds for the payment does NOT exceed the original charge
    (R8-J2-3) — rejecting with 409 otherwise.  This amount check, not the
    per-row Stripe idempotency key, is the primary guard against
    double/over-refunding.

    Persists a ``pending`` Refund row, commits it (so the row exists
    for the ``charge.refund.updated`` webhook to reconcile against),
    then calls ``create_refund`` to invoke the Stripe API.  On a
    Stripe failure the row is transitioned to ``failed`` and the
    caller receives 502 — never leaving an orphan ``pending`` row.
    """
    _check_auto_approve(body.amount_cents, current_user)
    if body.amount_cents > settings.REFUND_MAX_AMOUNT_CENTS:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail="refund amount exceeds maximum",
        )
    payment = await _load_owned_payment(session, body.payment_id, current_user)
    # Row-lock the Payment so concurrent refunds serialise (R8-J2-3 TOCTOU).
    await _lock_payment_for_update(session, body.payment_id)
    await _validate_refund_amount(session, payment, body.amount_cents)
    payment_intent_id = _resolve_payment_intent_from(payment)
    refund = await create_pending_refund(
        session,
        payment_id=body.payment_id,
        amount_cents=body.amount_cents,
        reason=body.reason,
        requested_by=current_user.id,
    )
    # Commit the pending row BEFORE the Stripe call so the row exists
    # if the webhook fires (or if the Stripe call hangs and we crash).
    await session.commit()
    await session.refresh(refund)
    await _call_stripe_and_persist(
        session,
        refund=refund,
        payment_intent_id=payment_intent_id,
        amount_cents=body.amount_cents,
        reason=body.reason,
    )
    return RefundPublic.model_validate(refund)


@router.get("/payment/{payment_id}", response_model=RefundListResponse)
async def list_payment_refunds(
    payment_id: uuid.UUID,
    current_user: CurrentUser,
    session: SessionDep,
    skip: int = Query(default=0, ge=0),
    limit: int = Query(default=50, ge=1, le=200),
) -> RefundListResponse:
    """Return all refunds for a payment the caller owns, newest first.

    Ownership is enforced first (R5-O3-F4): listing refunds for a payment you
    do not own returns 404, so the endpoint cannot be used to enumerate other
    users' refund history.
    """
    await _load_owned_payment(session, payment_id, current_user)
    rows, total = await list_refunds_for_payment(
        session, payment_id, limit=limit, offset=skip
    )
    data = [RefundPublic.model_validate(r) for r in rows]
    return RefundListResponse(data=data, count=total)


@router.get("/{refund_id}", response_model=RefundPublic)
async def get_refund(
    refund_id: uuid.UUID,
    current_user: CurrentUser,
    session: SessionDep,
) -> RefundPublic:
    """Fetch a single Refund owned by the current user."""
    refund = await get_refund_by_id(session, refund_id)
    if refund is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="refund not found",
        )
    is_superuser = getattr(current_user, "is_superuser", False)
    if not is_superuser and refund.requested_by != current_user.id:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="refund not found",
        )
    return RefundPublic.model_validate(refund)


async def _handle_refund_event(
    session: Any,
    event: dict[str, Any],
) -> None:
    """Dispatch a verified Stripe refund event to the right CRUD transition.

    Unknown event types are silently acked.  Each branch is idempotent.
    """
    event_type = event.get("type", "")
    data = (event.get("data") or {}).get("object") or {}
    stripe_refund_id = data.get("id", "")
    if not stripe_refund_id:
        return
    if event_type == "charge.refund.updated":
        refund_status = data.get("status", "")
        if refund_status == "succeeded":
            await mark_refund_succeeded(
                session, stripe_refund_id=stripe_refund_id
            )
        elif refund_status == "failed":
            await mark_refund_failed(
                session, stripe_refund_id=stripe_refund_id
            )


async def verify_stripe_signature(request: Request) -> dict[str, Any]:
    """Auth dependency for the webhook: verify the ``Stripe-Signature`` header.

    Webhook auth is the signature, NOT a logged-in user. The raw body is
    HMAC-verified against ``STRIPE_REFUND_WEBHOOK_SECRET`` via
    ``stripe.Webhook.construct_event`` (HMAC-SHA256 + 5-minute replay window)
    BEFORE any DB write; an invalid/absent signature raises 400 so the handler
    never runs on unauthenticated input. Returned as a ``Depends`` so the
    B0.11 admin-route auth rule recognises the route as guarded.
    """
    payload = await request.body()
    sig_header = request.headers.get("stripe-signature", "")
    import stripe  # lazy import — keeps app.main importable without stripe

    stripe.api_key = settings.STRIPE_SECRET_KEY
    stripe.api_version = settings.STRIPE_API_VERSION
    try:
        return stripe.Webhook.construct_event(
            payload, sig_header, settings.STRIPE_REFUND_WEBHOOK_SECRET
        )
    except Exception as exc:  # noqa: BLE001
        logger.warning("stripe refund webhook signature verification failed")
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="invalid stripe signature",
        ) from exc


@router.post("/webhook/stripe")
async def stripe_refund_webhook(
    session: SessionDep,
    event: dict[str, Any] = Depends(verify_stripe_signature),
) -> dict[str, bool]:
    """Receive a signature-verified Stripe refund webhook, then dispatch it.

    The ``Stripe-Signature`` HMAC check runs in ``verify_stripe_signature``
    (an injected ``Depends``) before this body executes, so an invalid
    signature returns 400 without ever touching the database.
    """
    await _handle_refund_event(session, event)
    await session.commit()
    return {"received": True}
