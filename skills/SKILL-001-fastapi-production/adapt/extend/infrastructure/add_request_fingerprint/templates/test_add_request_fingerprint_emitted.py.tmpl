"""Request-fingerprint emitted tests — generated by the add_request_fingerprint tool.

Positive: RequestFingerprinter computes a deterministic SHA-256 fingerprint
that is key-order independent on JSON bodies.
Negative: distinct user_ids yield distinct fingerprints (no cross-user
collision / abuse-detection false-negative).
"""

from __future__ import annotations

import sys
from pathlib import Path


def _load(rel: str, name: str):
    import importlib.util

    p = Path(__file__).parent.parent / rel
    spec = importlib.util.spec_from_file_location(name, p)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    return mod


def test_fingerprint_files_present() -> None:
    """Positive: every fingerprint module is emitted."""
    app = Path(__file__).parent.parent / "app"
    for rel in (
        "fingerprint/__init__.py",
        "fingerprint/hasher.py",
        "fingerprint/store.py",
        "middleware/fingerprint.py",
    ):
        assert (app / rel).exists(), f"missing fingerprint file: {rel}"


def test_hash_is_sha256_hex_64() -> None:
    """Positive: fingerprints are 64-char hex SHA-256 digests."""
    mod = _load("app/fingerprint/hasher.py", "app.fingerprint.hasher")
    fp = mod.RequestFingerprinter().compute("alice", "POST", "/items", b'{"x":1}')
    assert len(fp) == 64, f"expected 64-char hex, got {len(fp)}: {fp}"
    int(fp, 16)  # raises ValueError if not hex


def test_body_key_order_invariant() -> None:
    """Positive: JSON body key order MUST NOT change the fingerprint."""
    mod = _load("app/fingerprint/hasher.py", "app.fingerprint.hasher")
    fp_a = mod.RequestFingerprinter().compute("alice", "POST", "/items", b'{"a":1,"b":2}')
    fp_b = mod.RequestFingerprinter().compute("alice", "POST", "/items", b'{"b":2,"a":1}')
    assert fp_a == fp_b, "key-order changed the fingerprint — normalisation regression"


def test_distinct_users_distinct_fingerprints() -> None:
    """Negative: alice and bob with identical bodies must NOT collide.

    Honesty rule: cross-user collision = abuse-detection false negative.
    """
    mod = _load("app/fingerprint/hasher.py", "app.fingerprint.hasher")
    fp_a = mod.RequestFingerprinter().compute("alice", "POST", "/items", b'{"x":1}')
    fp_b = mod.RequestFingerprinter().compute("bob", "POST", "/items", b'{"x":1}')
    assert fp_a != fp_b, "distinct users collided — user-isolation regression"


def test_distinct_methods_distinct_fingerprints() -> None:
    """Negative: POST and PUT with identical body must NOT collide."""
    mod = _load("app/fingerprint/hasher.py", "app.fingerprint.hasher")
    fp_post = mod.RequestFingerprinter().compute("alice", "POST", "/items", b'{"x":1}')
    fp_put = mod.RequestFingerprinter().compute("alice", "PUT", "/items", b'{"x":1}')
    assert fp_post != fp_put, "method ignored in fingerprint — collision risk"
