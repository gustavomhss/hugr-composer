"""Emitted test for add_sqladmin — verifies the admin panel layer is wired."""

from __future__ import annotations

import pytest


def test_admin_auth_importable() -> None:
    """Positive: AdminAuthBackend is importable from app.admin.auth."""
    from app.admin.auth import AdminAuthBackend  # noqa: F401


def test_setup_admin_importable() -> None:
    """Positive: setup_admin is importable from app.admin.setup."""
    from app.admin.setup import setup_admin  # noqa: F401


def test_model_admins_is_list() -> None:
    """Positive: MODEL_ADMINS is a list (may be empty without sqladmin)."""
    from app.admin.views import MODEL_ADMINS

    assert isinstance(MODEL_ADMINS, list)


def test_setup_admin_no_op_without_sqladmin(monkeypatch: pytest.MonkeyPatch) -> None:
    """Positive: setup_admin logs warning and returns when sqladmin not installed."""
    import builtins

    real_import = builtins.__import__

    def mock_import(name, *args, **kwargs):
        if name == "sqladmin":
            raise ImportError("sqladmin not installed")
        return real_import(name, *args, **kwargs)

    from fastapi import FastAPI

    app = FastAPI()
    monkeypatch.setattr(builtins, "__import__", mock_import)

    from app.admin.setup import setup_admin

    # Should not raise, just warn
    setup_admin(app)
