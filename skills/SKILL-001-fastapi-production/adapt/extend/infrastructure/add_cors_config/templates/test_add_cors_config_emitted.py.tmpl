"""CORS-config emitted tests — generated by the add_cors_config tool.

Positive: CORSConfigMiddleware glue is wired and reads origins from env.
Negative: a non-wildcard CORS_ALLOWED_ORIGINS list does not warn.
"""

from __future__ import annotations

from pathlib import Path


def test_cors_middleware_file_exists() -> None:
    """Positive: app/middleware/cors_config.py was written by the tool."""
    glue = Path(__file__).parent.parent / "app" / "middleware" / "cors_config.py"
    assert glue.exists(), f"cors_config.py not found at {glue}"


def test_cors_middleware_reads_from_env() -> None:
    """Positive: glue reads CORS_ALLOWED_ORIGINS from environment (not hardcoded)."""
    glue = Path(__file__).parent.parent / "app" / "middleware" / "cors_config.py"
    body = glue.read_text()
    assert "CORS_ALLOWED_ORIGINS" in body, "CORS_ALLOWED_ORIGINS env-var read missing"
    assert "getenv" in body, "getenv read missing"
    assert "CORSMiddleware" in body, "Starlette CORSMiddleware not used"


def test_cors_debug_route_exists() -> None:
    """Positive: app/api/routes/cors_debug.py was emitted with /cors/config."""
    route = Path(__file__).parent.parent / "app" / "api" / "routes" / "cors_debug.py"
    assert route.exists(), f"cors_debug.py not found at {route}"
    body = route.read_text()
    assert "/config" in body, "/cors/config route missing"


def test_wildcard_warning_logic_present() -> None:
    """Positive: middleware contains wildcard-warning logic."""
    glue = Path(__file__).parent.parent / "app" / "middleware" / "cors_config.py"
    body = glue.read_text()
    assert "*" in body and ("warn" in body.lower() or "warning" in body.lower()), (
        "wildcard '*' warning logic missing"
    )


def test_specific_origin_list_does_not_warn() -> None:
    """Negative: a non-wildcard CORS_ALLOWED_ORIGINS list MUST NOT log a wildcard warning.

    The middleware's _warn_if_wildcard() only logs when '*' is in the
    parsed origins AND the environment is not local/test.
    """
    import importlib.util
    import sys

    glue = Path(__file__).parent.parent / "app" / "middleware" / "cors_config.py"
    spec = importlib.util.spec_from_file_location("cors_config_emitted_test", glue)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules["cors_config_emitted_test"] = mod
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    import logging

    records: list[logging.LogRecord] = []

    class _Handler(logging.Handler):
        def emit(self, record: logging.LogRecord) -> None:
            records.append(record)

    handler = _Handler(level=logging.WARNING)
    logging.getLogger("cors_config_emitted_test").addHandler(handler)
    try:
        mod._warn_if_wildcard(["https://app.example.com"], "production")
    finally:
        logging.getLogger("cors_config_emitted_test").removeHandler(handler)
    warns = [r for r in records if r.levelno >= logging.WARNING]
    assert not warns, f"specific-origin list must NOT warn, got {warns}"
