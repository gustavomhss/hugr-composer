"""CSRF-protection emitted tests — generated by the add_csrf_protection tool.

Positive: CSRFProtection.generate_token + validate_token round-trip succeeds.
Negative: tampered or mismatched tokens fail validation (security primitive
must not regress to a permissive validator).
"""

from __future__ import annotations

from pathlib import Path


def test_csrf_files_present() -> None:
    """Positive: CSRF security modules are emitted."""
    app = Path(__file__).parent.parent / "app"
    assert (app / "security" / "csrf.py").exists()
    assert (app / "security" / "csrf_middleware.py").exists()


def _load_csrf_module():
    import importlib.util
    import sys

    p = Path(__file__).parent.parent / "app" / "security" / "csrf.py"
    spec = importlib.util.spec_from_file_location("csrf_emitted_test", p)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules["csrf_emitted_test"] = mod
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    return mod


def test_token_round_trip() -> None:
    """Positive: a freshly generated token validates."""
    mod = _load_csrf_module()
    protection = mod.CSRFProtection(secret_key="emitted-test-secret-key-32-bytes!")
    token = protection.generate_token()
    assert protection.validate_token(token) is True


def test_tampered_signature_fails() -> None:
    """Negative: flipping a signature byte must fail validation."""
    mod = _load_csrf_module()
    protection = mod.CSRFProtection(secret_key="emitted-test-secret-key-32-bytes!")
    token = protection.generate_token()
    # Flip the last character of the signature.
    bad = token[:-1] + ("0" if token[-1] != "0" else "1")
    assert protection.validate_token(bad) is False, (
        "tampered token validated — signature check regression"
    )


def test_malformed_token_fails() -> None:
    """Negative: a token with the wrong number of dot-separated parts fails."""
    mod = _load_csrf_module()
    protection = mod.CSRFProtection(secret_key="emitted-test-secret-key-32-bytes!")
    assert protection.validate_token("not.a.valid.csrf.token.too.many.parts") is False
    assert protection.validate_token("only-one-part") is False


def test_validator_uses_constant_time_compare() -> None:
    """Positive: csrf.py uses hmac.compare_digest (constant-time)."""
    body = (Path(__file__).parent.parent / "app" / "security" / "csrf.py").read_text()
    assert "compare_digest" in body, (
        "csrf.py must use hmac.compare_digest — naive == comparison is timing-attackable"
    )
