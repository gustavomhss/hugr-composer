"""DLP-shield emitted tests — generated by the add_dlp_shield tool.

Positive: Redactor masks credit-card numbers + email addresses.
Negative: non-PII strings pass through unchanged; Luhn-invalid card-shaped
strings are NOT redacted (false-positive guard from the source).
"""

from __future__ import annotations

import sys
from pathlib import Path


def _load(rel: str, name: str):
    import importlib.util

    p = Path(__file__).parent.parent / rel
    spec = importlib.util.spec_from_file_location(name, p)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    return mod


def test_dlp_files_present() -> None:
    """Positive: every DLP module is emitted."""
    app = Path(__file__).parent.parent / "app"
    for rel in (
        "core/dlp/patterns.py",
        "core/dlp/redactor.py",
        "core/dlp/decorator.py",
        "middleware/dlp_shield.py",
    ):
        assert (app / rel).exists(), f"missing DLP file: {rel}"


def test_credit_card_redacted_in_full_mode() -> None:
    """Positive: Luhn-valid card number is redacted to ***."""
    # Load patterns module first so redactor's import resolves it.
    _load("app/core/dlp/patterns.py", "app.core.dlp.patterns")
    red = _load("app/core/dlp/redactor.py", "app.core.dlp.redactor")
    r = red.Redactor(mode="full")
    # Luhn-valid Visa test number.
    out = r.redact_value("card: 4111111111111111 thanks")
    assert "4111111111111111" not in out, "Luhn-valid card not redacted"
    assert "***" in out


def test_luhn_invalid_card_pass_through() -> None:
    """Negative: card-shaped string that fails Luhn is NOT redacted.

    Honesty rule: the Luhn validator is the source-of-truth gate. If a
    16-digit Visa-shaped number doesn't pass Luhn, the redactor MUST NOT
    redact it. Otherwise false-positive rate is silently inflated.
    """
    _load("app/core/dlp/patterns.py", "app.core.dlp.patterns")
    red = _load("app/core/dlp/redactor.py", "app.core.dlp.redactor")
    r = red.Redactor(mode="full")
    # 4111... with last digit flipped — fails Luhn.
    out = r.redact_value("not a card: 4111111111111112")
    assert "4111111111111112" in out, "Luhn-invalid string was redacted (false positive)"


def test_email_redacted() -> None:
    """Positive: an email address is redacted in full mode."""
    _load("app/core/dlp/patterns.py", "app.core.dlp.patterns")
    red = _load("app/core/dlp/redactor.py", "app.core.dlp.redactor")
    r = red.Redactor(mode="full")
    out = r.redact_value("contact alice@example.com please")
    assert "alice@example.com" not in out
    assert "***" in out


def test_decorator_attaches_sensitivity_level() -> None:
    """Positive: @sensitive(level='pci') attaches the attribute."""
    dec = _load("app/core/dlp/decorator.py", "app.core.dlp.decorator")

    @dec.sensitive(level="pci")
    async def view():
        return {"ok": True}

    assert dec.get_sensitivity_level(view) == "pci"
