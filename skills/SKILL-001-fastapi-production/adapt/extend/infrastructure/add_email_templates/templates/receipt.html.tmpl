<!doctype html>
<html lang="en">
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background:#f6f7f9; margin:0; padding:24px;">
    <div style="max-width:560px; margin:0 auto; background:#ffffff; border-radius:12px; padding:32px; box-shadow:0 1px 4px rgba(0,0,0,0.06);">
      <h1 style="margin:0 0 16px 0; color:#111827; font-size:22px;">Thanks for your purchase</h1>
      <p style="color:#374151; font-size:16px; line-height:1.5;">
        Hi {{ user_name }}, this is a confirmation for <strong>{{ item_name }}</strong> — <strong>{{ amount_formatted }}</strong>.
      </p>
      <p style="margin:24px 0;">
        <a href="{{ receipt_url }}" style="display:inline-block; background:#0f172a; color:#ffffff; text-decoration:none; padding:12px 20px; border-radius:8px; font-weight:600;">View full receipt</a>
      </p>
      <p style="color:#6b7280; font-size:13px;">
        Keep this email for your records.
      </p>
    </div>
  </body>
</html>
