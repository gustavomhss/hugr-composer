"""GPU-inference emitted tests — generated by add_ml_gpu_inference.

Positive: DeviceManager + GPUPredictor + MemoryGuard are importable
without torch installed, and DeviceManager.get_device() returns a
non-None device (CPU stub when torch is absent).
Negative: torch is NOT imported at module top-level in any app/ml/gpu/
file — the app must boot on CPU-only hosts (S2 weight-loading safety
mitigation per WP-06b §11).
"""

from __future__ import annotations

import ast
import importlib
import sys
from pathlib import Path


_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_device_manager_importable_without_torch() -> None:
    """Positive: DeviceManager loads + get_device returns non-None even with no torch."""
    _ensure_on_path()
    mod = importlib.import_module("app.ml.gpu.device")
    assert hasattr(mod, "DeviceManager"), "DeviceManager missing"
    dm = mod.DeviceManager()
    device = dm.get_device()
    assert device is not None, "get_device() must return a device (CPU stub OK)"
    stats = dm.memory_stats()
    assert isinstance(stats, dict), "memory_stats() must return a dict"


def test_gpu_init_reexports() -> None:
    """Positive: app.ml.gpu re-exports DeviceManager, GPUPredictor, MemoryGuard."""
    _ensure_on_path()
    mod = importlib.import_module("app.ml.gpu")
    for name in ("DeviceManager", "GPUPredictor", "MemoryGuard"):
        assert hasattr(mod, name), f"{name} not re-exported from app.ml.gpu"


def test_memory_guard_check_none_is_noop() -> None:
    """Positive: MemoryGuard.check(None) must not raise (no device = no check)."""
    _ensure_on_path()
    mod = importlib.import_module("app.ml.gpu.memory_guard")
    guard = mod.MemoryGuard()
    guard.check(None)  # Must not raise


def test_torch_not_at_top_level_in_gpu_package() -> None:
    """Negative: torch must NOT appear at module top-level in app/ml/gpu/.

    S2 mitigation: emitted code MUST boot on a CPU-only host. A top-level
    torch import would crash the app at module import time when torch is
    absent or CUDA-mismatched.
    """
    gpu_dir = _PROJECT_ROOT / "app" / "ml" / "gpu"
    assert gpu_dir.exists(), "app/ml/gpu/ missing"
    violations: list[str] = []
    for py_file in sorted(gpu_dir.rglob("*.py")):
        try:
            tree = ast.parse(py_file.read_text())
        except SyntaxError:
            continue
        for node in tree.body:
            if isinstance(node, ast.Import):
                for alias in node.names:
                    if alias.name == "torch" or alias.name.startswith("torch."):
                        violations.append(f"{py_file.name}: import {alias.name}")
            elif isinstance(node, ast.ImportFrom) and node.module:
                if node.module == "torch" or node.module.startswith("torch."):
                    violations.append(f"{py_file.name}: from {node.module} import ...")
    assert not violations, (
        "torch at module top-level in app/ml/gpu/:\n  " + "\n  ".join(violations)
    )
