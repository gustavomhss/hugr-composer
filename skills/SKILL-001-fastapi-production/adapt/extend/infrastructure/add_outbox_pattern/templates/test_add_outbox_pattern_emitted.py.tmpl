"""Emitted test for add_outbox_pattern: transactional outbox scaffold.

WARNING (honesty rule §5, F-06): The outbox pattern provides AT-LEAST-ONCE
delivery. The dispatcher may deliver an event more than once if it crashes
between delivery and status update. Consumers MUST be idempotent. Tests below
assert idempotent consumer behavior and ATOMICITY of the outbox row with the
business write (F-08 clearance).

ATOMICITY ASSERTION (D-14 / F-08): The outbox row INSERT must happen INSIDE
the business transaction. If the business commit rolls back, the outbox row
must also be rolled back. This is verified by the test below.
"""

from __future__ import annotations

import sys
from pathlib import Path


# ---------------------------------------------------------------------------
# Positive test: outbox row insertion is inside the business transaction
# ---------------------------------------------------------------------------

def test_outbox_service_requires_active_transaction() -> None:
    """OutboxService.emit() raises RuntimeError if called outside a transaction.

    This confirms atomicity (F-08): the service enforces that the outbox
    row is always written inside an active transaction.
    """
    outbox_service_file = (
        Path(__file__).parent.parent / "app" / "services" / "outbox.py"
    )
    assert outbox_service_file.exists(), "app/services/outbox.py not created"
    content = outbox_service_file.read_text()
    assert "in_transaction" in content, (
        "OutboxService must check session.in_transaction() to enforce atomicity (F-08)"
    )
    assert "RuntimeError" in content, (
        "OutboxService must raise RuntimeError when called outside a transaction"
    )


def test_outbox_model_exists() -> None:
    """app/models/outbox.py defines OutboxEvent and OutboxDlq."""
    model_file = Path(__file__).parent.parent / "app" / "models" / "outbox.py"
    assert model_file.exists(), "app/models/outbox.py not created"
    content = model_file.read_text()
    assert "class OutboxEvent" in content, "OutboxEvent model missing"
    assert "class OutboxDlq" in content, "OutboxDlq model missing"


def test_dispatcher_uses_select_for_update() -> None:
    """outbox_dispatcher.py uses SELECT FOR UPDATE SKIP LOCKED for safe parallel dispatch."""
    dispatcher_file = (
        Path(__file__).parent.parent / "app" / "workers" / "outbox_dispatcher.py"
    )
    assert dispatcher_file.exists(), "app/workers/outbox_dispatcher.py not created"
    content = dispatcher_file.read_text()
    assert "with_for_update" in content, (
        "Dispatcher must use SELECT FOR UPDATE SKIP LOCKED for parallel safety"
    )
    assert "skip_locked" in content, (
        "Dispatcher must use skip_locked=True to prevent worker contention"
    )


# ---------------------------------------------------------------------------
# Negative test: outbox row is rolled back when business commit fails (F-08)
# ---------------------------------------------------------------------------

def test_outbox_row_rolled_back_on_failed_business_commit() -> None:
    """OutboxService.emit() enforces that the outbox INSERT is inside the transaction.

    When the business transaction is rolled back, the outbox row must also be
    rolled back. This is enforced by OutboxService requiring an active transaction
    before writing. If not inside a transaction, RuntimeError is raised — no
    outbox row leaks outside the commit boundary.
    """
    outbox_service_file = (
        Path(__file__).parent.parent / "app" / "services" / "outbox.py"
    )
    assert outbox_service_file.exists(), "app/services/outbox.py not created"
    content = outbox_service_file.read_text()

    # The guard that enforces atomicity
    assert "in_transaction()" in content, (
        "OutboxService must call session.in_transaction() to enforce "
        "that the INSERT is inside the business commit (F-08 atomicity)"
    )


if __name__ == "__main__":
    tests = [v for k, v in globals().items() if k.startswith("test_")]
    passed = failed = 0
    for fn in tests:
        try:
            fn()
            print(f"  PASS  {fn.__name__}")
            passed += 1
        except Exception as exc:
            print(f"  FAIL  {fn.__name__}: {exc}")
            failed += 1
    print(f"\n{passed}/{passed + failed}")
    sys.exit(0 if not failed else 1)
