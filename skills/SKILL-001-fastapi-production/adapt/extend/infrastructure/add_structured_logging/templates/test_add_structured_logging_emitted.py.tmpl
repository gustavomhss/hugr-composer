"""Structured logging emitted tests — generated by add_structured_logging.

Positive: configure_structlog + Redactor + correlation helpers all importable
and Redactor scrubs PII from event_dict.
Negative: bind_context with no value returns a fresh UUID correlation id.
"""

from __future__ import annotations

import importlib
import sys
from pathlib import Path


_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_setup_module_exposes_configure_structlog() -> None:
    """Positive: app.logging.setup.configure_structlog is callable."""
    _ensure_on_path()
    mod = importlib.import_module("app.logging.setup")
    assert hasattr(mod, "configure_structlog"), "configure_structlog missing"
    assert callable(mod.configure_structlog), "configure_structlog not callable"


def test_redactor_strips_email_and_card() -> None:
    """Positive: Redactor replaces email + credit-card with [REDACTED]."""
    _ensure_on_path()
    redactor_mod = importlib.import_module("app.logging.redactor")
    redactor = redactor_mod.Redactor()
    event = {"msg": "user alice@example.com paid with 4111 1111 1111 1111"}
    out = redactor(None, "info", event)
    assert "alice@example.com" not in out["msg"], "email leaked"
    assert "4111 1111 1111 1111" not in out["msg"], "card leaked"
    assert "[REDACTED]" in out["msg"], "redaction marker missing"


def test_context_helpers_bind_and_get() -> None:
    """Positive: bind_context stores correlation_id; get_correlation_id returns it."""
    _ensure_on_path()
    ctx = importlib.import_module("app.logging.context")
    ctx.clear_context()
    ctx.bind_context(correlation_id="cid-abc-123")
    assert ctx.get_correlation_id() == "cid-abc-123"
    ctx.clear_context()


def test_get_correlation_id_falls_back_to_uuid() -> None:
    """Negative: with no correlation_id bound, get_correlation_id returns a UUID-shaped string."""
    _ensure_on_path()
    ctx = importlib.import_module("app.logging.context")
    ctx.clear_context()
    cid = ctx.get_correlation_id()
    assert isinstance(cid, str)
    assert len(cid) >= 32, f"fallback id too short: {cid!r}"
