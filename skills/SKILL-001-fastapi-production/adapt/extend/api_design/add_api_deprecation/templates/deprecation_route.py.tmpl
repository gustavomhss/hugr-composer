"""GET /deprecations — list all deprecated endpoints and sunset dates.

Mounted under the api_router prefix (e.g. /api/v1/deprecations).

Auth required (CONTRACT §B0.11): the deprecation registry surfaces
internal lifecycle metadata (planned sunset dates, replacement paths,
per-endpoint usage statistics) that aids targeted exploitation of
soon-to-be-removed endpoints. Gate behind ``get_current_user`` so
unauthenticated attackers cannot map the API's deprecation roadmap.
"""

from __future__ import annotations

import logging
from typing import Any

from fastapi import APIRouter, Depends

from app.api.deps import get_current_user
from app.models.user import User

logger = logging.getLogger(__name__)

router = APIRouter(tags=["lifecycle"])


@router.get("/deprecations")
async def list_deprecations(
    current_user: User = Depends(get_current_user),
) -> dict[str, Any]:
    """List all deprecated endpoints with sunset dates and usage statistics.

    Args:
        current_user: Authenticated user (B0.11 — lifecycle metadata is
            an internal-only signal; rejecting anonymous probes denies
            attackers a roadmap of soon-to-disappear endpoints).

    Returns:
        Dict with 'deprecated' list and 'usage' list.
    """
    from app.deprecation import registry
    from app.deprecation.reporter import reporter
    entries = registry.list_all()
    usage = reporter.usage_report()
    return {
        "deprecated": entries,
        "usage": usage,
        "total_deprecated": len(entries),
    }
