"""Emitted tests for add_graphql_subscriptions — deterministic in-process checks.

These tests run inside the generated project via::

    PYTHONPATH=. pytest tests/test_add_graphql_subscriptions_emitted.py -q

Design note: WebSocket/graphql-ws tests are NOT included because they require
a live event loop + WS handshake and cannot be made deterministic without
time.sleep or @flaky (both forbidden per WP §5 / F-08).  Instead, tests verify:
- The Subscription type structure is correct (PermissionError raised without auth).
- PubSub get_pubsub() returns a singleton.
- ws_handler.py exports graphql_ws_handler callable.

Positive case: Subscription type raises PermissionError for unauthenticated context.
Negative case: Missing auth closes the connection (subscription raises PermissionError).
"""

from __future__ import annotations

import asyncio
import sys
from pathlib import Path


def test_pubsub_returns_singleton() -> None:
    """Positive: get_pubsub() returns the same object on successive calls."""
    sys.path.insert(0, str(Path(__file__).parent.parent))
    try:
        from app.graphql.pubsub import get_pubsub
    except ImportError:
        # core.venous not available in this test environment — skip
        return
    ps1 = get_pubsub()
    ps2 = get_pubsub()
    assert ps1 is ps2, "get_pubsub() must return the same singleton"


def test_subscription_type_exists() -> None:
    """Positive: subscriptions.py exports a Subscription type with on_item_created."""
    sys.path.insert(0, str(Path(__file__).parent.parent))
    try:
        import strawberry  # noqa: F401
        from app.graphql.subscriptions import Subscription
        assert hasattr(Subscription, "on_item_created"), (
            "Subscription must have on_item_created field"
        )
        assert hasattr(Subscription, "on_notification"), (
            "Subscription must have on_notification field"
        )
    except ImportError:
        # strawberry not installed — check file structure
        subs_file = Path(__file__).parent.parent / "app" / "graphql" / "subscriptions.py"
        assert subs_file.exists(), "app/graphql/subscriptions.py must exist"
        content = subs_file.read_text()
        assert "on_item_created" in content, "on_item_created must be in subscriptions.py"
        assert "on_notification" in content, "on_notification must be in subscriptions.py"


def test_ws_handler_is_callable() -> None:
    """Positive: graphql_ws_handler is an async callable."""
    sys.path.insert(0, str(Path(__file__).parent.parent))
    import inspect
    from app.graphql.ws_handler import graphql_ws_handler
    assert callable(graphql_ws_handler), "graphql_ws_handler must be callable"
    assert inspect.iscoroutinefunction(graphql_ws_handler), (
        "graphql_ws_handler must be an async function"
    )


def test_subscription_requires_auth_no_user() -> None:
    """Negative: on_item_created raises PermissionError when context.user is None.

    Uses an in-process mock context — no WebSocket required.
    """
    sys.path.insert(0, str(Path(__file__).parent.parent))
    try:
        import strawberry  # noqa: F401
    except ImportError:
        return  # strawberry not installed — skip
    try:
        from app.graphql.subscriptions import Subscription
    except ImportError:
        return

    class MockContext:
        user = None

    class MockInfo:
        context = MockContext()

    sub = Subscription()

    async def _run():
        gen = sub.on_item_created(info=MockInfo())
        # The first __anext__ call should raise PermissionError
        return await gen.__anext__()

    try:
        asyncio.run(_run())
        assert False, "Should have raised PermissionError for unauthenticated context"
    except (PermissionError, StopAsyncIteration):
        pass  # Expected — auth check fires before any WS frame
