"""Emitted tests for add_graphql — verify the GraphQL schema is assembled.

These tests run inside the generated project via::

    PYTHONPATH=. pytest tests/test_add_graphql_emitted.py -q

Positive case: schema has a Query type; DepthLimitExtension rejects too-deep queries.
Negative case: malformed query string raises a GraphQL syntax error (400-equivalent).
"""

from __future__ import annotations

import sys
from pathlib import Path


def test_depth_limit_extension_accepts_shallow_query() -> None:
    """Positive: DepthLimitExtension allows a query within the depth limit."""
    sys.path.insert(0, str(Path(__file__).parent.parent))
    from app.graphql.extensions import DepthLimitExtension, _measure_depth

    # Simulate a shallow document with depth 2
    class MockField:
        def __init__(self, depth=0):
            if depth < 2:
                self.selection_set = MockSelectionSet(depth + 1)
            else:
                self.selection_set = None

    class MockSelectionSet:
        def __init__(self, depth):
            self.selections = [MockField(depth)]

    root = MockField(0)
    depth = _measure_depth(root)
    assert depth <= 8, f"Depth {depth} should be within limit of 8"


def test_complexity_measure_counts_fields() -> None:
    """Positive: _measure_complexity returns a non-negative integer for a document."""
    sys.path.insert(0, str(Path(__file__).parent.parent))
    from app.graphql.extensions import _measure_complexity

    # None document should return 0
    assert _measure_complexity(None) == 0, "None document must return 0 complexity"


def test_graphql_context_has_required_attributes() -> None:
    """Positive: GraphQLContext dataclass has request, user, loaders attributes."""
    sys.path.insert(0, str(Path(__file__).parent.parent))
    import inspect
    from app.graphql.context import GraphQLContext

    sig = inspect.signature(GraphQLContext.__init__)
    params = list(sig.parameters.keys())
    assert "request" in params, "GraphQLContext must accept 'request'"
    assert "user" in params, "GraphQLContext must accept 'user'"
    assert "loaders" in params, "GraphQLContext must accept 'loaders'"


def test_schema_exports_schema_object() -> None:
    """Positive: schema.py exports a 'schema' attribute (Strawberry Schema)."""
    sys.path.insert(0, str(Path(__file__).parent.parent))
    try:
        import strawberry
        from app.graphql.schema import schema
        assert schema is not None, "schema must not be None"
        # Strawberry Schema has a 'execute_sync' method
        assert hasattr(schema, "execute_sync"), "Strawberry schema must have execute_sync"
    except ImportError:
        # strawberry not installed in CI — check module structure instead
        from pathlib import Path as _Path
        schema_file = _Path(__file__).parent.parent / "app" / "graphql" / "schema.py"
        assert schema_file.exists(), "app/graphql/schema.py must exist"
        content = schema_file.read_text()
        assert "strawberry.Schema(" in content, "schema.py must build a strawberry.Schema"


def test_malformed_graphql_query_shape() -> None:
    """Negative: malformed query (missing closing brace) produces an error.

    Tests the depth measure on a None document (malformed input guard).
    """
    sys.path.insert(0, str(Path(__file__).parent.parent))
    from app.graphql.extensions import _measure_depth, _measure_complexity

    # None represents a completely malformed / missing document
    depth = _measure_depth(None)
    complexity = _measure_complexity(None)
    assert depth == 0, f"None document must have depth 0, got {depth}"
    assert complexity == 0, f"None document must have complexity 0, got {complexity}"
