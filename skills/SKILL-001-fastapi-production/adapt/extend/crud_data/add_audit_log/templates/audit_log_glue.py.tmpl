"""Wire the tamper-evident audit log into the FastAPI app.

Delegates to the primitive + FastAPI adapter copied under `core/venous/`
by the `add_audit_log` tool. Re-emitted idempotently.
"""

from __future__ import annotations

import hashlib
import os

from fastapi import FastAPI

from app.api.deps import get_current_superuser
from app.core.config import settings
from core.venous._adapters.fastapi.AuditLogAdapter import install


def _audit_hmac_secret() -> bytes:
    """Resolve the HMAC key: AUDIT_LOG_HMAC_SECRET if set, else derived from SECRET_KEY."""
    override = os.getenv("AUDIT_LOG_HMAC_SECRET", "").strip()
    if override:
        return override.encode()
    return hashlib.sha256(b"hugr-audit-log:" + settings.SECRET_KEY.encode()).digest()


def install_audit_log(app: FastAPI) -> None:
    """Attach a superuser-gated tamper-evident audit log to *app* (R5-S1-F1/F2).

    Durable (SQL-backed) when AUDIT_LOG_DURABLE is set; otherwise an in-memory
    ledger that does NOT persist across restarts (R5-S1-F5).
    """
    secret = _audit_hmac_secret()
    log = None
    if getattr(settings, "AUDIT_LOG_DURABLE", False):
        from app.audit_log_store import build_durable_audit_log

        log = build_durable_audit_log(secret)
    install(app, hmac_secret=secret, auth_dependency=get_current_superuser, log=log)
