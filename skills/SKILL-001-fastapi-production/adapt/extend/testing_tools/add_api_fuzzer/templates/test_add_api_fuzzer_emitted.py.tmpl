"""Wiring assertions for add_api_fuzzer — emitted by the tool.

Asserts that the emitted fuzzer infrastructure exists at the expected paths,
is importable, and key classes/functions are declared.  Does NOT invoke the
fuzzer as a sub-runner (per §11 D-00 resolution: wiring assertion only).
"""

from __future__ import annotations

import ast
from pathlib import Path


_PROJECT = Path(__file__).parent.parent


def test_fuzzer_package_exists() -> None:
    """Positive: app/fuzzer/__init__.py exists at expected path."""
    p = _PROJECT / "app" / "fuzzer" / "__init__.py"
    assert p.exists(), f"app/fuzzer/__init__.py not found at {p}"


def test_fuzzer_init_has_api_fuzzer_class() -> None:
    """Positive: APIFuzzer class declared in app/fuzzer/__init__.py."""
    p = _PROJECT / "app" / "fuzzer" / "__init__.py"
    src = p.read_text()
    assert "APIFuzzer" in src, "APIFuzzer class missing from app/fuzzer/__init__.py"
    assert "endpoint_list" in src, "endpoint_list method missing"
    assert "generate_payloads" in src, "generate_payloads method missing"


def test_fuzzer_init_ast_parses() -> None:
    """Positive: app/fuzzer/__init__.py is valid Python (AST-parses)."""
    p = _PROJECT / "app" / "fuzzer" / "__init__.py"
    try:
        ast.parse(p.read_text())
    except SyntaxError as exc:
        raise AssertionError(f"SyntaxError in app/fuzzer/__init__.py: {exc}") from exc


