def test_no_top_level_httpx_import_in_runner() -> None:
    """Negative: httpx must NOT be imported at module top level in runner.py."""
    p = _PROJECT / "app" / "fuzzer" / "runner.py"
    tree = ast.parse(p.read_text())
    for node in tree.body:
        if isinstance(node, (ast.Import, ast.ImportFrom)):
            names = (
                [a.name for a in node.names]
                if isinstance(node, ast.Import)
                else [node.module or ""]
            )
            for name in names:
                assert "httpx" not in name, (
                    "httpx must be lazily imported inside function body, not at module top"
                )
