"""Wiring assertions for add_schema_enforcer — emitted by the tool.

Asserts that the emitted schema enforcer infrastructure exists at expected
paths, AST-parses cleanly, and key classes/functions are declared.
Does NOT invoke the middleware or run live HTTP tests (wiring assertion only).
"""

from __future__ import annotations

import ast
from pathlib import Path

_PROJECT = Path(__file__).parent.parent
_APP = _PROJECT / "app"
_TESTS = _PROJECT / "tests"


def test_core_schema_enforcer_exists() -> None:
    """Positive: app/core/schema_enforcer.py exists."""
    p = _APP / "core" / "schema_enforcer.py"
    assert p.exists(), f"app/core/schema_enforcer.py not found at {p}"


def test_core_schema_enforcer_declares_load_spec() -> None:
    """Positive: schema_enforcer.py declares load_spec function."""
    p = _APP / "core" / "schema_enforcer.py"
    src = p.read_text()
    assert "def load_spec" in src, "load_spec not declared in app/core/schema_enforcer.py"


def test_core_schema_enforcer_declares_detect_shadow() -> None:
    """Positive: schema_enforcer.py declares detect_shadow_routes function."""
    p = _APP / "core" / "schema_enforcer.py"
    src = p.read_text()
    assert "def detect_shadow_routes" in src, "detect_shadow_routes not declared"


def test_core_schema_enforcer_declares_has_extra_fields() -> None:
    """Positive: schema_enforcer.py declares has_extra_fields function."""
    p = _APP / "core" / "schema_enforcer.py"
    src = p.read_text()
    assert "def has_extra_fields" in src, "has_extra_fields not declared"


def test_core_schema_enforcer_ast_parses() -> None:
    """Positive: app/core/schema_enforcer.py is valid Python."""
    p = _APP / "core" / "schema_enforcer.py"
    try:
        ast.parse(p.read_text())
    except SyntaxError as exc:
        raise AssertionError(f"SyntaxError in app/core/schema_enforcer.py: {exc}") from exc


