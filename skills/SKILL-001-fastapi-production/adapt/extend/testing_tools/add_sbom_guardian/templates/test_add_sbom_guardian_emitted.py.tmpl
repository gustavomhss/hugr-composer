"""Wiring assertions for add_sbom_guardian — emitted by the tool.

Asserts that the emitted SBOM guardian infrastructure exists at expected
paths, AST-parses cleanly, and key functions/constants are declared.
Does NOT invoke the scripts as sub-runners (wiring assertion only).
"""

from __future__ import annotations

import ast
from pathlib import Path

_PROJECT = Path(__file__).parent.parent
_SCRIPTS = _PROJECT / "scripts"


def test_scripts_package_exists() -> None:
    """Positive: scripts/__init__.py exists."""
    p = _SCRIPTS / "__init__.py"
    assert p.exists(), f"scripts/__init__.py not found at {p}"


def test_generate_sbom_exists() -> None:
    """Positive: scripts/generate_sbom.py exists."""
    p = _SCRIPTS / "generate_sbom.py"
    assert p.exists(), f"scripts/generate_sbom.py not found at {p}"


def test_generate_sbom_has_cyclonedx() -> None:
    """Positive: generate_sbom.py references CycloneDX format."""
    p = _SCRIPTS / "generate_sbom.py"
