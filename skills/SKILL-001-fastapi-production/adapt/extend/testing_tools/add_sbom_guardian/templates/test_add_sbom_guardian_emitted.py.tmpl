def test_verify_lockfile_no_external_top_level_imports() -> None:
    """Negative: verify_lockfile.py must not have third-party top-level imports."""
    _STDLIB = {
        "json", "subprocess", "sys", "pathlib", "hashlib", "logging",
        "argparse", "datetime", "re", "urllib", "ipaddress", "importlib",
        "__future__", "collections", "typing", "os",
    }
    p = _SCRIPTS / "verify_lockfile.py"
    tree = ast.parse(p.read_text())
    for node in tree.body:
        if isinstance(node, ast.Import):
            for alias in node.names:
                top = alias.name.split(".")[0]
                assert top in _STDLIB or top.startswith("_"), (
                    f"Non-stdlib top-level import in verify_lockfile.py: {alias.name}"
                )
        elif isinstance(node, ast.ImportFrom):
            if node.module:
                top = node.module.split(".")[0]
                assert top in _STDLIB or top.startswith("_"), (
                    f"Non-stdlib top-level from-import in verify_lockfile.py: {node.module}"
                )


