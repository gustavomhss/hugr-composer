def test_generate_sbom_has_sha256() -> None:
    """Positive: generate_sbom.py supports SHA-256 integrity signing."""
    p = _SCRIPTS / "generate_sbom.py"
    src = p.read_text()
    assert "sha256" in src.lower() or "SHA-256" in src, (
        "SHA-256 integrity signing not found in generate_sbom.py"
    )


def test_generate_sbom_ast_parses() -> None:
    """Positive: generate_sbom.py is valid Python."""
    p = _SCRIPTS / "generate_sbom.py"
    try:
        ast.parse(p.read_text())
    except SyntaxError as exc:
        raise AssertionError(f"SyntaxError in generate_sbom.py: {exc}") from exc


