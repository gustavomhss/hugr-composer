{
  "title": "EventBus — Publishes, Delivery, Errors",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Publishes (5m)",
      "targets": [{"expr": "sum(rate(eventbus_publish_count_total[5m]))"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Delivery Latency p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(eventbus_delivery_latency_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(eventbus_delivery_latency_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(eventbus_delivery_latency_bucket[5m]))"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Subscriber Errors (rate/s)",
      "targets": [{"expr": "sum(rate(eventbus_subscriber_errors_total[5m])) by (exception_type)"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Subscribers",
      "targets": [{"expr": "sum(eventbus_subscribers_active)"}]
    }
  ]
}
