{
  "title": "Tracer — Spans, Latency, Errors",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Spans Created (5m)",
      "targets": [{"expr": "sum(rate(tracer_spans_created_total[5m]))"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Span Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(tracer_span_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(tracer_span_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(tracer_span_duration_bucket[5m]))"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Spans Ended in ERROR (rate/s)",
      "targets": [{"expr": "sum(rate(tracer_span_duration_count{status=\"ERROR\"}[5m]))"}]
    }
  ]
}
