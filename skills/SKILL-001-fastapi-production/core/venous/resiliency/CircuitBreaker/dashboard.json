{
  "title": "CircuitBreaker — State, Transitions, Call Outcomes",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open Transitions (5m)",
      "targets": [{"expr": "sum(rate(circuitbreaker_transitions_total{to_state=\"open\"}[5m])) by (breaker)"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rejected Calls (5m)",
      "targets": [{"expr": "sum(rate(circuitbreaker_calls_total{outcome=\"rejected\"}[5m])) by (breaker)"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Call Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(circuitbreaker_call_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(circuitbreaker_call_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(circuitbreaker_call_duration_bucket[5m]))"}
      ]
    }
  ]
}
