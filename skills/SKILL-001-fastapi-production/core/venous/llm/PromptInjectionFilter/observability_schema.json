{
  "logs": [
    {
      "event_name": "pif.quarantined",
      "required_attributes": ["kind", "stripped_count", "body_bytes"]
    },
    {
      "event_name": "pif.rule.matched",
      "required_attributes": ["rule_name", "kind", "span_count"]
    },
    {
      "event_name": "pif.rule.errored",
      "required_attributes": ["rule_name", "error_class"]
    }
  ],
  "metrics": [
    {
      "name": "pif.quarantines",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 10,
      "label_keys": ["kind"]
    },
    {
      "name": "pif.stripped.fragments",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 50,
      "label_keys": ["kind"]
    },
    {
      "name": "pif.body.bytes",
      "metric_type": "histogram",
      "unit": "By",
      "cardinality_bound": 60,
      "label_keys": ["kind"]
    }
  ],
  "spans": [
    {
      "operation_name": "pif.quarantine",
      "required_attributes": ["pif.kind", "pif.stripped_count", "pif.rule_count"]
    },
    {
      "operation_name": "pif.rule.apply",
      "required_attributes": ["pif.rule_name", "pif.kind"]
    }
  ]
}
