{
  "title": "PromptInjectionFilter — Quarantines, Stripped Fragments, Rule Health",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Quarantines / 5m (by kind)",
      "targets": [{"expr": "sum by (kind) (rate(pif_quarantines_total[5m]))"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Stripped fragments p50/p95/p99",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(pif_stripped_fragments_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(pif_stripped_fragments_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(pif_stripped_fragments_bucket[5m]))"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Body bytes p50/p95/p99",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(pif_body_bytes_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(pif_body_bytes_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(pif_body_bytes_bucket[5m]))"}
      ]
    }
  ]
}
