{
  "logs": [
    {
      "event_name": "guardrail.verdict",
      "required_attributes": ["guardrail.name", "verdict.action", "verdict.reason"]
    },
    {
      "event_name": "guardrail.block",
      "required_attributes": ["guardrail.name", "verdict.reason", "output.length"]
    },
    {
      "event_name": "guardrail.rewrite",
      "required_attributes": ["guardrail.name", "delta.length", "verdict.reason"]
    }
  ],
  "metrics": [
    {
      "name": "guardrail.verdicts.total",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 1000,
      "label_keys": ["guardrail_name", "action"]
    },
    {
      "name": "guardrail.evaluate.latency",
      "metric_type": "histogram",
      "unit": "ms",
      "cardinality_bound": 500,
      "label_keys": ["guardrail_name"]
    },
    {
      "name": "guardrail.ledger.size",
      "metric_type": "gauge",
      "unit": "1",
      "cardinality_bound": 100,
      "label_keys": ["guardrail_name"]
    }
  ],
  "spans": [
    {
      "operation_name": "guardrail.evaluate",
      "required_attributes": ["guardrail.name", "verdict.action"]
    },
    {
      "operation_name": "guardrail.chain.apply",
      "required_attributes": ["chain.length", "output.length"]
    }
  ]
}
