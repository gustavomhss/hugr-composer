{
  "logs": [
    {
      "event_name": "request.shape.constructed",
      "required_attributes": ["request_id", "priority", "origin"]
    },
    {
      "event_name": "request.shape.retry",
      "required_attributes": ["request_id", "attempt", "idempotency_key_present"]
    },
    {
      "event_name": "request.shape.reject",
      "required_attributes": ["reason", "invariant_id"]
    }
  ],
  "metrics": [
    {
      "name": "request.shape.constructed",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 20,
      "label_keys": ["priority", "origin"]
    },
    {
      "name": "request.shape.attempt",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 50,
      "label_keys": ["priority"]
    },
    {
      "name": "request.shape.reject",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 10,
      "label_keys": ["invariant_id"]
    }
  ],
  "spans": [
    {
      "operation_name": "request.shape.construct",
      "required_attributes": ["request.id", "request.priority"]
    },
    {
      "operation_name": "request.shape.from_headers",
      "required_attributes": ["headers.request_id_present"]
    },
    {
      "operation_name": "request.shape.to_headers",
      "required_attributes": ["request.priority"]
    }
  ]
}
