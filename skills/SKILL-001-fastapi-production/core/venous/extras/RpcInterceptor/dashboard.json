{
  "title": "RpcInterceptor — Calls, Latency, Short-circuits",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Intercept Calls (5m)",
      "targets": [{"expr": "sum(rate(rpc_interceptor_calls_total[5m]))"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Intercept Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(rpc_interceptor_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(rpc_interceptor_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(rpc_interceptor_duration_bucket[5m]))"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Short-circuit Rate per Interceptor",
      "targets": [{"expr": "sum by (interceptor) (rate(rpc_interceptor_short_circuits_total[5m]))"}]
    }
  ]
}
