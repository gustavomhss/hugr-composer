{
  "title": "VirtualActor — Invocations, Queue, Reminders",
  "schemaVersion": 38,
  "panels": [
    {"id": 1, "type": "stat", "title": "Invocations / sec",
     "targets": [{"expr": "sum(rate(actor_invoke_calls_total[1m]))"}]},
    {"id": 2, "type": "timeseries", "title": "Queue Depth by Actor Type",
     "targets": [{"expr": "sum by (actor_type) (actor_queue_depth)"}]},
    {"id": 3, "type": "timeseries", "title": "Invoke Duration p99 (ms)",
     "targets": [{"expr": "histogram_quantile(0.99, rate(actor_invoke_duration_bucket[5m]))"}]}
  ]
}
