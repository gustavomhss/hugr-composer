{
  "title": "SagaOrchestrator — Flows, Compensations, Durations",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sagas Started (5m)",
      "targets": [{"expr": "sum(rate(saga_started_total[5m]))"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Saga Failures (5m)",
      "targets": [{"expr": "sum(rate(saga_outcomes_total{outcome=\"failed\"}[5m]))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Compensations by Step",
      "targets": [
        {"expr": "sum by (step_name) (rate(saga_compensations_total[5m]))"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Step Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(saga_step_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(saga_step_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(saga_step_duration_bucket[5m]))"}
      ]
    }
  ]
}
