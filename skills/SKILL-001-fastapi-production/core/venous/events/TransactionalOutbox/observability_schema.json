{
  "logs": [
    {
      "event_name": "outbox.transaction.opened",
      "required_attributes": ["txn_id"]
    },
    {
      "event_name": "outbox.transaction.committed",
      "required_attributes": ["txn_id", "staged_count"]
    },
    {
      "event_name": "outbox.transaction.rolled.back",
      "required_attributes": ["txn_id", "reason"]
    },
    {
      "event_name": "outbox.message.published",
      "required_attributes": ["message_id", "destination", "attempts"]
    },
    {
      "event_name": "outbox.message.failed",
      "required_attributes": ["message_id", "destination", "reason"]
    }
  ],
  "metrics": [
    {
      "name": "outbox.commits",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 10,
      "label_keys": ["result"]
    },
    {
      "name": "outbox.staged.size",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 30,
      "label_keys": []
    },
    {
      "name": "outbox.publish.duration",
      "metric_type": "histogram",
      "unit": "ms",
      "cardinality_bound": 50,
      "label_keys": ["result"]
    },
    {
      "name": "outbox.pending.depth",
      "metric_type": "gauge",
      "unit": "1",
      "cardinality_bound": 10,
      "label_keys": ["destination"]
    }
  ],
  "spans": [
    {
      "operation_name": "outbox.commit",
      "required_attributes": ["txn.id", "staged.count"]
    },
    {
      "operation_name": "outbox.rollback",
      "required_attributes": ["txn.id"]
    },
    {
      "operation_name": "outbox.relay",
      "required_attributes": ["batch.size", "published.count"]
    }
  ]
}
