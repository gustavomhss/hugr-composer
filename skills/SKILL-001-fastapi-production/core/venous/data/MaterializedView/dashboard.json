{
  "title": "MaterializedView — Events Applied, Staleness, Rebuilds",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events Applied (5m)",
      "targets": [{"expr": "sum(rate(view_applied_events_total[5m])) by (view)"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "View Staleness (s)",
      "targets": [{"expr": "view_staleness"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rebuild Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(view_rebuild_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(view_rebuild_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(view_rebuild_duration_bucket[5m]))"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Row Count by View",
      "targets": [{"expr": "view_rows"}]
    }
  ]
}
