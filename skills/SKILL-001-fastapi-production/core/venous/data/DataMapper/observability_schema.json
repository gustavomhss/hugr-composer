{
  "logs": [
    {
      "event_name": "datamapper.loaded",
      "required_attributes": ["table", "identity_values"]
    },
    {
      "event_name": "datamapper.mapped",
      "required_attributes": ["table", "kind", "identity_values"]
    },
    {
      "event_name": "datamapper.schema.drift",
      "required_attributes": ["table", "missing", "extra"]
    }
  ],
  "metrics": [
    {
      "name": "datamapper.map.calls",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 12,
      "label_keys": ["table", "kind"]
    },
    {
      "name": "datamapper.row.columns",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 50,
      "label_keys": ["table"]
    },
    {
      "name": "datamapper.schema.drift.count",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 20,
      "label_keys": ["table", "reason"]
    }
  ],
  "spans": [
    {
      "operation_name": "datamapper.load",
      "required_attributes": ["table", "identity_values"]
    },
    {
      "operation_name": "datamapper.map",
      "required_attributes": ["table", "kind", "identity_values"]
    }
  ]
}
