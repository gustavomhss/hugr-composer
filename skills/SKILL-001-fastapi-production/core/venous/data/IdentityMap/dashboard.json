{
  "title": "IdentityMap — Hit/Miss, Conflicts, Session Size",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hit Rate (5m)",
      "targets": [{"expr": "sum(rate(idmap_hits_total[5m])) / (sum(rate(idmap_hits_total[5m])) + sum(rate(idmap_misses_total[5m])))"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Conflicts (5m)",
      "targets": [{"expr": "sum(rate(idmap_conflicts_total[5m]))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Session Size p50/p95/p99",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(idmap_size_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(idmap_size_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(idmap_size_bucket[5m]))"}
      ]
    }
  ]
}
