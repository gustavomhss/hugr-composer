{
  "title": "ConfigBinding — Bind Health, Failures, Reloads",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bind Successes (5m)",
      "targets": [{"expr": "sum(rate(config_binds_total{result=\"success\"}[5m]))"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Bind Failures by Invariant",
      "targets": [{"expr": "sum by (invariant_id) (rate(config_binds_total{result=\"failed\"}[5m]))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Bind Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(config_bind_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(config_bind_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(config_bind_duration_bucket[5m]))"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Reloads (1h)",
      "targets": [{"expr": "sum(rate(config_reload_total[1h]))"}]
    }
  ]
}
