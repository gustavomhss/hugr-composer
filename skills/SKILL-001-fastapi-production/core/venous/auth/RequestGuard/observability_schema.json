{
  "logs": [
    {
      "event_name": "guard.evaluated",
      "required_attributes": ["request_id", "outcome", "evaluated_count", "composite_size"]
    },
    {
      "event_name": "guard.denied",
      "required_attributes": ["request_id", "outcome", "denying_guard_index", "subject_id"]
    },
    {
      "event_name": "guard.errored",
      "required_attributes": ["request_id", "error_type"]
    }
  ],
  "metrics": [
    {
      "name": "guard.decisions",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 16,
      "label_keys": ["outcome"]
    },
    {
      "name": "guard.evaluation.duration",
      "metric_type": "histogram",
      "unit": "ms",
      "cardinality_bound": 64,
      "label_keys": ["outcome"]
    },
    {
      "name": "guard.short_circuit.depth",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 32,
      "label_keys": ["outcome"]
    }
  ],
  "spans": [
    {
      "operation_name": "guard.evaluate",
      "required_attributes": ["request.id", "guards.count", "outcome"]
    },
    {
      "operation_name": "guard.dispatch",
      "required_attributes": ["request.id", "handler.invoked"]
    }
  ]
}
