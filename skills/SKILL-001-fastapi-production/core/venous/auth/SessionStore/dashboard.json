{
  "title": "SessionStore — Active Sessions, Rotations, Revocations",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Sessions",
      "targets": [{"expr": "sum(session_active)"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Revocations (5m)",
      "targets": [{"expr": "sum(rate(session_lifecycle_total{event=\"revoked\"}[5m]))"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rotations (5m)",
      "targets": [{"expr": "sum(rate(session_lifecycle_total{event=\"rotated\"}[5m]))"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Session Age at Revoke p50/p95/p99 (s)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(session_age_bucket{outcome=\"revoked\"}[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(session_age_bucket{outcome=\"revoked\"}[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(session_age_bucket{outcome=\"revoked\"}[5m]))"}
      ]
    }
  ]
}
