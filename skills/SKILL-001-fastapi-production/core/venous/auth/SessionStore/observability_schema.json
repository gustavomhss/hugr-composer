{
  "logs": [
    {
      "event_name": "session.created",
      "required_attributes": ["session_id_hash", "subject_hash", "created_at"]
    },
    {
      "event_name": "session.rotated",
      "required_attributes": ["old_id_hash", "new_id_hash", "subject_hash"]
    },
    {
      "event_name": "session.revoked",
      "required_attributes": ["session_id_hash", "reason"]
    },
    {
      "event_name": "session.revoked.all",
      "required_attributes": ["subject_hash", "count"]
    },
    {
      "event_name": "session.expired",
      "required_attributes": ["session_id_hash", "clock", "reason"]
    }
  ],
  "metrics": [
    {
      "name": "session.active",
      "metric_type": "gauge",
      "unit": "1",
      "cardinality_bound": 10,
      "label_keys": []
    },
    {
      "name": "session.lifecycle",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 20,
      "label_keys": ["event"]
    },
    {
      "name": "session.age",
      "metric_type": "histogram",
      "unit": "s",
      "cardinality_bound": 50,
      "label_keys": ["outcome"]
    },
    {
      "name": "session.revoke.batch",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 20,
      "label_keys": ["trigger"]
    }
  ],
  "spans": [
    {
      "operation_name": "session.create",
      "required_attributes": ["subject.hash"]
    },
    {
      "operation_name": "session.rotate",
      "required_attributes": ["session.old_id_hash", "session.new_id_hash"]
    },
    {
      "operation_name": "session.revoke",
      "required_attributes": ["session.id_hash"]
    },
    {
      "operation_name": "session.revoke.all",
      "required_attributes": ["subject.hash", "count"]
    }
  ]
}
