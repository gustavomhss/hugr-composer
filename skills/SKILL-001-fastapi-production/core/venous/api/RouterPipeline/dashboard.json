{
  "title": "RouterPipeline — Pipelines, Routes, Dispatch Latency",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests Dispatched (5m)",
      "targets": [{"expr": "sum(rate(router_requests_dispatched_total[5m]))"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Dispatch Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(router_request_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(router_request_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(router_request_duration_bucket[5m]))"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests By Pipeline",
      "targets": [{"expr": "sum by (pipeline) (rate(router_requests_dispatched_total[5m]))"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Halted Requests (short-circuits)",
      "targets": [{"expr": "sum by (pipeline) (rate(router_requests_dispatched_total{halted=\"true\"}[5m]))"}]
    }
  ]
}
