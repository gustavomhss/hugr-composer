{
  "logs": [
    {
      "event_name": "api.request.started",
      "required_attributes": ["request_id", "header_keys"]
    },
    {
      "event_name": "api.request.halted",
      "required_attributes": ["request_id", "is_halted"]
    },
    {
      "event_name": "api.request.completed",
      "required_attributes": ["request_id", "is_disposed", "assign_keys"]
    }
  ],
  "metrics": [
    {
      "name": "api.request.started",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 10,
      "label_keys": ["route"]
    },
    {
      "name": "api.request.halted",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 20,
      "label_keys": ["reason"]
    },
    {
      "name": "api.request.assign_count",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 10,
      "label_keys": ["route"]
    }
  ],
  "spans": [
    {
      "operation_name": "api.request.scope",
      "required_attributes": ["request_id", "is_halted"]
    },
    {
      "operation_name": "api.request.put",
      "required_attributes": ["request_id", "assign_key"]
    }
  ]
}
