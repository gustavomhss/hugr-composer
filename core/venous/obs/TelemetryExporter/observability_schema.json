{
  "logs": [
    {"event_name": "exporter.batch.exported", "required_attributes": ["signal", "result"]},
    {"event_name": "exporter.retry.triggered", "required_attributes": ["attempt", "signal"]},
    {"event_name": "exporter.shutdown.called", "required_attributes": ["signal"]}
  ],
  "metrics": [
    {"name": "exporter.export.count", "metric_type": "counter", "unit": "1", "cardinality_bound": 30, "label_keys": ["signal", "result"]},
    {"name": "exporter.retry.count", "metric_type": "counter", "unit": "1", "cardinality_bound": 10, "label_keys": ["signal"]},
    {"name": "exporter.batch.size", "metric_type": "histogram", "unit": "1", "cardinality_bound": 20, "label_keys": ["signal"]}
  ],
  "spans": [
    {"operation_name": "exporter.export", "required_attributes": ["signal", "batch.size"]}
  ]
}
