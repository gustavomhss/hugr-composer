{
  "logs": [
    {
      "event_name": "di.registered",
      "required_attributes": ["iface", "scope"]
    },
    {
      "event_name": "di.resolved",
      "required_attributes": ["iface", "scope", "cached"]
    },
    {
      "event_name": "di.scope.disposed",
      "required_attributes": ["scope_id", "instance_count"]
    }
  ],
  "metrics": [
    {
      "name": "di.resolves",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 50,
      "label_keys": ["scope", "cached"]
    },
    {
      "name": "di.scope.instance_count",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 30,
      "label_keys": ["scope"]
    },
    {
      "name": "di.resolve.duration",
      "metric_type": "histogram",
      "unit": "ms",
      "cardinality_bound": 50,
      "label_keys": ["iface"]
    }
  ],
  "spans": [
    {
      "operation_name": "di.resolve",
      "required_attributes": ["di.iface", "di.scope", "di.cached"]
    },
    {
      "operation_name": "di.scope.dispose",
      "required_attributes": ["di.scope_id", "di.instance_count"]
    }
  ]
}
