{
  "title": "TransactionalBatch — Commits, Conflicts, Latency",
  "schemaVersion": 38,
  "panels": [
    {"id": 1, "type": "stat", "title": "Commits / sec",
     "targets": [{"expr": "sum(rate(batch_commit_calls_total[5m]))"}]},
    {"id": 2, "type": "timeseries", "title": "Commit Duration p99 (ms)",
     "targets": [{"expr": "histogram_quantile(0.99, rate(batch_commit_duration_bucket[5m]))"}]},
    {"id": 3, "type": "timeseries", "title": "Etag Conflict Rate / sec",
     "targets": [{"expr": "sum(rate(batch_commit_calls_total{outcome=\"conflict\"}[5m]))"}]}
  ]
}
