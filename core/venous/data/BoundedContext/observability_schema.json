{
  "logs": [
    {
      "event_name": "bounded.context.registered",
      "required_attributes": ["context_name"]
    },
    {
      "event_name": "bounded.context.aggregate.claimed",
      "required_attributes": ["context_name", "aggregate_type"]
    },
    {
      "event_name": "bounded.context.language.conflict",
      "required_attributes": ["context_name", "term", "existing_meaning", "attempted_meaning"]
    },
    {
      "event_name": "bounded.context.integration.published",
      "required_attributes": ["upstream", "downstream", "kind"]
    },
    {
      "event_name": "bounded.context.cross.context.leak",
      "required_attributes": ["from_context", "to_context", "object_type"]
    }
  ],
  "metrics": [
    {
      "name": "bounded.context.aggregates.owned",
      "metric_type": "gauge",
      "unit": "1",
      "cardinality_bound": 100,
      "label_keys": ["context_name"]
    },
    {
      "name": "bounded.context.integrations",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 50,
      "label_keys": ["kind"]
    },
    {
      "name": "bounded.context.ownership.conflicts",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 20,
      "label_keys": ["result"]
    },
    {
      "name": "bounded.context.language.terms",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 30,
      "label_keys": ["context_name"]
    }
  ],
  "spans": [
    {
      "operation_name": "bounded.context.claim",
      "required_attributes": ["context.name", "aggregate.type"]
    },
    {
      "operation_name": "bounded.context.forward",
      "required_attributes": ["from.context", "to.context", "translator.kind"]
    }
  ]
}
