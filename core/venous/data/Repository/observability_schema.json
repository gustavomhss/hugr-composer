{
  "logs": [
    {
      "event_name": "repo.added",
      "required_attributes": ["root_type", "root_id"]
    },
    {
      "event_name": "repo.removed",
      "required_attributes": ["root_type", "root_id"]
    },
    {
      "event_name": "repo.cache.hit",
      "required_attributes": ["root_type", "root_id"]
    },
    {
      "event_name": "repo.cache.miss",
      "required_attributes": ["root_type", "root_id"]
    }
  ],
  "metrics": [
    {
      "name": "repo.get.calls",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 20,
      "label_keys": ["root_type", "result"]
    },
    {
      "name": "repo.find.matched",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 30,
      "label_keys": ["root_type"]
    },
    {
      "name": "repo.mutations",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 40,
      "label_keys": ["root_type", "op"]
    },
    {
      "name": "repo.identity.map.hit.ratio",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 20,
      "label_keys": ["root_type"]
    }
  ],
  "spans": [
    {
      "operation_name": "repo.get",
      "required_attributes": ["root.type", "root.id", "cache.hit"]
    },
    {
      "operation_name": "repo.find",
      "required_attributes": ["root.type", "spec.kind", "match.count"]
    },
    {
      "operation_name": "repo.add",
      "required_attributes": ["root.type", "root.id"]
    },
    {
      "operation_name": "repo.remove",
      "required_attributes": ["root.type", "root.id"]
    }
  ]
}
