{
  "logs": [
    {
      "event_name": "spec.evaluated",
      "required_attributes": ["spec_id", "outcome"]
    },
    {
      "event_name": "spec.composed",
      "required_attributes": ["spec_id", "operator", "child_count"]
    },
    {
      "event_name": "spec.translated",
      "required_attributes": ["spec_id", "backend", "leaf_count"]
    }
  ],
  "metrics": [
    {
      "name": "spec.evaluations",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 50,
      "label_keys": ["outcome"]
    },
    {
      "name": "spec.composition.depth",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 30,
      "label_keys": ["operator"]
    },
    {
      "name": "spec.translate.duration",
      "metric_type": "histogram",
      "unit": "ms",
      "cardinality_bound": 50,
      "label_keys": ["backend", "result"]
    }
  ],
  "spans": [
    {
      "operation_name": "spec.evaluate",
      "required_attributes": ["spec.id", "spec.kind"]
    },
    {
      "operation_name": "spec.translate",
      "required_attributes": ["spec.id", "backend", "leaf.count"]
    }
  ]
}
