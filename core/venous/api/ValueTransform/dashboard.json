{
  "title": "ValueTransform — Coercion, Validation, Latency",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Transform Calls (5m)",
      "targets": [{"expr": "sum(rate(value_transform_calls_total[5m]))"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Transform Duration p50/p95/p99 (us)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(value_transform_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(value_transform_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(value_transform_duration_bucket[5m]))"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transform Errors by Class (rate/s)",
      "targets": [{"expr": "sum by (error_class) (rate(value_transform_errors_total[5m]))"}]
    }
  ]
}
