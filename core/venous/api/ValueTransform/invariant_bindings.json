{
  "invariant_bindings": [
    {
      "invariant_id": "VTRANSFORM_INV_01",
      "invariant_text": "transform() MUST raise a typed validation error on bad input; it NEVER returns None to signal invalid.",
      "confirms_test": "test_inv_typed_error_confirms",
      "prevents_test": "test_inv_typed_error_prevents",
      "under_failure_test": "test_inv_typed_error_under_failure"
    },
    {
      "invariant_id": "VTRANSFORM_INV_02",
      "invariant_text": "A ValueTransform MUST be pure: same (value, meta) SHALL produce the same output with no observable side effects.",
      "confirms_test": "test_inv_purity_confirms",
      "prevents_test": "test_inv_purity_prevents",
      "under_failure_test": "test_inv_purity_under_failure"
    },
    {
      "invariant_id": "VTRANSFORM_INV_03",
      "invariant_text": "metatype MUST drive the coercion target; CANNOT silently ignore the declared type.",
      "confirms_test": "test_inv_metatype_drives_confirms",
      "prevents_test": "test_inv_metatype_drives_prevents",
      "under_failure_test": "test_inv_metatype_drives_under_failure"
    },
    {
      "invariant_id": "VTRANSFORM_INV_04",
      "invariant_text": "Composed transforms MUST apply left-to-right in declaration order; swapping order SHALL be explicit.",
      "confirms_test": "test_inv_compose_order_confirms",
      "prevents_test": "test_inv_compose_order_prevents",
      "under_failure_test": "test_inv_compose_order_under_failure"
    },
    {
      "invariant_id": "VTRANSFORM_INV_05",
      "invariant_text": "NEVER mutates the incoming value in place; the returned value is always fresh.",
      "confirms_test": "test_inv_no_mutation_confirms",
      "prevents_test": "test_inv_no_mutation_prevents",
      "under_failure_test": "test_inv_no_mutation_under_failure"
    }
  ]
}
