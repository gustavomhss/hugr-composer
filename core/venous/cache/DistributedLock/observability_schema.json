    {"event_name": "lock.contended", "required_attributes": ["resource_id", "caller_id"]},
    {"event_name": "lock.released", "required_attributes": ["resource_id", "owner_id"]},
    {"event_name": "lock.fence.rejected", "required_attributes": ["resource_id", "caller_id", "holder_id"]},
    {"event_name": "lock.lease.expired", "required_attributes": ["resource_id", "owner_id"]}
  ],
  "metrics": [
    {"name": "lock.acquire.attempts", "metric_type": "counter", "unit": "1", "cardinality_bound": 100, "label_keys": ["outcome"]},
