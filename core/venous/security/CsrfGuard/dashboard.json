{
  "title": "CsrfGuard — Verifications, Rejections, Latency",
  "schemaVersion": 38,
  "panels": [
    {"id": 1, "type": "stat", "title": "verify ops/s",
     "targets": [{"expr": "sum(rate(csrf_guard_operations_total{operation=\"verify\"}[5m]))"}]},
    {"id": 2, "type": "stat", "title": "rejection rate",
     "targets": [{"expr": "sum(rate(csrf_guard_rejections_total[5m]))"}]},
    {"id": 3, "type": "timeseries", "title": "verify p99 latency (us)",
     "targets": [{"expr": "histogram_quantile(0.99, rate(csrf_guard_verify_duration_bucket[5m]))"}]}
  ]
}
