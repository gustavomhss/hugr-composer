{
  "title": "PromptTemplate — Registry & Render Health",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Registered Prompts",
      "targets": [{"expr": "sum(prompt_registry_size)"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Render p95 latency (ms)",
      "targets": [{"expr": "histogram_quantile(0.95, rate(prompt_render_latency_bucket[5m]))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Render errors per kind",
      "targets": [{"expr": "sum by (error_kind) (rate(prompt_render_errors_total[5m]))"}]
    }
  ]
}
