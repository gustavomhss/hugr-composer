{
  "title": "WorkflowRun — Starts, Duration, Active",
  "schemaVersion": 38,
  "panels": [
    {"id": 1, "type": "stat", "title": "Workflow Starts / sec",
     "targets": [{"expr": "sum(rate(workflow_runs_started_total[5m]))"}]},
    {"id": 2, "type": "timeseries", "title": "Run Duration p99 (ms)",
     "targets": [{"expr": "histogram_quantile(0.99, rate(workflow_run_duration_bucket[5m]))"}]},
    {"id": 3, "type": "timeseries", "title": "Active Runs",
     "targets": [{"expr": "sum(workflow_active_runs)"}]}
  ]
}
