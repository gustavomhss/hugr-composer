{
  "title": "DomainEvent — Publishing, Rejections, Stream Lag",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Published Events (5m)",
      "targets": [{"expr": "sum(rate(domain_event_published_total[5m]))"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rejections by Invariant (5m)",
      "targets": [{"expr": "sum by (invariant_id) (rate(domain_event_rejected_total[5m]))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Publish Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(domain_event_publish_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(domain_event_publish_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(domain_event_publish_duration_bucket[5m]))"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pending Stream Depth by Aggregate Type",
      "targets": [{"expr": "sum by (aggregate_type) (domain_event_stream_pending)"}]
    }
  ]
}
