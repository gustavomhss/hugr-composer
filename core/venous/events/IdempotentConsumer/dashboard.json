{
  "title": "IdempotentConsumer — Deliveries, Duplicates, Effect Duration",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "First Deliveries (5m)",
      "targets": [{"expr": "sum(rate(consumer_deliveries_total{result=\"first\"}[5m]))"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Duplicates Skipped (5m)",
      "targets": [{"expr": "sum(rate(consumer_deliveries_total{result=\"duplicate\"}[5m]))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Effect Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(consumer_effect_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(consumer_effect_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(consumer_effect_duration_bucket[5m]))"}
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Cache Size by Consumer",
      "targets": [{"expr": "consumer_cache_size"}]
    }
  ]
}
