{
  "title": "TransactionalOutbox — Commits, Publishes, Pending Depth",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Commits (5m)",
      "targets": [{"expr": "sum(rate(outbox_commits_total{result=\"ok\"}[5m]))"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rollbacks (5m)",
      "targets": [{"expr": "sum(rate(outbox_commits_total{result=\"rolled_back\"}[5m]))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Publish Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(outbox_publish_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(outbox_publish_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(outbox_publish_duration_bucket[5m]))"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pending Depth by Destination",
      "targets": [{"expr": "sum by (destination) (outbox_pending_depth)"}]
    }
  ]
}
