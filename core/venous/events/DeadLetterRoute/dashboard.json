{
  "title": "DeadLetterRoute — Parked Depth, Send, Requeue, Purge",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Parked depth (current)",
      "targets": [{"expr": "sum(dlq_parked_depth) by (destination_topic)"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Park rate / 5m",
      "targets": [{"expr": "sum(rate(dlq_sent_total[5m])) by (destination_topic, reason)"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requeue / purge rate / 5m",
      "targets": [
        {"expr": "sum(rate(dlq_requeued_total[5m])) by (destination_topic)"},
        {"expr": "sum(rate(dlq_purged_total[5m])) by (destination_topic, reason)"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DLQ age p50/p95/p99 (seconds)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(dlq_age_seconds_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(dlq_age_seconds_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(dlq_age_seconds_bucket[5m]))"}
      ]
    }
  ]
}
