{
  "logs": [
    {
      "event_name": "bus.published",
      "required_attributes": ["topic", "seq", "envelope_id"]
    },
    {
      "event_name": "bus.acked",
      "required_attributes": ["topic", "group", "envelope_id"]
    },
    {
      "event_name": "bus.nacked",
      "required_attributes": ["topic", "group", "envelope_id", "reason"]
    },
    {
      "event_name": "bus.dlq.routed",
      "required_attributes": ["topic", "group", "envelope_id", "reason"]
    }
  ],
  "metrics": [
    {
      "name": "bus.publish.total",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 100,
      "label_keys": ["topic", "result"]
    },
    {
      "name": "bus.delivery.attempts",
      "metric_type": "histogram",
      "unit": "1",
      "cardinality_bound": 200,
      "label_keys": ["topic", "group"]
    },
    {
      "name": "bus.dlq.total",
      "metric_type": "counter",
      "unit": "1",
      "cardinality_bound": 100,
      "label_keys": ["topic", "group", "reason"]
    },
    {
      "name": "bus.handler.duration",
      "metric_type": "histogram",
      "unit": "ms",
      "cardinality_bound": 200,
      "label_keys": ["topic", "group", "result"]
    }
  ],
  "spans": [
    {
      "operation_name": "bus.publish",
      "required_attributes": ["topic", "envelope.id", "seq"]
    },
    {
      "operation_name": "bus.dispatch",
      "required_attributes": ["topic", "group", "envelope.id", "attempt"]
    }
  ]
}
