{
  "title": "TokenIntrospector — Introspection, Cache, Rejections",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Introspections accepted (5m)",
      "targets": [{"expr": "sum(rate(token_introspect_total{result=\"accepted\"}[5m]))"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Introspections rejected (5m)",
      "targets": [{"expr": "sum(rate(token_introspect_total{result=\"rejected\"}[5m]))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "JWKS fetch p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(jwks_fetch_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(jwks_fetch_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(jwks_fetch_duration_bucket[5m]))"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "targets": [{"expr": "token_cache_hit_ratio{cache=\"introspection\"}"}]
    }
  ]
}
