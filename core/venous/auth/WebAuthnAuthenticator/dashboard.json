{
  "title": "WebAuthnAuthenticator — Registrations, Assertions, Counter Regressions",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Registrations (5m)",
      "targets": [{"expr": "sum(rate(webauthn_registrations_total{result=\"ok\"}[5m]))"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Assertions (5m)",
      "targets": [{"expr": "sum(rate(webauthn_assertions_total{result=\"ok\"}[5m]))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Assertion Latency p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(webauthn_assertion_latency_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(webauthn_assertion_latency_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(webauthn_assertion_latency_bucket[5m]))"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Counter Regressions (5m)",
      "targets": [{"expr": "sum(rate(webauthn_counter_regressions_total[5m]))"}]
    }
  ]
}
