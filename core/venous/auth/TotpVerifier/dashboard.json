{
  "title": "TotpVerifier — Accepts, Replays, Rejections",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Accepted (5m)",
      "targets": [{"expr": "sum(rate(totp_verify_total{result=\"accepted\"}[5m]))"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Replay Rejections (5m)",
      "targets": [{"expr": "sum(rate(totp_replay_rejections_total[5m]))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Verify Duration p50/p95/p99 (ms)",
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(totp_verify_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.95, rate(totp_verify_duration_bucket[5m]))"},
        {"expr": "histogram_quantile(0.99, rate(totp_verify_duration_bucket[5m]))"}
      ]
    }
  ]
}
