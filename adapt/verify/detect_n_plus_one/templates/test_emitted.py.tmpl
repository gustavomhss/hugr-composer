"""Emitted test for detect_n_plus_one — asserts the audit infrastructure runs.

Verify-tool semantic per WP-14 §5:
* Positive: query_listener / middleware / decorator modules are importable
  and the ContextVar mechanism increments and resets correctly.
* Negative: simulated execution path exceeding threshold triggers the
  detection logic (warning/exception per mode). This test asserts "the check
  reports", not "the check blocks CI" — the emitted workflow runs pytest
  with a marker filter and does NOT register a required status, so a "blocks
  all N+1 queries" claim would be overclaim.
"""

from __future__ import annotations

import ast
from pathlib import Path

ROOT = Path(__file__).parent.parent
LISTENER = ROOT / "app" / "core" / "query_listener.py"
MIDDLEWARE = ROOT / "app" / "api" / "middleware" / "query_counter.py"
DECORATOR = ROOT / "app" / "core" / "nplusone.py"


def test_listener_exists_and_parses() -> None:
    """Positive: query_listener.py is importable."""
    assert LISTENER.exists()
    src = LISTENER.read_text()
    ast.parse(src)
    assert "query_count" in src
    assert "reset_counters" in src


def test_middleware_exists_and_parses() -> None:
    """Positive: query_counter.py is importable."""
    assert MIDDLEWARE.exists()
    src = MIDDLEWARE.read_text()
    ast.parse(src)
    assert "QueryCounterMiddleware" in src


def test_decorator_exists_and_parses() -> None:
    """Positive: nplusone.py decorator is importable."""
    assert DECORATOR.exists()
    src = DECORATOR.read_text()
    ast.parse(src)
    assert "max_queries" in src


def test_budgets_yaml_present() -> None:
    """Positive: .nplusone-budgets.yaml is committed."""
    assert (ROOT / ".nplusone-budgets.yaml").exists()


def test_counter_increments_and_resets() -> None:
    """Negative: simulating queries exceeds threshold; reset clears state."""
    import sys
    sys.path.insert(0, str(ROOT))
    from app.core.query_listener import query_count, reset_counters

    reset_counters()
    assert query_count.get() == 0
    # Simulate 12 queries (above the default 10 threshold)
    for _ in range(12):
        query_count.set(query_count.get() + 1)
    assert query_count.get() == 12, "12 queries should be counted"
    reset_counters()
    assert query_count.get() == 0
