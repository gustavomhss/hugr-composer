"""Admin-only CRUD endpoints for Tenant management."""

from __future__ import annotations

from fastapi import APIRouter, HTTPException, Query, status
from sqlalchemy.exc import IntegrityError

from app.api.deps import CurrentSuperuser, SessionDep
from app.crud import tenant as crud_tenant
from app.schemas.tenant import TenantCreate, TenantPublic, TenantUpdate

router = APIRouter(prefix="/tenants", tags=["tenants"])


@router.post("/", response_model=TenantPublic, status_code=status.HTTP_201_CREATED)
async def create_tenant(
    tenant_in: TenantCreate,
    session: SessionDep,
    current_user: CurrentSuperuser,
) -> TenantPublic:
    """Create a new tenant. Superuser only.

    Args:
        tenant_in: Validated tenant create payload.
        session: Injected async DB session.
        current_user: Must be a superuser.

    Raises:
        HTTPException: 409 if slug already exists (resolved either by
            the pre-check or by the IntegrityError race-recovery path).
    """
    existing = await crud_tenant.get_by_slug(session, slug=tenant_in.slug)
    if existing:
        raise HTTPException(status_code=409, detail="Tenant slug already exists")
    # F-D: Two concurrent POSTs with the same slug both pass the
    # ``get_by_slug → None`` check and race the INSERT. The DB UNIQUE
    # constraint stops the loser → without this guard the loser surfaces
    # as a 500 + raw "duplicate key" message. Catch IntegrityError,
    # roll back the failed transaction, and return the canonical 409.
    #
    # N-4 (Phase-6 Round-4): narrow the 409 mapping to the slug UNIQUE
    # constraint specifically. A future schema may add other UNIQUE
    # constraints (e.g. ``tenants_name_key``); a blanket
    # ``except IntegrityError → 409 "slug already exists"`` would
    # mis-attribute those failures and confuse the caller. Inspect the
    # DBAPI error message (via ``e.orig``) for the slug-constraint
    # signature; re-raise anything else so the framework surfaces an
    # honest 500.
    try:
        tenant = await crud_tenant.create(session, tenant_in=tenant_in)
    except IntegrityError as e:
        await session.rollback()
        orig_msg = str(getattr(e, "orig", "") or "")
        # Positive markers for the slug UNIQUE constraint across the
        # dialects we support:
        #   PostgreSQL: 'tenants_slug_key' (default constraint name)
        #       or the column reference 'Key (slug)='.
        #   SQLite:    'UNIQUE constraint failed: tenants.slug'.
        slug_markers = ("tenants_slug_key", "tenants.slug", "(slug)")
        # Negative markers — known NON-slug constraints we must NOT
        # mis-label as a slug conflict. If a future schema adds more
        # UNIQUE constraints, extend this tuple (and re-raise) rather
        # than letting the 409 swallow the real diagnosis.
        non_slug_markers = (
            "tenants_name_key",
            "tenants.name",
            "(name)",
            "tenants_pkey",  # PK violation = different bug; surface honestly.
        )
        if any(marker in orig_msg for marker in slug_markers):
            raise HTTPException(status_code=409, detail="Tenant slug already exists") from None
        if any(marker in orig_msg for marker in non_slug_markers):
            # Definitely NOT a slug conflict — re-raise so the framework
            # surfaces an honest 500 with the underlying message rather
            # than a misleading "slug already exists" 409.
            raise
        # Ambiguous origin (bare DBAPI error with no column / constraint
        # name — e.g. some test doubles, or older driver versions).
        # The pre-check above already ruled out a slug collision at
        # read-time; the only schema-issued UNIQUE constraint as of
        # this template is the slug one, so an unattributed UNIQUE
        # failure is overwhelmingly likely to be the race we set out
        # to handle. Treat it as a 409 conservatively. When the schema
        # grows new UNIQUE constraints, add their markers to
        # ``non_slug_markers`` above.
        raise HTTPException(status_code=409, detail="Tenant slug already exists") from None
    return TenantPublic.model_validate(tenant)


@router.get("/", response_model=list[TenantPublic])
async def list_tenants(
    session: SessionDep,
    current_user: CurrentSuperuser,
    skip: int = Query(default=0, ge=0),
    limit: int = Query(default=20, ge=1, le=100),
) -> list[TenantPublic]:
    """List all tenants. Superuser only.

    Args:
        session: Injected async DB session.
        current_user: Must be a superuser.
        skip: Pagination offset.
        limit: Page size (1-100).
    """
    tenants = await crud_tenant.list_tenants(session, skip=skip, limit=limit)
    return [TenantPublic.model_validate(t) for t in tenants]


@router.get("/{slug}", response_model=TenantPublic)
async def get_tenant(
    slug: str,
    session: SessionDep,
    current_user: CurrentSuperuser,
) -> TenantPublic:
    """Fetch a tenant by slug. Superuser only.

    Args:
        slug: URL-safe tenant slug.
        session: Injected async DB session.
        current_user: Must be a superuser.

    Raises:
        HTTPException: 404 if tenant not found.
    """
    tenant = await crud_tenant.get_by_slug(session, slug=slug)
    if tenant is None:
        raise HTTPException(status_code=404, detail="Tenant not found")
    return TenantPublic.model_validate(tenant)


@router.patch("/{slug}", response_model=TenantPublic)
async def update_tenant(
    slug: str,
    tenant_in: TenantUpdate,
    session: SessionDep,
    current_user: CurrentSuperuser,
) -> TenantPublic:
    """Update a tenant by slug. Superuser only.

    Args:
        slug: URL-safe tenant slug.
        tenant_in: Validated partial update payload.
        session: Injected async DB session.
        current_user: Must be a superuser.

    Raises:
        HTTPException: 404 if tenant not found.
    """
    tenant = await crud_tenant.get_by_slug(session, slug=slug)
    if tenant is None:
        raise HTTPException(status_code=404, detail="Tenant not found")
    tenant = await crud_tenant.update(session, tenant=tenant, tenant_in=tenant_in)
    return TenantPublic.model_validate(tenant)
