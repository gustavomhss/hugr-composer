"""Global tenant query filter via SQLAlchemy session event.

Import this module once at application startup (main.py) to activate
the filter.  Every ORM-issued SELECT, UPDATE, and DELETE against a
TenantScopedMixin model will automatically receive a
``WHERE tenant_id = :current_tenant_id`` predicate unless the execution
option ``skip_tenant_filter=True`` is set.

RAW-TEXT ESCAPE HATCH (limitation)
----------------------------------
The listener registers against the ORM ``do_orm_execute`` event, which
only fires for ORM-issued constructs (``select(Model)``,
``update(Model)``, ``delete(Model)``, and ORM unit-of-work flushes).
Raw textual SQL issued via ``session.execute(text("UPDATE ..."))`` is
dispatched at the Core/engine layer and BYPASSES this listener — the
filter has no opportunity to inject ``WHERE tenant_id = …``. If your
project has paths that issue raw text() against tenant-scoped tables,
register an additional Core-level listener on the ``before_execute``
engine event to cover that surface as well.

FAIL-CLOSED CONTRACT
--------------------
If no tenant is present in the request context, a tenant-scoped
statement matches ZERO rows — it does NOT skip the filter. Skipping
would FAIL OPEN and leak (or mutate) every tenant's data on a
context-less query. The ONLY escape hatch is the explicit
``skip_tenant_filter=True`` execution option, reserved for trusted
admin/system paths (e.g. listing tenants).

CROSS-TENANT WRITE GUARD (F-A)
------------------------------
``with_loader_criteria`` covers ORM-style SELECTs but does NOT apply to
SQLAlchemy Core ``update()`` / ``delete()`` constructs (which the
``add_bulk_operations`` tool emits as
``_sql_update(Model).where(Model.id == row_id)``). Without the
Core-level guard below, a caller in tenant A could UPDATE or DELETE a
row owned by tenant B by guessing the row's UUID — the SELECT-only
filter is bypassed entirely.

The fix is to also intercept ``is_update`` / ``is_delete`` execute
states and rewrite the statement's WHERE clause programmatically with
``stmt.where(table.c.tenant_id == tenant_id)`` (or an always-false
predicate when no tenant context is set).

Example::

    # main.py — side-effect import (no symbol needed)
    import app.core.tenant_filter  # noqa: F401
"""

from sqlalchemy import event, false
from sqlalchemy.orm import Session, with_loader_criteria

from app.core.tenant_context import get_current_tenant
from app.models.mixins import TenantScopedMixin


def _tenant_scoped_table(stmt):
    """Return the bound Table if the Core stmt targets a TenantScopedMixin model.

    Args:
        stmt: SQLAlchemy Core update()/delete() construct.

    Returns:
        The mapped ``Table`` object when the stmt targets a tenant-scoped
        model, otherwise ``None``. Falls back to checking for a
        ``tenant_id`` column when the mapper lookup fails (some
        emitted code references the Core Table directly rather than the
        ORM class).
    """
    from sqlalchemy import inspect as _sa_inspect

    # Modern SQLAlchemy 2.x: ``UpdateBase.entity_description`` exposes the
    # ORM entity for Core update/delete constructs created via
    # ``update(Model)``. Older form: walk ``stmt.table``.
    table = getattr(stmt, "table", None)
    if table is None:
        return None
    # ORM mapped class lookup
    try:
        for mapper in _sa_inspect(TenantScopedMixin, raiseerr=False).mappers:  # type: ignore[union-attr]
            if mapper.local_table is table:
                return table
    except Exception:  # noqa: BLE001 — defensive: any inspect failure → fall through
        pass
    # Fallback: any table that carries a ``tenant_id`` column is treated
    # as tenant-scoped (matches what add_multi_tenancy emits on every
    # business model).
    if "tenant_id" in getattr(table, "c", {}):
        return table
    return None


@event.listens_for(Session, "do_orm_execute")
def _enforce_tenant_filter(execute_state) -> None:
    """Inject WHERE tenant_id = current_tenant on every SELECT/UPDATE/DELETE.

    Args:
        execute_state: SQLAlchemy ORM execute state object.

    Skip by passing execution option ``skip_tenant_filter=True``::

        stmt = select(Item).execution_options(skip_tenant_filter=True)
    """
    if execute_state.execution_options.get("skip_tenant_filter"):
        return

    tenant_id = get_current_tenant()

    if execute_state.is_select:
        if tenant_id is None:
            # FAIL CLOSED: no tenant context -> a tenant-scoped query must
            # return nothing rather than every tenant's rows. We inject an
            # always-false predicate (not a no-op return).
            execute_state.statement = execute_state.statement.options(
                with_loader_criteria(
                    TenantScopedMixin,
                    lambda cls: false(),
                    include_aliases=True,
                )
            )
            return
        execute_state.statement = execute_state.statement.options(
            with_loader_criteria(
                TenantScopedMixin,
                lambda cls: cls.tenant_id == tenant_id,
                include_aliases=True,
            )
        )
        return

    # F-A: Core UPDATE / DELETE constructs bypass with_loader_criteria.
    # Rewrite the statement to append a tenant_id predicate (or an
    # always-false predicate when no tenant context is set).
    if execute_state.is_update or execute_state.is_delete:
        stmt = execute_state.statement
        table = _tenant_scoped_table(stmt)
        if table is None:
            # Not a tenant-scoped model — nothing to enforce.
            return
        if tenant_id is None:
            # FAIL CLOSED: zero-row match prevents context-less writes
            # from touching any tenant's data.
            execute_state.statement = stmt.where(false())
            return
        execute_state.statement = stmt.where(table.c.tenant_id == tenant_id)
        return


@event.listens_for(Session, "before_flush")
def _auto_populate_tenant_id(session, flush_context, instances) -> None:
    """Auto-populate tenant_id on INSERT for every TenantScopedMixin row.

    The CRUD code typically does ``session.add(Model(**data))`` without
    an explicit tenant_id; the middleware has already set the
    current_tenant_id ContextVar, so we inject it here right before the
    flush hits the database. This means route handlers NEVER need to
    pass tenant_id — the framework does it invisibly.

    Skipped when there is no current tenant (e.g. system/background job)
    or when the caller explicitly set tenant_id already.
    """
    tenant_id = get_current_tenant()
    if tenant_id is None:
        return
    for obj in session.new:
        if isinstance(obj, TenantScopedMixin) and getattr(obj, "tenant_id", None) is None:
            obj.tenant_id = tenant_id
