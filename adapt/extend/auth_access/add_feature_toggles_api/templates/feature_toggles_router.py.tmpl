"""Feature toggles REST API (prefix ``/feature-toggles``).

Generated by ``add_feature_toggles_api`` and registered in
``app/routes/__init__.py`` so it is mounted under ``{API_V1_STR}/feature-toggles``.

Provides runtime CRUD over feature toggles plus a context-aware ``evaluate``
endpoint. Toggles are held in a process-wide registry attached to
``app.state.feature_toggle_store`` (created lazily on first use), so the API is
self-contained and does not require a database table.

Endpoints (all require an authenticated user; mutations require a superuser):

    GET    /feature-toggles/                 → list all toggles
    POST   /feature-toggles/                 → create a toggle (superuser)
    GET    /feature-toggles/{name}           → fetch one toggle
    PATCH  /feature-toggles/{name}           → update a toggle (superuser)
    DELETE /feature-toggles/{name}           → delete a toggle (superuser)
    POST   /feature-toggles/{name}/evaluate  → evaluate the toggle for a context

Evaluation semantics (off-by-default; FT-INV-02):

* unknown toggle → ``enabled: false``
* ``enabled`` flag false → ``enabled: false``
* ``environments`` set and request environment not in it → ``enabled: false``
* ``allowed_users`` set and principal in it → ``enabled: true`` (allow-list win)
* otherwise gated by ``rollout_percentage`` via a stable hash of (name, subject)
"""

from __future__ import annotations

import hashlib
import threading
from typing import Any

from app.api.deps import CurrentSuperuser, CurrentUser
from fastapi import APIRouter, HTTPException
from pydantic import BaseModel, Field, field_validator

router = APIRouter(prefix="/feature-toggles", tags=["feature-toggles"])


# ---------------------------------------------------------------------------
# In-memory store (process-wide). Off-by-default; thread-safe.
# ---------------------------------------------------------------------------
class _ToggleStore:
    def __init__(self) -> None:
        self._toggles: dict[str, dict[str, Any]] = {}
        self._lock = threading.Lock()

    def list(self) -> list[dict[str, Any]]:
        with self._lock:
            return [dict(t) for t in self._toggles.values()]

    def get(self, name: str) -> dict[str, Any] | None:
        with self._lock:
            t = self._toggles.get(name)
            return dict(t) if t is not None else None

    def put(self, name: str, data: dict[str, Any]) -> None:
        with self._lock:
            self._toggles[name] = dict(data)

    def delete(self, name: str) -> bool:
        with self._lock:
            return self._toggles.pop(name, None) is not None


_STORE = _ToggleStore()


# ---------------------------------------------------------------------------
# Schemas
# ---------------------------------------------------------------------------
class ToggleCreate(BaseModel):
    name: str = Field(min_length=1, max_length=128)
    enabled: bool = False
    rollout_percentage: int = Field(default=0, ge=0, le=100)
    allowed_users: list[str] = Field(default_factory=list)
    environments: list[str] = Field(default_factory=list)

    @field_validator("name")
    @classmethod
    def _strip_name(cls, v: str) -> str:
        v = v.strip()
        if not v:
            raise ValueError("name must not be blank")
        return v


class ToggleUpdate(BaseModel):
    enabled: bool | None = None
    rollout_percentage: int | None = Field(default=None, ge=0, le=100)
    allowed_users: list[str] | None = None
    environments: list[str] | None = None


class TogglePublic(BaseModel):
    name: str
    enabled: bool
    rollout_percentage: int
    allowed_users: list[str]
    environments: list[str]


class EvaluateRequest(BaseModel):
    context: dict[str, Any] = Field(default_factory=dict)


class EvaluateResponse(BaseModel):
    name: str
    enabled: bool
    reason: str


# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------
def _stable_bucket(name: str, subject: str) -> int:
    """Deterministic 0-99 bucket for (toggle, subject) — pure, no randomness."""
    digest = hashlib.sha256(f"{name}:{subject}".encode()).hexdigest()
    return int(digest[:8], 16) % 100


def _evaluate(toggle: dict[str, Any], context: dict[str, Any]) -> tuple[bool, str]:
    if not toggle.get("enabled", False):
        return False, "toggle_disabled"

    environments = toggle.get("environments") or []
    env = str(context.get("environment", "")) if context else ""
    if environments and env not in environments:
        return False, "environment_not_allowed"

    allowed_users = toggle.get("allowed_users") or []
    subject = str(context.get("user", context.get("subject", ""))) if context else ""
    if allowed_users and subject in allowed_users:
        return True, "allow_list"

    rollout = int(toggle.get("rollout_percentage", 0))
    if rollout >= 100:
        return True, "full_rollout"
    if rollout <= 0:
        return False, "zero_rollout"
    if subject and _stable_bucket(toggle["name"], subject) < rollout:
        return True, "rollout_bucket"
    return False, "rollout_excluded"


# ---------------------------------------------------------------------------
# Routes
# ---------------------------------------------------------------------------
@router.get("/", summary="List feature toggles", response_model=list[TogglePublic])
async def list_toggles(_user: CurrentUser) -> list[dict[str, Any]]:
    return _STORE.list()


@router.post(
    "/",
    summary="Create a feature toggle",
    response_model=TogglePublic,
    status_code=201,
)
async def create_toggle(payload: ToggleCreate, _admin: CurrentSuperuser) -> dict[str, Any]:
    if _STORE.get(payload.name) is not None:
        raise HTTPException(status_code=409, detail=f"toggle '{payload.name}' already exists")
    data = payload.model_dump()
    _STORE.put(payload.name, data)
    return data


@router.get("/{name}", summary="Get a feature toggle", response_model=TogglePublic)
async def get_toggle(name: str, _user: CurrentUser) -> dict[str, Any]:
    toggle = _STORE.get(name)
    if toggle is None:
        raise HTTPException(status_code=404, detail=f"toggle '{name}' not found")
    return toggle


@router.patch("/{name}", summary="Update a feature toggle", response_model=TogglePublic)
async def update_toggle(
    name: str, payload: ToggleUpdate, _admin: CurrentSuperuser
) -> dict[str, Any]:
    toggle = _STORE.get(name)
    if toggle is None:
        raise HTTPException(status_code=404, detail=f"toggle '{name}' not found")
    updates = payload.model_dump(exclude_none=True)
    toggle.update(updates)
    _STORE.put(name, toggle)
    return toggle


@router.delete("/{name}", summary="Delete a feature toggle", status_code=204, response_model=None)
async def delete_toggle(name: str, _admin: CurrentSuperuser) -> None:
    if not _STORE.delete(name):
        raise HTTPException(status_code=404, detail=f"toggle '{name}' not found")


@router.post(
    "/{name}/evaluate",
    summary="Evaluate a feature toggle for a context",
    response_model=EvaluateResponse,
)
async def evaluate_toggle(
    name: str, payload: EvaluateRequest, _user: CurrentUser
) -> dict[str, Any]:
    toggle = _STORE.get(name)
    if toggle is None:
        # FT-INV-02: unknown toggle is off-by-default, not an error.
        return {"name": name, "enabled": False, "reason": "unknown_toggle"}
    enabled, reason = _evaluate(toggle, payload.context)
    return {"name": name, "enabled": enabled, "reason": reason}
