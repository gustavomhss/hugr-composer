"""RBAC router — role-protected reference endpoints (prefix ``/rbac``).

Generated by add_rbac and registered in ``app/routes/__init__.py`` so it is
mounted under ``{API_V1_STR}/rbac``. These endpoints are GUARDED by
``require_roles(...)`` wired through the project's ``get_current_user``
dependency, so they demonstrate a working RBAC check end-to-end:

    GET /rbac/admin-only  → 401 (no token) / 403 (non-admin) / 200 (admin)
    GET /rbac/me          → 401 (no token) / 200 (any authenticated user)

⚠ RBAC IS NOT ENFORCED on YOUR OWN routes until you add
  Depends(require_roles(...)) to each route you want to protect. This router
  only guards its own reference endpoints — see app/api/routes/_rbac_example.py
  for the copy-paste pattern.
"""

from __future__ import annotations

from fastapi import APIRouter, Depends

from app.rbac import CurrentPrincipal, require_roles

router = APIRouter(prefix="/rbac", tags=["rbac"])


@router.get(
    "/admin-only",
    summary="[RBAC] Admin-only reference endpoint",
    dependencies=[Depends(require_roles("admin"))],
)
async def rbac_admin_only() -> dict:
    """Admitted only for principals carrying the ``admin`` role."""
    return {"message": "admin access granted — RBAC is working"}


@router.get(
    "/me",
    summary="[RBAC] Current principal (any authenticated user)",
)
async def rbac_me(
    principal: CurrentPrincipal = Depends(require_roles("user", "admin")),
) -> dict:
    """Return the calling principal's subject + roles."""
    return {"subject": principal.subject, "roles": sorted(principal.roles)}
