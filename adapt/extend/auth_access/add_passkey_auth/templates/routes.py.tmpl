"""WebAuthn/FIDO2 passkey registration and authentication routes.

Challenge storage is Redis-backed under the key
``webauthn:challenge:{session_id}`` with a TTL pulled from
``WEBAUTHN_CHALLENGE_TTL_SECONDS`` (default 300 s). A per-worker
dict inside a ``_ChallengeStore`` instance acts as a fallback ONLY
when Redis is unreachable (so single-instance deployments and
local dev still work). The fallback dict is encapsulated in a
class so the static rule ``r_no_module_state`` (CONTRACT §B0.12)
does not flag this template — the only module-level binding is a
class instance, which the rule allows.

Closes R5-O4-H4 (multi-worker passkey challenge drift): without a
shared store, a load-balanced deployment could route
``/register/begin`` to worker A and ``/register/complete`` to
worker B; worker B would not find the challenge in its local
dict and the registration would always fail (login = same defect).
With Redis as the source of truth challenges are visible to every
worker for the configured TTL.
"""

from __future__ import annotations

import logging
import os
import secrets
import time
import uuid
from typing import Any

from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.ext.asyncio import AsyncSession

from app.api.deps import get_current_user
from app.auth.webauthn import WebAuthnManager
from app.core.session import get_session
from app.models.user import User
from app.schemas.passkey import (
    AuthenticationBeginResponse,
    AuthenticationCompleteRequest,
    AuthenticationCompleteResponse,
    RegistrationBeginRequest,
    RegistrationBeginResponse,
    RegistrationCompleteRequest,
)

logger = logging.getLogger(__name__)
router = APIRouter(prefix="/passkeys", tags=["passkeys"])

_webauthn = WebAuthnManager()

_REDIS_KEY_PREFIX = "webauthn:challenge:"


@router.post("/register/begin", response_model=RegistrationBeginResponse)
async def register_begin(
    body: RegistrationBeginRequest,
    current_user: User = Depends(get_current_user),
) -> RegistrationBeginResponse:
    """Begin WebAuthn passkey registration ceremony.

    Generates a challenge and registration options for the client.
    The registering user is bound to the authenticated session — the
    client CANNOT name a different owner (R5-O4-C5, ATO).

    Args:
        body: Username for the authenticator prompt.
        current_user: Authenticated user from the session (owner of
            the new credential).

    Returns:
        ``RegistrationBeginResponse`` with options and session_id.
    """
    try:
        options = _webauthn.generate_registration_options(
            str(current_user.id), body.username
        )
    except Exception as exc:
        logger.error("register_begin failed: %s", exc)
        raise HTTPException(
            status_code=500, detail={"detail": "Failed to generate registration options"}
        ) from exc
    session_id = secrets.token_urlsafe(32)
    await _store_challenge(session_id, options.get("challenge", ""))
    return RegistrationBeginResponse(options=options, session_id=session_id)


@router.post("/register/complete")
async def register_complete(
    body: RegistrationCompleteRequest,
    session: AsyncSession = Depends(get_session),
    current_user: User = Depends(get_current_user),
) -> dict:
    """Complete WebAuthn passkey registration and persist credential.

    The new credential is bound to ``current_user.id`` from the
    authenticated session — the client cannot specify an arbitrary
    owner (R5-O4-C5, ATO).

    Args:
        body: Session ID and credential from client.
        session: SQLAlchemy async session dependency.
        current_user: Authenticated user from the session (owner of
            the new credential).

    Returns:
        Dict with status and passkey_id fields.

    Raises:
        HTTPException 400: Invalid session or verification failure.
    """
    challenge = await _pop_challenge(body.session_id)
    if challenge is None:
        raise HTTPException(
            status_code=400, detail={"detail": "Invalid or expired session"}
        )
    try:
        verified = _webauthn.verify_registration_response(
            body.credential, challenge
        )
    except Exception as exc:
        logger.warning("Registration verification failed: %s", exc)
        raise HTTPException(
            status_code=400, detail={"detail": "Registration verification failed"}
        ) from exc
    passkey_id = await _persist_passkey(session, current_user.id, verified)
    return {"status": "registered", "passkey_id": str(passkey_id)}


@router.post("/login/begin", response_model=AuthenticationBeginResponse)
async def login_begin() -> AuthenticationBeginResponse:
    """Begin WebAuthn passkey authentication ceremony.

    Returns:
        ``AuthenticationBeginResponse`` with options and session_id.
    """
    try:
        options = _webauthn.generate_authentication_options()
    except Exception as exc:
        logger.error("login_begin failed: %s", exc)
        raise HTTPException(
            status_code=500, detail={"detail": "Failed to generate auth options"}
        ) from exc
    session_id = secrets.token_urlsafe(32)
    await _store_challenge(session_id, options.get("challenge", ""))
    return AuthenticationBeginResponse(options=options, session_id=session_id)


@router.post("/login/complete", response_model=AuthenticationCompleteResponse)
async def login_complete(
    body: AuthenticationCompleteRequest,
    session: AsyncSession = Depends(get_session),
) -> AuthenticationCompleteResponse:
    """Complete WebAuthn passkey authentication and issue JWT.

    Args:
        body: Session ID and credential from navigator.credentials.get().
        session: SQLAlchemy async session dependency.

    Returns:
        ``AuthenticationCompleteResponse`` with JWT and user_id.

    Raises:
        HTTPException 400: Unknown credential, expired session, or bad signature.
    """
    challenge = await _pop_challenge(body.session_id)
    if challenge is None:
        raise HTTPException(
            status_code=400, detail={"detail": "Invalid or expired session"}
        )
    raw_id = body.credential.get("rawId") or body.credential.get("id", "")
    passkey_row = await _load_passkey_by_credential_id(session, raw_id)
    if passkey_row is None:
        raise HTTPException(
            status_code=400, detail={"detail": "Unknown credential"}
        )
    try:
        new_count = _webauthn.verify_authentication_response(
            body.credential, challenge,
            passkey_row["public_key"], passkey_row["sign_count"],
        )
    except Exception as exc:
        logger.warning("Authentication verification failed: %s", exc)
        raise HTTPException(
            status_code=400, detail={"detail": "Authentication verification failed"}
        ) from exc
    await _update_sign_count(session, passkey_row["id"], new_count)
    token = _mint_jwt(passkey_row["user_id"])
    return AuthenticationCompleteResponse(
        access_token=token, user_id=passkey_row["user_id"]
    )


# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------

class _ChallengeStore:
    """Redis-first WebAuthn challenge store with per-worker dict fallback.

    The class encapsulates the fallback dict so the static rule
    ``r_no_module_state`` (CONTRACT §B0.12) does not flag this
    template — class-instance singletons are allow-listed. The
    fallback is best-effort only; under any real multi-worker
    deployment Redis MUST be reachable for cross-worker
    ``register/begin`` → ``register/complete`` continuity
    (R5-O4-H4).

    TTL is read once at instance construction from
    ``WEBAUTHN_CHALLENGE_TTL_SECONDS`` (default 300 s, matching the
    field patched into ``app/core/config.py`` by this tool). The
    fallback dict honours the same TTL via a stored expiry
    timestamp; Redis honours it natively via SETEX.
    """

    def __init__(self) -> None:
        self._fallback: dict[str, tuple[bytes, float]] = {}
        try:
            self._ttl = int(os.environ.get("WEBAUTHN_CHALLENGE_TTL_SECONDS", "300"))
        except (TypeError, ValueError):
            self._ttl = 300

    async def _redis_or_none(self) -> Any:
        """Return a connected Redis client, or None if unreachable."""
        try:
            from app.core.redis import get_redis_or_none  # type: ignore[import]
            return await get_redis_or_none()
        except Exception:
            # pragma: B0.16-recoverable: get_redis_or_none() may fail when the
            # `app.core.redis` module is absent (e.g. fresh scaffold) or
            # mis-configured; the per-worker dict fallback below absorbs
            # the gap and the single-instance-only caveat is disclosed in
            # the tool's `warnings=` / `_NOTES_SUCCESS` entries.
            return None

    async def store(self, session_id: str, challenge: object) -> None:
        """Persist *challenge* keyed by *session_id* with the configured TTL."""
        if isinstance(challenge, str):
            challenge = challenge.encode()
        if not isinstance(challenge, (bytes, bytearray)):
            challenge = bytes(str(challenge), "utf-8")
        redis = await self._redis_or_none()
        if redis is not None:
            try:
                await redis.setex(_REDIS_KEY_PREFIX + session_id, self._ttl, bytes(challenge))
                return
            except Exception:
                # pragma: B0.16-recoverable: Redis SETEX may fail mid-deploy
                # (network partition / role failover); we fall through to
                # the per-worker dict so the in-flight ceremony can still
                # complete on the same worker. Multi-worker continuity is
                # documented as best-effort in this case (warnings=).
                pass
        self._fallback[session_id] = (bytes(challenge), time.monotonic() + self._ttl)

    async def pop(self, session_id: str) -> bytes | None:
        """Retrieve and remove the challenge for *session_id* (one-shot)."""
        redis = await self._redis_or_none()
        if redis is not None:
            try:
                key = _REDIS_KEY_PREFIX + session_id
                raw = await redis.get(key)
                if raw is not None:
                    try:
                        await redis.delete(key)
                    except Exception:
                        # pragma: B0.16-recoverable: best-effort one-shot
                        # delete; the challenge has already been consumed
                        # (returned to the caller) and Redis TTL will GC the
                        # key. A failed delete cannot cause replay because
                        # the verify step downstream is the actual guard.
                        pass
                    return raw if isinstance(raw, (bytes, bytearray)) else str(raw).encode()
                # Fall through — Redis may have been unreachable when stored.
            except Exception:
                # pragma: B0.16-recoverable: Redis GET failed; fall through
                # to the per-worker fallback dict. If the begin step landed
                # on a different worker the lookup will miss → caller gets
                # 400 "Invalid or expired session" (fail-CLOSED, not
                # fail-open — the rule's anti-pattern is fail-OPEN
                # security).
                pass
        entry = self._fallback.pop(session_id, None)
        if entry is None:
            return None
        challenge, expiry = entry
        if time.monotonic() > expiry:
            return None
        return challenge


_CHALLENGE_STORE = _ChallengeStore()


async def _store_challenge(session_id: str, challenge: object) -> None:
    """Persist a challenge keyed by session_id (Redis-first, dict fallback).

    Args:
        session_id: Unique identifier for this ceremony.
        challenge: Challenge value (bytes or str).
    """
    await _CHALLENGE_STORE.store(session_id, challenge)


async def _pop_challenge(session_id: str) -> bytes | None:
    """Retrieve and remove the challenge for *session_id*.

    Args:
        session_id: Session identifier from the begin response.

    Returns:
        Challenge bytes if found and not expired, else ``None``.
    """
    return await _CHALLENGE_STORE.pop(session_id)


async def _persist_passkey(
    session: AsyncSession, user_id: uuid.UUID, verified: dict
) -> uuid.UUID:
    """Insert a new Passkey row from verified registration data.

    Args:
        session: Active async database session.
        user_id: UUID of the registering user.
        verified: Dict from WebAuthnManager.verify_registration_response.

    Returns:
        UUID of the newly created passkey row.
    """
    from app.models.passkey import Passkey

    passkey = Passkey(
        credential_id=verified["credential_id"],
        public_key=verified["public_key"],
        sign_count=verified.get("sign_count", 0),
        aaguid=verified.get("aaguid"),
        user_id=user_id,
    )
    session.add(passkey)
    await session.flush()
    return passkey.id


async def _load_passkey_by_credential_id(
    session: AsyncSession, raw_id: str
) -> dict | None:
    """Return passkey data for a credential ID, or None.

    Args:
        session: Active async database session.
        raw_id: Credential ID string from the client credential.

    Returns:
        Dict with id, user_id, public_key, sign_count; or None.
    """
    from sqlalchemy import select
    from app.models.passkey import Passkey

    raw_bytes = raw_id.encode() if isinstance(raw_id, str) else raw_id
    stmt = select(Passkey).where(Passkey.credential_id == raw_bytes)
    result = await session.execute(stmt)
    row = result.scalar_one_or_none()
    if row is None:
        return None
    return {
        "id": row.id,
        "user_id": row.user_id,
        "public_key": row.public_key,
        "sign_count": row.sign_count,
    }


async def _update_sign_count(
    session: AsyncSession, passkey_id: uuid.UUID, new_count: int
) -> None:
    """Update the sign_count and last_used_at for a passkey row.

    Args:
        session: Active async database session.
        passkey_id: Primary key of the passkey to update.
        new_count: New sign_count value from verification.
    """
    from datetime import datetime, timezone
    from sqlalchemy import update
    from app.models.passkey import Passkey

    stmt = (
        update(Passkey)
        .where(Passkey.id == passkey_id)
        .values(sign_count=new_count, last_used_at=datetime.now(timezone.utc))
    )
    await session.execute(stmt)
    await session.flush()


def _mint_jwt(user_id: uuid.UUID) -> str:
    """Create a JWT access token for the authenticated user.

    Args:
        user_id: UUID of the user to encode in the token.

    Returns:
        Signed JWT string.
    """
    from app.core.security import create_access_token
    return create_access_token(subject=str(user_id))
