"""Pydantic schemas for WebAuthn/FIDO2 passkey endpoints."""

from __future__ import annotations

import uuid
from typing import Any

from pydantic import BaseModel, ConfigDict


class PasskeyRead(BaseModel):
    """Public view of a stored passkey credential.

    Attributes:
        id: Primary key UUID.
        aaguid: Authenticator model identifier (may be None).
    """

    model_config = ConfigDict(from_attributes=True)

    id: uuid.UUID
    aaguid: str | None


class RegistrationBeginRequest(BaseModel):
    """Request body for beginning passkey registration.

    The registering user is taken from the authenticated session
    (``Depends(get_current_user)``) — NEVER from the request body —
    so an attacker cannot pin the new credential to a victim's
    account by submitting the victim's UUID (R5-O4-C5, ATO).

    ``extra="forbid"`` blocks mass-assignment / key smuggling: a
    request body that adds e.g. ``user_id`` or ``is_admin`` fields
    is rejected at parse time rather than silently ignored
    (R6-O3-P2 / CONTRACT §B0.14).

    Attributes:
        username: Display name shown in the authenticator prompt.
    """

    model_config = ConfigDict(extra="forbid")

    username: str


class RegistrationBeginResponse(BaseModel):
    """Response containing WebAuthn registration options.

    Attributes:
        options: py_webauthn registration options as a JSON-serializable dict.
        session_id: Opaque session identifier for the challenge.
    """

    options: dict[str, Any]
    session_id: str


class RegistrationCompleteRequest(BaseModel):
    """Request body for completing passkey registration.

    The credential is bound to the authenticated user
    (``Depends(get_current_user)``) server-side — the client cannot
    name a different owner (R5-O4-C5, ATO).

    ``extra="forbid"`` blocks key smuggling at the outer envelope
    (R6-O3-P2 / CONTRACT §B0.14). The ``credential`` field itself
    is intentionally left as a free-form mapping at the Pydantic
    boundary — its shape is the full WebAuthn
    ``PublicKeyCredential`` JSON (``id``, ``rawId``, ``type``,
    ``response.{clientDataJSON,attestationObject}``,
    ``clientExtensionResults`` …) and is validated downstream by
    ``py_webauthn.RegistrationCredential.parse_raw`` /
    ``verify_registration_response``, which enforce the WebAuthn
    spec end-to-end (signature, attestation, RP-ID hash, origin,
    challenge match, user-verification flag). A second
    Pydantic-side schema would duplicate ~150 LOC of spec-tracking
    that py_webauthn already owns and would drift on every
    WebAuthn-Level-3 extension. The pragma is the intended bypass
    (see ``r_write_schemas_strict`` module docstring).

    Attributes:
        session_id: Session identifier from the begin response.
        credential: navigator.credentials.create() output.
    """

    model_config = ConfigDict(extra="forbid")

    session_id: str
    credential: dict[str, Any]  # pragma: schema-any: WebAuthn payload validated by py_webauthn (R6-O3-P2)


class AuthenticationBeginResponse(BaseModel):
    """Response containing WebAuthn authentication options.

    Attributes:
        options: py_webauthn authentication options as a JSON-serializable dict.
        session_id: Opaque session identifier for the challenge.
    """

    options: dict[str, Any]
    session_id: str


class AuthenticationCompleteRequest(BaseModel):
    """Request body for completing passkey authentication.

    ``extra="forbid"`` blocks key smuggling at the outer envelope
    (R6-O3-P2 / CONTRACT §B0.14). The ``credential`` field is the
    full WebAuthn ``PublicKeyCredential`` JSON
    (``id``/``rawId``/``response.{clientDataJSON,authenticatorData,
    signature,userHandle}``/``clientExtensionResults``) and is
    validated by ``py_webauthn.AuthenticationCredential.parse_raw``
    + ``verify_authentication_response`` (signature, RP-ID hash,
    origin, challenge, sign-count, UV flag). The pragma is the
    intended bypass for shapes the WebAuthn library already
    enforces end-to-end.

    Attributes:
        session_id: Session identifier from the begin response.
        credential: navigator.credentials.get() output.
    """

    model_config = ConfigDict(extra="forbid")

    session_id: str
    credential: dict[str, Any]  # pragma: schema-any: WebAuthn payload validated by py_webauthn (R6-O3-P2)


class AuthenticationCompleteResponse(BaseModel):
    """Response returned after successful passkey authentication.

    Attributes:
        access_token: JWT access token.
        token_type: Always 'bearer'.
        user_id: UUID of the authenticated user.
    """

    access_token: str
    token_type: str = "bearer"
    user_id: uuid.UUID
