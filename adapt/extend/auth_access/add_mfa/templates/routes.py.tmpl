"""Mounted MFA (TOTP) router — prefix ``/auth/mfa``.

Generated by add_mfa and registered in ``app/routes/__init__.py`` so it is
mounted under ``{API_V1_STR}/auth/mfa``. All endpoints require an
authenticated user.

INV-MFA-03: the login flow issues a short-lived ``pending_token`` carrying
``purpose="mfa_pending"`` when a user with ``mfa_enabled=True`` passes the
password check. That token is ONLY accepted by ``/challenge`` — the normal
``get_current_user`` dependency rejects any token whose purpose is
``mfa_pending``, so a half-authenticated session can never call protected
endpoints. The full access token is issued only after ``/challenge`` accepts
a valid TOTP code.

INV-MFA-05: ``/disable`` requires a fresh TOTP ``code`` — a stolen session
alone cannot turn MFA off.

⚠ MFA IS NOT ENFORCED on login until you wire the pending-token step into
  the login flow (add_mfa patches login.py when it exists; otherwise copy
  app/api/routes/_mfa_example.py) and persist MFA state on the user model.
"""

from __future__ import annotations

import secrets

from fastapi import APIRouter, HTTPException, Request, status
from pydantic import BaseModel

from app.api.deps import CurrentUser
from app.mfa import get_verifier, verify_code

router = APIRouter(prefix="/auth/mfa", tags=["mfa"])

# Purpose claim that marks a half-authenticated, password-verified token.
# get_current_user MUST reject tokens with this purpose (INV-MFA-03).
MFA_PENDING_PURPOSE = "mfa_pending"


class _EnrollResponse(BaseModel):
    secret_hex: str
    note: str


class _VerifyEnrollmentBody(BaseModel):
    secret_hex: str
    code: str


class _ChallengeBody(BaseModel):
    pending_token: str
    code: str
    last_step: int = 0


class _DisableBody(BaseModel):
    code: str
    last_step: int = 0


@router.post("/enroll", response_model=_EnrollResponse)
async def mfa_enroll(current_user: CurrentUser, request: Request) -> _EnrollResponse:
    """Generate a fresh TOTP secret for the current user to enroll.

    The caller persists the (encrypted) secret on the MFADevice row and
    confirms enrollment via ``/verify-enrollment`` before MFA is active.
    """
    secret = secrets.token_bytes(20)
    return _EnrollResponse(
        secret_hex=secret.hex(),
        note="Persist secret_enc (Fernet-encrypted), then call /verify-enrollment.",
    )


@router.post("/verify-enrollment")
async def mfa_verify_enrollment(
    body: _VerifyEnrollmentBody,
    current_user: CurrentUser,
    request: Request,
) -> dict:
    """Verify the first TOTP code to confirm enrollment of a new secret."""
    verifier = get_verifier(request.app)
    try:
        new_step = await verify_code(
            verifier,
            secret=bytes.fromhex(body.secret_hex),
            code=body.code,
            last_step=0,
        )
    except Exception as exc:  # noqa: BLE001 — surface as 401, never 500
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="invalid TOTP code",
        ) from exc
    return {"status": "enrolled", "last_step": new_step}


@router.post("/challenge")
async def mfa_challenge(body: _ChallengeBody, request: Request) -> dict:
    """Exchange a password-verified ``pending_token`` + TOTP code for full auth.

    INV-MFA-03/04: this is the ONLY endpoint that accepts a pending_token.
    The caller supplies the user's stored ``last_step`` and persists the
    returned value to defeat replay. On success the login flow issues the
    real access token.
    """
    secret = _resolve_pending_secret(request, body.pending_token)
    verifier = get_verifier(request.app)
    try:
        new_step = await verify_code(
            verifier,
            secret=secret,
            code=body.code,
            last_step=body.last_step,
        )
    except Exception as exc:  # noqa: BLE001 — surface as 401, never 500
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="invalid or replayed TOTP code",
        ) from exc
    return {"status": "ok", "last_step": new_step}


@router.post("/disable")
async def mfa_disable(
    body: _DisableBody,
    current_user: CurrentUser,
    request: Request,
) -> dict:
    """Disable MFA for the current user — requires a fresh TOTP ``code``.

    INV-MFA-05: a valid current code proves possession of the authenticator,
    so a stolen session token alone cannot disable the second factor.
    """
    secret = getattr(current_user, "totp_secret", None)
    if not secret:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="MFA not enrolled for this user",
        )
    verifier = get_verifier(request.app)
    try:
        await verify_code(
            verifier,
            secret=secret,
            code=body.code,
            last_step=body.last_step,
        )
    except Exception as exc:  # noqa: BLE001 — surface as 401, never 500
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="invalid TOTP code — disable requires a fresh code",
        ) from exc
    return {"status": "disabled", "note": "Clear user MFA state to finalise."}


def _resolve_pending_secret(request: Request, pending_token: str) -> bytes:
    """Validate the mfa_pending token and return the user's TOTP secret.

    This is a wiring seam: replace the body with a real decode of the
    pending_token (verifying purpose == MFA_PENDING_PURPOSE) and a DB lookup
    of the user's decrypted secret. The placeholder fails closed.
    """
    if not pending_token:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="missing pending_token",
        )
    user = getattr(request.state, "mfa_pending_user", None)
    secret = getattr(user, "totp_secret", None) if user is not None else None
    if not secret:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="invalid or expired pending_token",
        )
    return secret
