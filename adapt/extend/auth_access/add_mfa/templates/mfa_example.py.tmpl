from __future__ import annotations

from fastapi import APIRouter, HTTPException, Request
from pydantic import BaseModel

from app.mfa import get_verifier, verify_code

router = APIRouter(prefix="/mfa-example", tags=["mfa-example"])


class _VerifyBody(BaseModel):
    secret_hex: str   # hex-encoded TOTP secret (for testing only — never expose real secrets)
    code: str         # 6-digit TOTP code
    last_step: int = 0


@router.post(
    "/verify",
    summary="[MFA example] Verify a TOTP code (testing endpoint — remove before prod)",
)
async def verify_totp_example(body: _VerifyBody, request: Request) -> dict:
    """Verify a TOTP code using the shipped StandardTotpVerifier.

    Returns the new last_step that you must persist on the user model to
    prevent replay attacks.
    """
    verifier = get_verifier(request.app)
    try:
        new_step = await verify_code(
            verifier,
            secret=bytes.fromhex(body.secret_hex),
            code=body.code,
            last_step=body.last_step,
        )
    except Exception as exc:
        raise HTTPException(status_code=401, detail=f"TOTP verification failed: {exc}") from exc
    return {"status": "ok", "new_last_step": new_step}
