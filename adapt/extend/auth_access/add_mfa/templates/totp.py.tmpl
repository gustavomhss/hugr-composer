"""RFC 6238 TOTP generation + verification (INV-MFA-07).

Verification delegates to ``pyotp``, whose ``TOTP.verify`` compares codes
with ``hmac.compare_digest`` internally — i.e. constant-time, immune to the
timing side-channel that a naive ``==`` comparison would expose.

This module is intentionally framework-agnostic: it takes raw secret bytes
and a code string, and returns the accepted step (for anti-replay
persistence) or ``None``. Replay protection (rejecting an already-used
step) is the caller's responsibility — see ``app/crud/mfa.py``.
"""

from __future__ import annotations

import base64
import secrets
import time

import pyotp

# Standard TOTP parameters (RFC 6238): 30-second step, 6 digits, SHA-1.
STEP_SECONDS = 30
DIGITS = 6


def generate_secret() -> bytes:
    """Generate a fresh 20-byte (160-bit) TOTP shared secret."""
    return secrets.token_bytes(20)


def _b32(secret: bytes) -> str:
    """Encode raw secret bytes as the base32 string pyotp expects."""
    return base64.b32encode(secret).decode("ascii")


def provisioning_uri(secret: bytes, account_name: str, issuer: str) -> str:
    """Build an otpauth:// URI for QR-code enrollment in an authenticator app."""
    return pyotp.TOTP(_b32(secret), digits=DIGITS, interval=STEP_SECONDS).provisioning_uri(
        name=account_name, issuer_name=issuer
    )


def verify(secret: bytes, code: str, *, last_step: int = 0, valid_window: int = 1) -> int | None:
    """Verify a TOTP code in constant time, enforcing anti-replay.

    Args:
        secret: Raw TOTP shared secret bytes.
        code: The user-supplied 6-digit code.
        last_step: The last step counter already accepted for this user.
            Codes at or before this step are rejected (replay protection).
        valid_window: How many adjacent steps to tolerate for clock skew.

    Returns:
        The accepted step counter (persist it as the new ``last_step``), or
        ``None`` when the code is invalid or a replay.
    """
    totp = pyotp.TOTP(_b32(secret), digits=DIGITS, interval=STEP_SECONDS)
    now = int(time.time())
    current_step = now // STEP_SECONDS
    # pyotp.verify uses compare_digest internally (INV-MFA-07).
    if not totp.verify(code, for_time=now, valid_window=valid_window):
        return None
    if current_step <= last_step:
        # Replay: this step (or an earlier one) was already accepted.
        return None
    return current_step
