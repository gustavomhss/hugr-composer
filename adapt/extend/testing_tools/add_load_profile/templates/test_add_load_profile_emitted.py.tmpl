    assert "SmokeShape" in src, "SmokeShape missing"
    assert "BaselineShape" in src, "BaselineShape missing"
    assert "PeakShape" in src, "PeakShape missing"


def test_shapes_ast_parses() -> None:
    """Positive: shapes.py is valid Python."""
    p = _LOAD / "shapes.py"
    try:
        ast.parse(p.read_text())
    except SyntaxError as exc:
        raise AssertionError(f"SyntaxError in shapes.py: {exc}") from exc


def test_slo_exit_code_on_violation() -> None:
    """Negative: slo_assertions.py sets process_exit_code=1 on violation."""
    p = _LOAD / "slo_assertions.py"
    src = p.read_text()
    assert "process_exit_code" in src, "SLO exit code mechanism missing"
    assert "1" in src, "exit code 1 not referenced"
