"""Wiring assertions for add_data_seeder — emitted by the tool.

Asserts that the emitted seeder infrastructure exists at the expected paths,
is importable, and key classes/functions are declared.  Does NOT invoke
the seeder or database as a sub-runner (wiring assertion only).
"""

from __future__ import annotations

import ast
from pathlib import Path

_PROJECT = Path(__file__).parent.parent
_SEEDER = _PROJECT / "app" / "seeder"


def test_seeder_package_exists() -> None:
    """Positive: app/seeder/__init__.py exists at expected path."""
    p = _SEEDER / "__init__.py"
    assert p.exists(), f"app/seeder/__init__.py not found at {p}"


def test_seeder_init_has_data_seeder_class() -> None:
    """Positive: DataSeeder class declared in app/seeder/__init__.py."""
    src = (_SEEDER / "__init__.py").read_text()
    assert "DataSeeder" in src, "DataSeeder class missing"
    assert "async def seed" in src, "seed method missing"
    assert "topological_order" in src or "DependencyGraph" in src, (
        "DependencyGraph usage missing"
    )


def test_seeder_init_ast_parses() -> None:
    """Positive: app/seeder/__init__.py is valid Python."""
    p = _SEEDER / "__init__.py"
    try:
        ast.parse(p.read_text())
    except SyntaxError as exc:
        raise AssertionError(f"SyntaxError in seeder/__init__.py: {exc}") from exc


def test_generators_file_exists() -> None:
    """Positive: app/seeder/generators.py exists and declares FieldGenerator."""
    p = _SEEDER / "generators.py"
    assert p.exists(), "generators.py not found"
    src = p.read_text()
    assert "FieldGenerator" in src, "FieldGenerator missing"
    assert "generate_instance" in src, "generate_instance method missing"


def test_generators_ast_parses() -> None:
    """Positive: app/seeder/generators.py is valid Python."""
    p = _SEEDER / "generators.py"
    try:
        ast.parse(p.read_text())
    except SyntaxError as exc:
        raise AssertionError(f"SyntaxError in generators.py: {exc}") from exc


