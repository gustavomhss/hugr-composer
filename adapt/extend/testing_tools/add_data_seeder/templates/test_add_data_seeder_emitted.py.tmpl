    assert p.exists(), "graph.py not found"
    src = p.read_text()
    assert "DependencyGraph" in src, "DependencyGraph missing"
    assert "topological_order" in src, "topological_order method missing"


def test_graph_ast_parses() -> None:
    """Positive: app/seeder/graph.py is valid Python."""
