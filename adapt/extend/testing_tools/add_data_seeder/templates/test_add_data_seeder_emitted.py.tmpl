def test_seeder_route_exists() -> None:
    """Positive: app/api/routes/seeder.py exists with POST /dev/seed."""
    p = _PROJECT / "app" / "api" / "routes" / "seeder.py"
    assert p.exists(), "seeder route not found"
    src = p.read_text()
    assert "seed_database" in src or "/seed" in src, "seed endpoint missing"


def test_seeder_disabled_in_production() -> None:
    """Negative: seeder route checks SEEDER_ENABLED before seeding."""
    p = _PROJECT / "app" / "api" / "routes" / "seeder.py"
    src = p.read_text()
    assert "SEEDER_ENABLED" in src, "SEEDER_ENABLED guard missing from route"
