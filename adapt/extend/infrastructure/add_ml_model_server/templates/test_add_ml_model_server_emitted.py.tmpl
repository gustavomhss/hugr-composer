"""ML model-server emitted tests — generated by add_ml_model_server.

Positive: ModelRegistry, Predictor, load_model are importable
without torch/sklearn/onnxruntime installed (S2: lazy imports, app
boots on CPU-only host).
Negative (S3 mis-route guard): get() on an unknown model id raises
KeyError — there is NO silent fallback to a default model.
"""

from __future__ import annotations

import ast
import importlib
import sys
from pathlib import Path


_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_registry_importable_without_ml_sdk() -> None:
    """Positive (S2): ModelRegistry imports + works without any ML SDK installed."""
    _ensure_on_path()
    mod = importlib.import_module("app.ml.registry")
    assert hasattr(mod, "ModelRegistry"), "ModelRegistry missing"
    assert hasattr(mod, "get_registry"), "get_registry missing"
    reg = mod.ModelRegistry()
    assert reg.list_models() == [], "fresh registry must be empty"


def test_ml_init_reexports() -> None:
    """Positive: app.ml re-exports ModelRegistry/Predictor/get_registry/load_model."""
    _ensure_on_path()
    mod = importlib.import_module("app.ml")
    for name in ("ModelRegistry", "Predictor", "get_registry", "load_model"):
        assert hasattr(mod, name), f"{name} not re-exported from app.ml"


def test_unknown_model_raises_key_error_not_silent_default() -> None:
    """Negative (S3): registry.get() on unknown id MUST raise KeyError.

    Mis-route guard: the registry must NOT silently fall back to a default
    model when an unknown name is requested.  KeyError surfaces to the
    route layer as HTTP 404.
    """
    _ensure_on_path()
    mod = importlib.import_module("app.ml.registry")
    reg = mod.ModelRegistry()
    import pytest

    with pytest.raises(KeyError):
        reg.get("nonexistent_model", "9.9.9")


def test_ml_sdk_not_at_top_level_in_app_ml() -> None:
    """Negative (S2): torch/onnxruntime/transformers/joblib/sklearn NOT at top-level.

    Lazy imports guarantee the app boots without these SDKs installed.
    A top-level import would crash module loading on a CPU-only host.
    """
    ml_dir = _PROJECT_ROOT / "app" / "ml"
    assert ml_dir.exists(), "app/ml/ missing"
    forbidden_top_level = (
        "torch", "onnxruntime", "transformers", "joblib", "sklearn", "tensorflow",
    )
    violations: list[str] = []
    for py_file in sorted(ml_dir.rglob("*.py")):
        try:
            tree = ast.parse(py_file.read_text())
        except SyntaxError:
            continue
        for node in tree.body:
            if isinstance(node, ast.Import):
                for alias in node.names:
                    root = alias.name.split(".")[0]
                    if root in forbidden_top_level:
                        violations.append(f"{py_file.name}: import {alias.name}")
            elif isinstance(node, ast.ImportFrom) and node.module:
                root = node.module.split(".")[0]
                if root in forbidden_top_level:
                    violations.append(f"{py_file.name}: from {node.module} import ...")
    assert not violations, (
        "ML SDK imported at module top-level (lazy-import contract broken):\n  "
        + "\n  ".join(violations)
    )


def test_torch_load_uses_weights_only() -> None:
    """S1 safety: torch.load in loader.py uses weights_only=True.

    Untrusted torch checkpoints with default ``weights_only=False`` are
    pickle-deserialised — RCE-equivalent.  Enforce safe default.
    """
    loader = _PROJECT_ROOT / "app" / "ml" / "loader.py"
    assert loader.exists()
    text = loader.read_text()
    # Must mention weights_only=True somewhere in the torch.load call
    assert "weights_only=True" in text, (
        "torch.load must use weights_only=True to prevent pickle-deserialisation RCE"
    )
