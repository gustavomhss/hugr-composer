"""Input-sanitization emitted tests — generated by the add_input_sanitization tool.

Positive: InputSanitizer.sanitize_html strips <script> tags via fallback path.
Negative: NoSQLInjection validator rejects $$where; clean input round-trips.
"""

from __future__ import annotations

import sys
from pathlib import Path


def _load(rel: str, name: str):
    import importlib.util

    p = Path(__file__).parent.parent / rel
    spec = importlib.util.spec_from_file_location(name, p)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    return mod


def test_sanitizer_files_present() -> None:
    """Positive: every sanitization module is emitted."""
    app = Path(__file__).parent.parent / "app"
    for rel in (
        "security/sanitizer.py",
        "security/sanitize_middleware.py",
        "security/validators.py",
    ):
        assert (app / rel).exists(), f"missing sanitizer file: {rel}"


def test_sanitize_html_strips_script() -> None:
    """Positive: sanitize_html removes <script> from a malicious payload.

    Uses the html.escape fallback when bleach is not installed — both
    paths must render the payload inert (no executable <script> tag).
    """
    san = _load("app/security/sanitizer.py", "app.security.sanitizer")
    out = san.InputSanitizer().sanitize_html("<script>alert(1)</script>Hello")
    assert "<script>" not in out, "sanitize_html left <script> intact"
    # Either bleach (drops the tag) or html.escape (escapes it) is acceptable;
    # both render the payload inert.
    assert "alert" not in out or "&lt;script&gt;" in out


def test_strip_tags_removes_tags() -> None:
    """Positive: strip_tags removes a simple <b>...</b> wrapper."""
    san = _load("app/security/sanitizer.py", "app.security.sanitizer")
    assert san.InputSanitizer().strip_tags("<b>bold</b>") == "bold"


def test_nosql_validator_rejects_where() -> None:
    """Negative: the NoSQLInjection validator must reject a $$where payload."""
    # Pre-load sanitizer so validators module can resolve InputSanitizer.
    _load("app/security/sanitizer.py", "app.security.sanitizer")
    val = _load("app/security/validators.py", "app.security.validators")
    import pytest

    with pytest.raises(ValueError):
        val._validate_no_nosql("name=admin&$$where=1")


def test_nosql_validator_accepts_clean_string() -> None:
    """Positive: a clean string passes the NoSQL validator unchanged."""
    _load("app/security/sanitizer.py", "app.security.sanitizer")
    val = _load("app/security/validators.py", "app.security.validators")
    assert val._validate_no_nosql("ordinary user input") == "ordinary user input"
