"""Auto-generated ModelView classes for the SQLAdmin panel.

Each model discovered in ``app/models/__init__.py`` gets a
``ModelView`` subclass (declaring its model via the ``model`` class
attribute) with auto-detected columns for list view, search, and
sort.  Sensitive columns are excluded from the list view and
``can_delete = False`` is set for the User model.

The ``MODEL_ADMINS`` list at the bottom collects all view classes
for registration by ``setup_admin()``.
"""
from __future__ import annotations

try:
    from sqladmin import ModelView
except ImportError:
    # Provide a dummy base so this module can be imported for type
    # checking even when sqladmin is not installed. Real ModelView
    # subclasses pass their SQLAlchemy model as a ``model=`` class
    # keyword argument; the __init_subclass__ override swallows it so
    # the class body can be defined without sqladmin present.
    class ModelView:  # type: ignore[no-redef]
        def __init_subclass__(cls, **kwargs: object) -> None:
            super().__init_subclass__()

