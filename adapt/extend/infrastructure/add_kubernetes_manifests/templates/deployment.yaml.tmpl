# REQUIRED ENDPOINTS: the probes below assume the app exposes THREE health
# endpoints — /healthz (liveness, shallow), /readyz (readiness, deep) and
# /startupz (startup). This tool does NOT generate them. Add them first with
# fastapi_api_generate_health (generators/endpoints/health.py), or a pod will
# never become Ready / will CrashLoop. If your app only exposes /healthz,
# repoint readinessProbe + startupProbe at /healthz before applying.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: APP_NAME
  namespace: ${K8S_NAMESPACE:-production}
  labels:
    app: APP_NAME
spec:
  replicas: ${K8S_REPLICAS:-2}
  selector:
    matchLabels:
      app: APP_NAME
  template:
    metadata:
      labels:
        app: APP_NAME
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
      containers:
        - name: APP_NAME
          image: APP_NAME:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 8000
          envFrom:
            - configMapRef:
                name: APP_NAME-config
            - secretRef:
                name: APP_NAME-secret
          resources:
            requests:
              cpu: "250m"
              memory: "256Mi"
            limits:
              cpu: "${K8S_CPU_LIMIT:-1000m}"
              memory: "${K8S_MEMORY_LIMIT:-512Mi}"
          # Readiness gates traffic: /readyz is the DEEP check (DB reachable,
          # returns 503 when not) so a dependency outage removes the pod from
          # the Service endpoints WITHOUT restarting it (R6-S11-F1).
          readinessProbe:
            httpGet:
              path: /readyz
              port: 8000
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 3
          # Liveness only asks "is the process alive?" — /healthz is the SHALLOW
          # check with no dependency calls, so a transient DB outage never
          # triggers a pod restart loop.
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8000
            initialDelaySeconds: 30
            periodSeconds: 30
            failureThreshold: 3
          # Startup gates liveness/readiness until the app has booted (migrations,
          # warmup): up to 30 * 5s = 150s before liveness may begin killing.
          startupProbe:
            httpGet:
              path: /startupz
              port: 8000
            periodSeconds: 5
            failureThreshold: 30
