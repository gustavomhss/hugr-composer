"""Secret-rotation emitted tests — generated by the add_secret_rotation tool.

Positive: EnvSecretProvider round-trips; rotation preserves the previous value
under <name>_previous for the dual-key window.
Negative: validate_secrets_at_startup raises on weak/empty SECRET_KEY values.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


def _load(rel: str, name: str):
    import importlib.util

    p = Path(__file__).parent.parent / rel
    spec = importlib.util.spec_from_file_location(name, p)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    return mod


def test_secret_rotation_files_present() -> None:
    """Positive: secret rotation core, middleware and CLI are emitted."""
    project = Path(__file__).parent.parent
    assert (project / "app" / "core" / "secret_rotation.py").exists()
    assert (project / "app" / "middleware" / "leak_detector.py").exists()
    assert (project / "scripts" / "rotate_secrets.py").exists()


def test_env_provider_round_trip() -> None:
    """Positive: EnvSecretProvider.get + set round-trip via os.environ."""
    mod = _load("app/core/secret_rotation.py", "app.core.secret_rotation")
    provider = mod.EnvSecretProvider()
    provider.set("ROUND_TRIP_TEST_KEY", "round_trip_value")
    try:
        assert provider.get("ROUND_TRIP_TEST_KEY") == "round_trip_value"
        assert provider.get("MISSING_KEY", default="fallback") == "fallback"
    finally:
        os.environ.pop("ROUND_TRIP_TEST_KEY", None)


def test_rotate_preserves_previous_value() -> None:
    """Positive: rotate() writes <name>_previous before overwriting <name>.

    The dual-key window contract guarantees in-flight requests can still
    validate against the previous secret while the new secret propagates.
    """
    mod = _load("app/core/secret_rotation.py", "app.core.secret_rotation")
    provider = mod.EnvSecretProvider()
    try:
        provider.set("ROTATING_KEY", "v1")
        provider.rotate("ROTATING_KEY", "v2", interval_h=1)
        assert provider.get("ROTATING_KEY") == "v2"
        assert provider.get("ROTATING_KEY_previous") == "v1", (
            "dual-key window broken — previous value not preserved"
        )
    finally:
        os.environ.pop("ROTATING_KEY", None)
        os.environ.pop("ROTATING_KEY_previous", None)


def test_scan_for_leaks_redacts_known_secret() -> None:
    """Positive: scan_for_leaks reports known secrets present in text."""
    mod = _load("app/core/secret_rotation.py", "app.core.secret_rotation")
    found = mod.scan_for_leaks("error: SECRET_VAL_12345 was leaked", ["SECRET_VAL_12345"])
    assert found, "scan_for_leaks failed to flag a known leak"


def test_scan_for_leaks_ignores_short_secrets() -> None:
    """Negative: secrets <= 4 chars are ignored to avoid false-positive noise."""
    mod = _load("app/core/secret_rotation.py", "app.core.secret_rotation")
    assert mod.scan_for_leaks("text containing abc", ["abc"]) == []


def test_startup_validation_rejects_weak_secret() -> None:
    """Negative: validate_secrets_at_startup raises when SECRET_KEY is 'changethis'.

    Honesty rule: startup must REFUSE to boot on weak defaults — silently
    accepting a placeholder secret would ship as a security overclaim.
    """
    mod = _load("app/core/secret_rotation.py", "app.core.secret_rotation")
    prior = os.environ.get("SECRET_KEY")
    os.environ["SECRET_KEY"] = "changethis-please"
    try:
        # We bypass the settings import by monkey-patching get_secret_provider
        # to return EnvSecretProvider directly.
        mod.get_secret_provider = mod.EnvSecretProvider  # type: ignore[attr-defined]
        import pytest

        with pytest.raises(RuntimeError):
            mod.validate_secrets_at_startup()
    finally:
        if prior is None:
            os.environ.pop("SECRET_KEY", None)
        else:
            os.environ["SECRET_KEY"] = prior
