"""Chaos-testing emitted tests — generated by the add_chaos_testing tool.

Positive: ChaosEngine + injectors + middleware are wired.
Negative: production guard physically blocks chaos in production.
"""

from __future__ import annotations

import os
from pathlib import Path


def test_chaos_engine_file_exists() -> None:
    """Positive: app/chaos/__init__.py was written."""
    p = Path(__file__).parent.parent / "app" / "chaos" / "__init__.py"
    assert p.exists(), f"chaos engine module missing at {p}"
    body = p.read_text()
    assert "ChaosEngine" in body, "ChaosEngine class missing"
    assert "get_chaos_engine" in body, "get_chaos_engine factory missing"


