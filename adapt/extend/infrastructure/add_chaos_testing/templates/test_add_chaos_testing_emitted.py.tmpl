def test_production_guard_blocks_enable() -> None:
    """Negative: chaos.enable() in production environment MUST NOT set _enabled.

    The ChaosEngine hardcodes the production guard — flipping
    ENVIRONMENT=production while CHAOS_ENABLED=true must leave the
    engine inert. is_enabled() must return False.
    """
    import importlib.util
    import sys

    p = Path(__file__).parent.parent / "app" / "chaos" / "__init__.py"
    spec = importlib.util.spec_from_file_location("chaos_emitted_test", p)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules["chaos_emitted_test"] = mod
    prior = os.environ.get("ENVIRONMENT")
    os.environ["ENVIRONMENT"] = "production"
    try:
        spec.loader.exec_module(mod)  # type: ignore[union-attr]
        eng = mod.ChaosEngine(latency_ms=100, error_rate=0.5, timeout_rate=0.0)
        eng.enable()
        assert eng.is_enabled() is False, "production guard failed: chaos active in production"
    finally:
        if prior is None:
            os.environ.pop("ENVIRONMENT", None)
        else:
            os.environ["ENVIRONMENT"] = prior
