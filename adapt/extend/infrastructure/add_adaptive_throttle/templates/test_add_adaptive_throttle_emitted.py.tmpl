"""Adaptive-throttle emitted tests — generated by the add_adaptive_throttle tool.

Positive: throttle engine and middleware were created.
Negative: penalty tier logic is correct (tier 0 = no penalty).
"""

from __future__ import annotations

from pathlib import Path


def test_throttle_core_exists() -> None:
    """Positive: app/core/adaptive_throttle.py was written by the tool."""
    core = Path(__file__).parent.parent / "app" / "core" / "adaptive_throttle.py"
    assert core.exists(), f"app/core/adaptive_throttle.py not found at {core}"


def test_throttle_core_has_config() -> None:
    """Positive: throttle core defines AdaptiveThrottleConfig."""
    core = Path(__file__).parent.parent / "app" / "core" / "adaptive_throttle.py"
    body = core.read_text()
    assert "AdaptiveThrottleConfig" in body, "AdaptiveThrottleConfig class missing"
    assert "build_config" in body, "build_config function missing"
    assert "fingerprint_request" in body, "fingerprint_request function missing"


