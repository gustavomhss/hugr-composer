def test_penalty_seconds_zero_for_tier_0() -> None:
    """Negative: tier 0 = no penalty (PENALTY_SECONDS[0] == 0)."""
    import importlib.util
    import sys

    core_path = Path(__file__).parent.parent / "app" / "core" / "adaptive_throttle.py"
    spec = importlib.util.spec_from_file_location("adaptive_throttle_core", core_path)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    # Patch settings before loading
    import types
    fake_settings = types.SimpleNamespace(
        ADAPTIVE_THROTTLE_ENABLED=False,
        ADAPTIVE_THROTTLE_SENSITIVITY=0.8,
        ADAPTIVE_THROTTLE_LEARNING_PERIOD_H=24,
        ADAPTIVE_THROTTLE_BASE_QUOTA=200,
        ADAPTIVE_THROTTLE_PENALTY_ESCALATION=True,
        ADAPTIVE_THROTTLE_TRUSTED_PROXIES="",
        ADAPTIVE_THROTTLE_BEHIND_PROXY=False,
        REDIS_URL="redis://localhost:6379/0",
    )
    fake_app_core = types.ModuleType("app.core.config")
    fake_app_core.settings = fake_settings  # type: ignore[attr-defined]
    sys.modules.setdefault("app", types.ModuleType("app"))
    sys.modules.setdefault("app.core", types.ModuleType("app.core"))
    sys.modules["app.core.config"] = fake_app_core
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    assert mod.penalty_seconds_for_tier(0) == 0
    assert mod.penalty_seconds_for_tier(1) > 0
