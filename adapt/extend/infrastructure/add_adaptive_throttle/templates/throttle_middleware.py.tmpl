"""Adaptive throttle ASGI middleware + Redis-backed penalty tracker.

Penalty state lives in Redis under ``athrottle:penalty:{fingerprint}``
(value = tier, TTL = cooldown seconds). A per-worker dict inside a
``_PenaltyStore`` instance serves as a best-effort fallback ONLY when
Redis is unavailable (so the API stays up during a transient Redis
outage). The fallback is encapsulated in a class so the rule
``r_no_module_state`` (B0.12) sees no module-level mutable dict.

Closes R6-O1-F10 (multi-worker penalty drift): under multi-worker
deployments, Redis is now the source of truth — escalations persist
across workers as long as Redis is reachable. Cite also F14/F15.

Middleware raises 429 with Retry-After when the client is in a
penalty window or when a downstream handler returns 429 (escalation).
"""

from __future__ import annotations

import logging
import time
from typing import Any

from fastapi import FastAPI
from starlette.middleware.base import BaseHTTPMiddleware, RequestResponseEndpoint
from starlette.requests import Request
from starlette.responses import JSONResponse, Response

from app.core.adaptive_throttle import (
    AdaptiveThrottleConfig,
    build_config,
    fingerprint_request,
    penalty_seconds_for_tier,
)

logger = logging.getLogger(__name__)

_REDIS_KEY_PREFIX = "athrottle:penalty:"


class _PenaltyStore:
    """Redis-first penalty store with a per-worker dict fallback.

    The class encapsulates the fallback dict so the static rule
    ``r_no_module_state`` (CONTRACT §B0.12) does not flag this template
    as module-level mutable state — the only top-level binding here is
    a class instance, which the rule explicitly allows (see its
    "Class-instance singletons not flagged" trade-off).

    Fallback semantics: per-worker, best-effort. When Redis is up,
    every worker reads/writes the same key; escalations are durable
    across workers and across process restarts (until TTL).
    """

    def __init__(self) -> None:
        self._fallback: dict[str, tuple[int, float]] = {}

    async def _redis_or_none(self) -> Any:
        """Return a connected Redis client, or None if unreachable."""
        try:
            from app.core.redis import get_redis_or_none  # type: ignore[import]
            return await get_redis_or_none()
        except Exception:
            return None

    async def get(self, fp: str) -> int:
        """Return current penalty tier for *fp* (0 = no penalty)."""
        redis = await self._redis_or_none()
        if redis is not None:
            try:
                raw = await redis.get(_REDIS_KEY_PREFIX + fp)
                if raw is None:
                    return 0
                return int(raw)
            except Exception:
                pass  # fall through to local
        entry = self._fallback.get(fp)
        if entry is None:
            return 0
        tier, expiry = entry
        if time.monotonic() > expiry:
            self._fallback.pop(fp, None)
            return 0
        return tier

    async def set(self, fp: str, tier: int, ttl: int) -> None:
        """Persist (*fp*, *tier*) for *ttl* seconds."""
        redis = await self._redis_or_none()
        if redis is not None:
            try:
                await redis.setex(_REDIS_KEY_PREFIX + fp, ttl, tier)
                return
            except Exception:
                pass  # fall through to local
        self._fallback[fp] = (tier, time.monotonic() + ttl)


_PENALTY_STORE = _PenaltyStore()


async def _get_tier(fp: str) -> int:
    """Return the current penalty tier for a fingerprint.

    Args:
        fp: Behavioral fingerprint hex string.

    Returns:
        Current penalty tier (0 = no penalty).
    """
    return await _PENALTY_STORE.get(fp)


async def _escalate_tier(fp: str) -> int:
    """Increment penalty tier for *fp* and return new tier.

    Args:
        fp: Behavioral fingerprint hex string.

    Returns:
        New tier after escalation (capped at 4).
    """
    current = await _PENALTY_STORE.get(fp)
    new_tier = min(current + 1, 4)
    wait = penalty_seconds_for_tier(new_tier)
    await _PENALTY_STORE.set(fp, new_tier, wait)
    return new_tier


class AdaptiveThrottleMiddleware(BaseHTTPMiddleware):
    """ASGI middleware enforcing adaptive throttle rules.

    Applies fingerprint-based penalty checks and cascading cooldowns.
    Skips throttle checks when ADAPTIVE_THROTTLE_ENABLED is False.
    """

    async def dispatch(
        self, request: Request, call_next: RequestResponseEndpoint
    ) -> Response:
        """Process request through adaptive throttle gate.

        Args:
            request: Incoming ASGI request.
            call_next: Next handler in the middleware chain.

        Returns:
            Response from downstream or 429 if throttled.
        """
        cfg: AdaptiveThrottleConfig = build_config()
        if not cfg.enabled:
            return await call_next(request)

        fp = fingerprint_request(request)
        tier = await _get_tier(fp)

        if tier > 0:
            wait = penalty_seconds_for_tier(tier)
            logger.warning(
                "adaptive_throttle.blocked",
                extra={"fp": fp, "tier": tier, "retry_after": wait},
            )
            return JSONResponse(
                status_code=429,
                content={
                    "detail": "Too many requests — adaptive throttle active",
                    "penalty_tier": tier,
                    "retry_after_seconds": wait,
                },
                headers={"Retry-After": str(wait)},
            )

        response = await call_next(request)

        # Escalate on repeated 429 responses from downstream (e.g. from SlowAPI)
        if response.status_code == 429:
            new_tier = await _escalate_tier(fp)
            logger.info(
                "adaptive_throttle.escalated",
                extra={"fp": fp, "new_tier": new_tier},
            )

        return response


def register_adaptive_throttle(app: FastAPI) -> None:
    """Attach AdaptiveThrottleMiddleware to *app*.

    Args:
        app: The FastAPI application instance.
    """
    app.add_middleware(AdaptiveThrottleMiddleware)
    logger.info("adaptive_throttle.registered")
