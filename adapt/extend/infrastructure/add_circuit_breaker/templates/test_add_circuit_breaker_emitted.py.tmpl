"""Circuit-breaker emitted tests — generated by the add_circuit_breaker tool.

Positive: glue file wires the adapter (install function present).
Negative: second run returns no_op (idempotency guard works).
"""

from __future__ import annotations

import importlib
from pathlib import Path


def test_glue_file_exists() -> None:
    """Positive: app/circuit_breaker.py was written by the tool."""
    glue = Path(__file__).parent.parent / "app" / "circuit_breaker.py"
    assert glue.exists(), f"app/circuit_breaker.py not found at {glue}"


def test_glue_imports_adapter() -> None:
    """Positive: glue imports the CircuitBreakerAdapter install function."""
    glue = Path(__file__).parent.parent / "app" / "circuit_breaker.py"
    body = glue.read_text()
    assert "CircuitBreakerAdapter" in body, "adapter import missing from glue"
    assert "install_circuit_breakers" in body, "install_circuit_breakers function missing"


def test_primitive_present() -> None:
    """Positive: CircuitBreaker primitive was copied into project."""
    primitive = (
        Path(__file__).parent.parent
        / "core" / "venous" / "resiliency" / "CircuitBreaker" / "CircuitBreaker.py"
    )
    assert primitive.exists(), f"CircuitBreaker primitive not found at {primitive}"


def test_glue_body_under_20_loc() -> None:
    """Negative: glue stays at or below the 20 logic-line contract ceiling."""
    import ast

    glue = Path(__file__).parent.parent / "app" / "circuit_breaker.py"
    tree = ast.parse(glue.read_text())
    body_lines = 0
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            start = node.body[0].lineno
            end = node.end_lineno or start
            body_lines += end - start + 1
    assert body_lines <= 20, f"glue has {body_lines} logic lines (max 20)"
