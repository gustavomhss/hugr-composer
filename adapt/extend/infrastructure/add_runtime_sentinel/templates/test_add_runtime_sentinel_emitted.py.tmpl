"""Runtime sentinel emitted tests — generated by add_runtime_sentinel.

Positive: InjectionDetector detects SQL tautology + UNION SELECT, and the
SSRF check blocks the AWS metadata IP.
Negative: a benign string is NOT flagged as SQL injection.
"""

from __future__ import annotations

import importlib
import sys
from pathlib import Path


_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_injection_detector_flags_sql_tautology() -> None:
    """Positive: InjectionDetector.check_sql returns True for OR 1=1 tautology."""
    _ensure_on_path()
    mod = importlib.import_module("app.middleware.runtime_sentinel")
    detector = mod.InjectionDetector()
    assert detector.check_sql("1 OR 1=1"), "tautology should be detected"


def test_injection_detector_flags_union_select() -> None:
    """Positive: InjectionDetector.check_sql returns True for UNION SELECT attack."""
    _ensure_on_path()
    mod = importlib.import_module("app.middleware.runtime_sentinel")
    detector = mod.InjectionDetector()
    assert detector.check_sql("1 UNION SELECT password FROM users"), (
        "UNION SELECT should be detected"
    )


def test_injection_detector_ignores_benign_text() -> None:
    """Negative: a normal sentence is NOT flagged as SQL injection."""
    _ensure_on_path()
    mod = importlib.import_module("app.middleware.runtime_sentinel")
    detector = mod.InjectionDetector()
    assert not detector.check_sql("hello world"), "benign text false-positive"


def test_ssrf_blocks_metadata_ip() -> None:
    """Positive: InjectionDetector.check_ssrf returns True for cloud metadata IP."""
    _ensure_on_path()
    mod = importlib.import_module("app.middleware.runtime_sentinel")
    detector = mod.InjectionDetector()
    assert detector.check_ssrf("http://169.254.169.254/latest/meta-data/", frozenset()), (
        "metadata IP should be blocked"
    )


def test_registry_records_security_event() -> None:
    """Positive: AttackPatternRegistry.record increments per-type counts."""
    _ensure_on_path()
    reg_mod = importlib.import_module("app.core.sentinel_registry")
    registry = reg_mod.AttackPatternRegistry()
    event = reg_mod.SecurityEvent(
        attack_type="sql_injection",
        request_path="/x",
        payload_snippet="1 OR 1=1",
    )
    registry.record(event)
    assert registry.count("sql_injection") == 1
