def test_armor_core_exists() -> None:
    """Positive: app/core/response_armor.py was written by the tool."""
    core = Path(__file__).parent.parent / "app" / "core" / "response_armor.py"
    assert core.exists(), f"app/core/response_armor.py not found at {core}"


