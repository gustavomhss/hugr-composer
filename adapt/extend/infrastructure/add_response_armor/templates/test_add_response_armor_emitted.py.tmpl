def test_strip_crlf_removes_injection_chars() -> None:
    """Negative: strip_crlf removes CR and LF from header values."""
    import importlib.util
    import sys

    core_path = Path(__file__).parent.parent / "app" / "core" / "response_armor.py"
    spec = importlib.util.spec_from_file_location("response_armor_core", core_path)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    result = mod.strip_crlf("value\r\ninjected: evil")
    assert "\r" not in result, "CR not stripped"
    assert "\n" not in result, "LF not stripped"
    assert "value" in result, "legitimate value content removed"
