"""Emitted test for add_s3_storage — verifies S3 storage layer is wired.

Uses mocked boto3 clients — no real AWS connection required.

Security note:
    Server-side encryption (SSE) is NOT enforced by this tool; it only sets a
    content-type hint in presigned PUT URLs. Configure bucket-level SSE policies
    in your AWS console or IaC separately.
"""

from __future__ import annotations

from unittest.mock import MagicMock, patch

import pytest


def test_storage_package_importable() -> None:
    """Positive: app/storage package is importable after tool application."""
    import app.storage  # noqa: F401


def test_s3_client_importable() -> None:
    """Positive: S3Client class is importable from app.storage."""
    from app.storage.client import S3Client  # noqa: F401


def test_generate_key_no_path_traversal() -> None:
    """Positive: generate_key sanitises filenames with '..' path segments."""
    with patch("app.storage.client.settings") as mock_settings:
        mock_settings.S3_KEY_PREFIX = "uploads"
        mock_settings.S3_REGION = "us-east-1"
        mock_settings.S3_ACCESS_KEY_ID = ""
        mock_settings.S3_SECRET_ACCESS_KEY = ""
        mock_settings.S3_ENDPOINT_URL = ""
        with patch("boto3.client", return_value=MagicMock()):
            from app.storage.client import S3Client
            client = S3Client()
            key = client.generate_key("../../etc/passwd")
            assert ".." not in key, "generate_key must sanitise path traversal"
            assert "uploads/" in key, "key must start with prefix"


def test_presigned_upload_url_called() -> None:
    """Positive: presigned_upload_url returns a URL string."""
    with patch("app.storage.client.settings") as mock_settings:
        mock_settings.S3_KEY_PREFIX = "uploads"
        mock_settings.S3_REGION = "us-east-1"
        mock_settings.S3_ACCESS_KEY_ID = ""
        mock_settings.S3_SECRET_ACCESS_KEY = ""
        mock_settings.S3_ENDPOINT_URL = ""
        mock_settings.S3_BUCKET_NAME = "test-bucket"
        mock_settings.S3_PRESIGNED_URL_EXPIRATION = 3600
        mock_boto_client = MagicMock()
        mock_boto_client.generate_presigned_url.return_value = "https://s3.example.com/test"
        with patch("boto3.client", return_value=mock_boto_client):
            from app.storage.client import S3Client
            client = S3Client()
            url = client.presigned_upload_url("uploads/uuid/file.png", "image/png")
            assert url.startswith("https://"), "presigned URL must be an https URL"


def test_disallowed_content_type_raises_415() -> None:
    """Negative: uploading a disallowed content type raises HTTP 415."""
    from fastapi.testclient import TestClient
    from fastapi import FastAPI
    from app.api.routes.storage import router, _validate_content_type
    from fastapi import HTTPException

    with patch("app.api.routes.storage.settings") as mock_settings:
        mock_settings.S3_ALLOWED_CONTENT_TYPES = ["image/png"]
        with pytest.raises(HTTPException) as exc_info:
            _validate_content_type("application/exe")
        assert exc_info.value.status_code == 415


def test_routes_require_auth_dependency() -> None:
    """Negative: every storage route signature carries CurrentUser.

    Static guard against regressions of R6-S6-F1/F5/F6 — if anyone removes
    the auth dependency from POST /storage/upload, GET /storage/{key},
    or DELETE /storage/{key}, this test fails immediately without needing
    a live auth scaffold.
    """
    import inspect

    from app.api.routes.storage import (
        create_download_url,
        create_upload_url,
        delete_object,
    )

    for handler in (create_upload_url, create_download_url, delete_object):
        params = inspect.signature(handler).parameters
        assert "current_user" in params, (
            f"{handler.__name__} is missing the current_user auth dependency — "
            "R6-S6-F1/F5/F6 regression: unauthenticated bucket CRUD."
        )


def test_ownership_check_rejects_other_users_key() -> None:
    """Negative: a key outside users/{current_user.id}/ raises HTTP 403.

    Closes R6-S6-F5/F6: even authenticated callers can only address keys
    inside their own ``users/<id>/`` prefix.
    """
    from fastapi import HTTPException

    from app.api.routes.storage import _require_key_owned_by

    class _U:
        id = "alice"

    # Same-user key passes.
    _require_key_owned_by("users/alice/photo.png", _U())

    # Cross-user key is rejected with 403.
    with pytest.raises(HTTPException) as exc_info:
        _require_key_owned_by("users/bob/photo.png", _U())
    assert exc_info.value.status_code == 403

    # Top-level key (no users/ prefix) is rejected with 403.
    with pytest.raises(HTTPException) as exc_info:
        _require_key_owned_by("uploads/anything.png", _U())
    assert exc_info.value.status_code == 403
