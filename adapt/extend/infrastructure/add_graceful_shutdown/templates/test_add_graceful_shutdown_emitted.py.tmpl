"""Graceful-shutdown emitted tests — generated by the add_graceful_shutdown tool.

Positive: shutdown glue wires the adapter install function.
Negative: glue stays within the 20 logic-line contract ceiling.
"""

from __future__ import annotations

from pathlib import Path


def test_glue_file_exists() -> None:
    """Positive: app/shutdown.py was written by the tool."""
    glue = Path(__file__).parent.parent / "app" / "shutdown.py"
    assert glue.exists(), f"app/shutdown.py not found at {glue}"


def test_glue_imports_adapter() -> None:
    """Positive: glue imports GracefulShutdownAdapter install function."""
    glue = Path(__file__).parent.parent / "app" / "shutdown.py"
    body = glue.read_text()
    assert "GracefulShutdownAdapter" in body, "adapter import missing from glue"
    assert "install_graceful_shutdown" in body, "install_graceful_shutdown function missing"


def test_primitive_present() -> None:
    """Positive: GracefulShutdown primitive was copied into project."""
    primitive = (
        Path(__file__).parent.parent
        / "core" / "venous" / "resiliency" / "GracefulShutdown" / "GracefulShutdown.py"
    )
    assert primitive.exists(), f"GracefulShutdown primitive not found at {primitive}"


def test_glue_body_under_20_loc() -> None:
    """Negative: glue stays at or below the 20 logic-line contract ceiling."""
    import ast

    glue = Path(__file__).parent.parent / "app" / "shutdown.py"
    tree = ast.parse(glue.read_text())
    body_lines = 0
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            start = node.body[0].lineno
            end = node.end_lineno or start
            body_lines += end - start + 1
    assert body_lines <= 20, f"glue has {body_lines} logic lines (max 20)"
