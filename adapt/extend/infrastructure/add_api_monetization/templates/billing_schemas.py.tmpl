"""Pydantic schemas for API billing/metering endpoints.

Money fields use **integer cents** (``int``), not ``float`` — Pydantic's
default float behaviour silently loses precision around 1e-2 (one US
cent) and round-tripping breaks Stripe's required exact-amount
semantics (R6-O3-P14). The Stripe ``amount_cents`` pattern used
elsewhere in this codebase is mirrored here for consistency.

Write schemas (``*Request`` / ``*In`` / ``*Create`` / etc.) declare
``model_config = ConfigDict(extra="forbid")`` to block mass-assignment
and key-smuggling (B0.14 / R6-S8-F2). Read schemas keep the
``from_attributes=True`` ORM-mode pattern and are exempt.
"""

from __future__ import annotations

from datetime import datetime

from pydantic import BaseModel, ConfigDict, Field


class UsageSummary(BaseModel):
    """Current usage summary for a tenant."""

    model_config = ConfigDict(from_attributes=True)

    tenant_id: str
    tier: str
    current_usage: int
    monthly_limit: int
    remaining: int
    reset_date: str


class UsageHistoryItem(BaseModel):
    """A single historical usage data point."""

    model_config = ConfigDict(from_attributes=True)

    endpoint: str
    method: str
    status_code: int
    duration_ms: int
    created_at: datetime


class TopConsumer(BaseModel):
    """One entry in the admin analytics top-consumers list."""

    model_config = ConfigDict(from_attributes=True)

    tenant_id: str
    calls: int


class PlanInfo(BaseModel):
    """Information about an available billing plan.

    ``price_monthly_cents`` is an integer count of US cents (e.g. 2900
    for USD 29.00) — see module docstring on why money is never ``float``.
    """

    model_config = ConfigDict(from_attributes=True)

    plan_id: str
    name: str
    monthly_limit: int
    price_monthly_cents: int = Field(
        ..., ge=0, description="Monthly price in US cents (integer, no float)."
    )
    stripe_price_id: str


class UpgradeRequest(BaseModel):
    """Request body for self-serve plan upgrade.

    ``extra="forbid"`` blocks the mass-assignment / key-smuggling class
    of finding (B0.14 / R6-S8-F2): a client cannot smuggle extra
    fields into the request envelope.
    """

    model_config = ConfigDict(extra="forbid")

    plan_id: str = Field(..., description="Target plan identifier")
    stripe_payment_method_id: str = Field(
        ..., description="Stripe PaymentMethod ID for billing"
    )


class UpgradeResponse(BaseModel):
    """Response after a successful plan upgrade."""

    model_config = ConfigDict(from_attributes=True)

    tenant_id: str
    new_plan: str
    effective_date: str
    next_billing_date: str


class RevenueAnalytics(BaseModel):
    """Admin-only revenue analytics snapshot.

    ``mrr_cents`` is an integer count of US cents — see module
    docstring on why money is never ``float``.
    """

    model_config = ConfigDict(from_attributes=True)

    mrr_cents: int = Field(
        ..., ge=0, description="Monthly recurring revenue in US cents (integer)."
    )
    total_active_tenants: int
    total_api_calls_this_month: int
    top_consumers: list[TopConsumer]
    churn_risk_tenants: list[str]
