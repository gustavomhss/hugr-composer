"""Deep-health emitted tests — generated by add_health_deep.

Positive: HealthRegistry/models import without crash, liveness always
returns HEALTHY, /health/live + /health/ready + /health/deep are
registered with the API router.
Negative: psutil is NOT imported at module top-level of disk.py / memory.py
(lazy import contract — disk/memory checks must remain importable on systems
without psutil installed).
"""

from __future__ import annotations

import ast
import asyncio
import importlib
import sys
from pathlib import Path


_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_registry_module_exposes_health_registry() -> None:
    """Positive: app.health.registry exposes HealthRegistry + get_registry."""
    _ensure_on_path()
    mod = importlib.import_module("app.health.registry")
    assert hasattr(mod, "HealthRegistry")
    assert hasattr(mod, "get_registry")


def test_liveness_always_healthy() -> None:
    """Positive: HealthRegistry.run_liveness returns HEALTHY with no checks."""
    _ensure_on_path()
    registry_mod = importlib.import_module("app.health.registry")
    models_mod = importlib.import_module("app.health.models")
    registry = registry_mod.HealthRegistry()
    report = asyncio.run(registry.run_liveness())
    assert report.status == models_mod.HealthStatus.HEALTHY, (
        f"liveness must be HEALTHY, got {report.status!r}"
    )
    assert report.checks == [], f"liveness must have no checks, got {report.checks!r}"


def test_health_deep_routes_registered() -> None:
    """Positive: /health/live, /health/ready, /health/deep all registered."""
    _ensure_on_path()
    mod = importlib.import_module("app.api.routes.health_deep")
    router = getattr(mod, "router", None)
    assert router is not None
    paths = {getattr(r, "path", None) for r in router.routes}
    expected = {"/health/live", "/health/ready", "/health/deep"}
    missing = expected - paths
    assert not missing, f"missing routes: {missing} (have {paths})"


def test_psutil_lazy_in_disk_check() -> None:
    """Negative: psutil must NOT appear at top-level of disk.py."""
    disk = _PROJECT_ROOT / "app" / "health" / "checks" / "disk.py"
    assert disk.exists()
    tree = ast.parse(disk.read_text())
    for node in tree.body:
        if isinstance(node, ast.Import):
            for alias in node.names:
                assert "psutil" not in alias.name, (
                    "psutil imported at top-level of disk.py"
                )
        elif isinstance(node, ast.ImportFrom):
            assert (node.module or "") != "psutil", (
                "from psutil at top-level of disk.py"
            )


