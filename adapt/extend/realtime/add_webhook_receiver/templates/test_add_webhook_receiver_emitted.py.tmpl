"""Webhook receiver emitted tests — generated by add_webhook_receiver.

Positive: primitives + adapter are present in project; glue module imports
cleanly; install_webhook_receiver symbol exists.
Negative: glue logic lines are within the 20-line budget.
"""
from __future__ import annotations

import ast
import importlib
import sys
from pathlib import Path

_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_signature_verifier_primitive_present() -> None:
    """Positive: SignatureVerifier.py is present under core/venous/security/."""
    candidates = list(
        (_PROJECT_ROOT / "core" / "venous").rglob("SignatureVerifier.py")
    )
    assert candidates, "SignatureVerifier.py not found under core/venous/"


def test_idempotent_consumer_primitive_present() -> None:
    """Positive: IdempotentConsumer.py is present under core/venous/."""
    candidates = list(
        (_PROJECT_ROOT / "core" / "venous").rglob("IdempotentConsumer.py")
    )
    assert candidates, "IdempotentConsumer.py not found under core/venous/"


def test_audit_event_primitive_present() -> None:
    """Positive: AuditEvent.py is present under core/venous/."""
    candidates = list(
        (_PROJECT_ROOT / "core" / "venous").rglob("AuditEvent.py")
    )
    assert candidates, "AuditEvent.py not found under core/venous/"


def test_adapter_present() -> None:
    """Positive: WebhookReceiverAdapter.py is present under core/venous/_adapters/."""
    adapter = (
        _PROJECT_ROOT
        / "core"
        / "venous"
        / "_adapters"
        / "fastapi"
        / "WebhookReceiverAdapter.py"
    )
    assert adapter.exists(), f"WebhookReceiverAdapter.py not found at {adapter}"
    assert "def install(" in adapter.read_text(), "install() not found in adapter"


def test_glue_module_exists() -> None:
    """Positive: app/webhook_receiver.py exists with install_webhook_receiver."""
    glue = _PROJECT_ROOT / "app" / "webhook_receiver.py"
    assert glue.exists(), "app/webhook_receiver.py not found"
    content = glue.read_text()
    assert "install_webhook_receiver" in content
    assert "WebhookReceiverAdapter" in content


def test_glue_logic_within_budget() -> None:
    """Negative: glue body must not exceed 20 logic lines."""
    glue = _PROJECT_ROOT / "app" / "webhook_receiver.py"
    assert glue.exists()
    tree = ast.parse(glue.read_text())
    body_lines = 0
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            start = node.body[0].lineno
            end = node.end_lineno or start
            body_lines += end - start + 1
    assert body_lines <= 20, f"glue body has {body_lines} logic lines; budget is 20"
