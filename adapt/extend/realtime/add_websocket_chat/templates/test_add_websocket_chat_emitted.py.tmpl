def test_no_inprocess_broadcast() -> None:
    """Fan-out always goes through Redis publish, not in-process sets."""
    manager_path = PROJECT_ROOT / "app" / "ws" / "connection_manager.py"
    src = manager_path.read_text()
    # Must use redis.publish for fan-out
    assert "publish" in src, (
        "connection_manager.py must use Redis publish for fan-out"
    )
    # Must NOT broadcast by iterating a plain in-memory set without Redis
    # (the subscribe loop pattern is fine; direct set iteration for broadcast is not)
    tree = ast.parse(src)
    broadcast_funcs = [
        n for n in ast.walk(tree)
        if isinstance(n, ast.AsyncFunctionDef) and n.name == "broadcast"
    ]
    assert broadcast_funcs, "broadcast method must exist on WebSocketManager"
