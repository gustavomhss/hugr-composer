"""SSE emitted tests — generated by add_sse.

Positive: SSE modules are importable; SSEManager + publish_event symbols exist;
formatter encodes event correctly.
Negative: publish_event raises ValueError on oversized payload.
"""
from __future__ import annotations

import ast
import importlib
import sys
from pathlib import Path

_PROJECT_ROOT = Path(__file__).parent.parent


def _ensure_on_path() -> None:
    root = str(_PROJECT_ROOT)
    if root not in sys.path:
        sys.path.insert(0, root)


def test_formatter_encodes_sse_event() -> None:
    """Positive: format_event returns valid UTF-8 SSE wire bytes with id/event/data lines."""
    _ensure_on_path()
    mod = importlib.import_module("app.core.sse.formatter")
    SSEEvent = mod.SSEEvent
    format_event = mod.format_event
    evt = SSEEvent(event_id="123-abc", event_name="test.event", payload={"k": "v"})
    result = format_event(evt)
    assert isinstance(result, bytes)
    text = result.decode("utf-8")
    assert "id: 123-abc" in text
    assert "event: test.event" in text
    assert "data:" in text


def test_format_event_rejects_empty_event_id() -> None:
    """Negative: format_event raises ValueError on empty event_id."""
    _ensure_on_path()
    mod = importlib.import_module("app.core.sse.formatter")
    SSEEvent = mod.SSEEvent
    format_event = mod.format_event
    import pytest
    evt = SSEEvent(event_id="", event_name="ev", payload={})
    with pytest.raises(ValueError, match="event_id"):
        format_event(evt)


def test_sse_manager_module_exposes_get_sse_manager() -> None:
    """Positive: app.core.sse.manager exposes SSEManager + get_sse_manager."""
    _ensure_on_path()
    mod = importlib.import_module("app.core.sse.manager")
    assert hasattr(mod, "SSEManager"), "SSEManager missing"
    assert hasattr(mod, "get_sse_manager"), "get_sse_manager missing"


