def test_publisher_lazy_redis_import() -> None:
    """Negative: redis must NOT be imported at module top-level in publisher.py."""
    publisher = _PROJECT_ROOT / "app" / "core" / "sse" / "publisher.py"
    assert publisher.exists()
    tree = ast.parse(publisher.read_text())
    for node in tree.body:
        if isinstance(node, ast.Import):
            for alias in node.names:
                assert "redis" not in alias.name, (
                    "redis imported at top-level of publisher.py"
                )
        elif isinstance(node, ast.ImportFrom):
            assert (node.module or "") != "redis", (
                "from redis at top-level of publisher.py"
            )
