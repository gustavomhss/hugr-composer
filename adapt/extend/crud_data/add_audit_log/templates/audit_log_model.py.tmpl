"""Append-only audit-log ORM model (INV-AL-01/02/08).

Rows in ``audit_logs`` are written EXCLUSIVELY by the ``before_flush`` listener
in ``app.core.audit_listeners`` — never constructed directly by application
code.  Each row carries the hash of the previous row (``prev_hash``) and its
own ``entry_hash`` over the canonical payload, forming a tamper-evident chain
(verified by ``app.core.audit_verifier.verify_hash_chain``).

A PostgreSQL trigger (``trg_audit_log_immutable``, installed by the migration)
rejects UPDATE/DELETE on this table so the chain cannot be silently rewritten;
the retention purge in ``app.crud.audit_log`` is the only sanctioned deletion
path and runs as a privileged maintenance job.
"""

from __future__ import annotations

import datetime
import uuid

from sqlalchemy import DateTime, Integer, String, Uuid
from sqlalchemy.orm import Mapped, mapped_column

from app.models.base import Base


class AuditLog(Base):
    """A single immutable, hash-chained audit entry."""

    __tablename__ = "audit_logs"

    id: Mapped[uuid.UUID] = mapped_column(Uuid, primary_key=True, default=uuid.uuid4)
    # Monotonic sequence number; the chain orders by this column.
    seq: Mapped[int] = mapped_column(Integer, autoincrement=True, nullable=False, unique=True)
    # Actor; nullable so context-less writes are recorded (INV-AL-04).
    user_id: Mapped[uuid.UUID | None] = mapped_column(Uuid, nullable=True)
    action: Mapped[str] = mapped_column(String(64), nullable=False)
    resource: Mapped[str] = mapped_column(String(255), nullable=False)
    payload: Mapped[str] = mapped_column(String, nullable=False, default="")
    # Hash chain (INV-AL-08): entry_hash always folds in prev_hash.
    prev_hash: Mapped[str] = mapped_column(String(64), nullable=False, default="")
    entry_hash: Mapped[str] = mapped_column(String(64), nullable=False)
    created_at: Mapped[datetime.datetime] = mapped_column(
        DateTime(timezone=True),
        default=lambda: datetime.datetime.now(datetime.UTC),
        nullable=False,
    )
