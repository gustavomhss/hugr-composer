
# ---------------------------------------------------------------------------
# SOFT_DELETE_PATCH_APPLIED — added by add_soft_delete tool.
# ---------------------------------------------------------------------------
# Read exclusion of soft-deleted rows is handled GLOBALLY by the
# do_orm_execute listener in app/core/soft_delete_filter.py (INV-SD-01), so
# CRUDBase.get / get_multi need no per-query is_deleted clause. We only
# override delete() so the default DELETE route flips is_deleted=True instead
# of issuing a SQL DELETE (INV-SD-03). Models without is_deleted (auth/infra)
# fall through to the original hard-delete behaviour.
from datetime import datetime as _sd_datetime, timezone as _sd_timezone


async def _sd_delete(self, session, id):
    """Soft-delete-aware ``delete``.

    For models with ``is_deleted``: flips ``is_deleted=True`` (and
    ``deleted_at`` if present) instead of issuing a SQL DELETE.
    For models without it: falls back to the original hard-delete.
    """
    obj = await self.get(session, id)
    if obj is None:
        return None
    if hasattr(obj, "is_deleted"):
        obj.is_deleted = True
        if hasattr(obj, "deleted_at"):
            obj.deleted_at = _sd_datetime.now(_sd_timezone.utc)
        await session.flush()
        return obj
    await session.delete(obj)
    await session.flush()
    return obj


CRUDBase.delete = _sd_delete
