@router.post("/{id}/restore", response_model=${MODEL}Public)
async def restore_${STEM}(
    session: SessionDep,
    id: uuid.UUID,
    current_user: CurrentUser,
) -> ${MODEL}Public:
    """Restore a soft-deleted $MODEL by clearing is_deleted / deleted_at.

    Raises:
        HTTPException 404: row not found or not currently soft-deleted.
        HTTPException 403: caller does not own this record.
    """
