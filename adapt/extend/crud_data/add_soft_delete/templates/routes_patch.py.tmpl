

# ---------------------------------------------------------------------------
# SOFT_DELETE_ROUTES_APPLIED — added by add_soft_delete tool.
# ---------------------------------------------------------------------------
# Soft-delete management endpoints for $MODEL. Reads go through the crud
# helpers, which opt into include_deleted=True to reach the soft-deleted set
# that the global do_orm_execute filter otherwise hides.
#   GET    /deleted/        — list soft-deleted rows (superuser only).
#   POST   /{id}/restore    — clear all three deletion columns (superuser).
#   DELETE /{id}/permanent  — hard-delete a row for good (superuser).
from app.crud.$STEM import hard_delete as _sd_hard_delete, list_deleted as _sd_list_deleted, restore as _sd_restore
from app.schemas.$STEM import ${MODEL}DeletedPublic, ${MODEL}sDeletedPublic


@router.get("/deleted/", response_model=${MODEL}sDeletedPublic)
async def list_deleted_${STEM}(
    session: SessionDep,
    current_user: CurrentSuperuser,
    skip: int = Query(default=0, ge=0),
    limit: int = Query(default=100, ge=1, le=1000),
) -> ${MODEL}sDeletedPublic:
    """List soft-deleted $MODEL rows. Superuser only."""
    return ${MODEL}sDeletedPublic(
        **await _sd_list_deleted(session, skip=skip, limit=limit)
    )


@router.post("/{id}/restore", response_model=${MODEL}Public)
async def restore_${STEM}(
    session: SessionDep,
    id: uuid.UUID,
    current_user: CurrentSuperuser,
) -> ${MODEL}Public:
    """Restore a soft-deleted $MODEL (clears all three deletion columns).

    Raises:
        HTTPException 404: row not found or not currently soft-deleted.
    """
    obj = await _sd_restore(session, id)
    if obj is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="$MODEL not found in deleted records",
        )
    return obj


@router.delete("/{id}/permanent", response_model=Message)
async def permanent_delete_${STEM}(
    session: SessionDep,
    id: uuid.UUID,
    current_user: CurrentSuperuser,
) -> Message:
    """Hard-delete a $MODEL row, bypassing soft-delete (irreversible).

    Raises:
        HTTPException 404: row not found.
    """
    obj = await _sd_hard_delete(session, id)
    if obj is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="$MODEL not found",
        )
    return Message(message="$MODEL permanently deleted")
